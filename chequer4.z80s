;------------------------------------------------------------------
; chequer4.z80s - the Space Harrier floor with its stripes in the pixels
;
;   chq4_init    fill both buffers and the haze, once
;   chq4_frame   draw from (chq4_camx, chq4_camz) and flip
;
; chequer3.z80s draws this board out of compiled runs at 110,806
; T-states and leaves the alternation into the distance to the palette:
; the whole floor is two colour indices, and a copper swaps what those
; two mean on every scanline where the depth crosses a square. That is
; cheap in pixels and expensive everywhere else on a SAM. The swap moves
; with camz, so it is a table the CPU rebuilds every frame; the palette
; is a port, so applying it is a line interrupt or a polling loop; and
; the fill cannot allow either, because it runs with interrupts off and
; the stack pointing at the screen.
;
; The alternation is a phase, though. Adding one whole square to the
; horizontal phase exchanges the two colours on that scanline, which is
; exactly what the palette swap did - so the board can carry its own
; stripes and the palette can sit still from frame to frame.
;
; The runs do not change to do it. THIS FILE SHARES CHEQUER3'S RUN BANK,
; byte for byte, entry tables and all: a run is a string of PUSHes, and
; what a PUSH pushes is a register. What changes is the six values the
; row loop POPs into those registers - every set has a complement
; sixteen bytes above it - and picking between them costs one AND and
; one ADD a scanline, off a mask byte that is 0x00 or 0x33.
;
; That byte does two jobs: bit 4 of it is the offset to the complement,
; and the whole of it turns the row's last byte round. It costs 65
; T-states a scanline over chequer3, and gives back the parity table and
; the copper.
;
; Written by Claude (Opus) for the Z80AIexperiments repo.
;------------------------------------------------------------------

; CHQ4_PAGED is the harness's: 0 for the flat 64K layout with both
; buffers mapped, 1 for the paged one below.

CHQ4_BUF0:      EQU 0x80
CHQ4_BUF1:      EQU 0x20
CHQ4_C1:        EQU 0x1111      ; the two colour indices, both nibbles
CHQ4_C2:        EQU 0x2222      ; CHQ4_SKYC, the sky's own, comes with the
                                ; viewport: it is the board's first colour
                                ; where a copper grades the two apart by
                                ; scanline, and an index of its own where
                                ; the palette has to sit still - see
                                ; chequer9

;------------------------------------------------------------------
; The paged layout, which is what chequer5 uses (see chequer5.md):
;
;   0000-7FFF  LMPR: the run bank with its bands, records and value
;              sets at the foot of it - or a chunk of the mask tables,
;              for as long as a frame takes to copy one out of it
;   8000-DFFF  HMPR: the back buffer. The displayed one needs no
;              mapping at all, which is what frees the low 32K
;   E000-FFFF  this code, in the 8K a MODE 4 screen leaves spare at
;              the end of its odd page, with a copy behind each buffer
;
; See .claude/skills/sam-coupe-hardware.
;------------------------------------------------------------------

CHQ4_LMPR:      EQU 250
CHQ4_HMPR:      EQU 251
CHQ4_VMPR:      EQU 252
CHQ4_SCR0:      EQU 10          ; the buffers, on even pages because a
CHQ4_SCR1:      EQU 12          ; MODE 4 screen wraps even to odd
CHQ4_MODE4:     EQU 0x60
CHQ4_BANK:      EQU 0x20        ; the bank's first chunk, RAM over ROM 0 -
                                ; the others are two pages apart, and the
                                ; band table says which comes next
CHQ4_MSK0:      EQU 0x26        ; and the mask tables, two chunks of them
CHQ4_SCREEN:    EQU 0x8000

;------------------------------------------------------------------
; chq4_init - sky, haze, and the rows the frame draws over
;------------------------------------------------------------------

chq4_init:
    IF CHQ4_PAGED
        LD   A,CHQ4_SCR1        ; each buffer in turn, and the one left
        OUT  (CHQ4_HMPR),A      ; mapped at the end is the one to draw
        CALL chq4_fill          ; into
        LD   A,CHQ4_SCR1 | CHQ4_MODE4
        OUT  (CHQ4_VMPR),A
        LD   A,CHQ4_SCR0
        OUT  (CHQ4_HMPR),A
        CALL chq4_fill
        LD   A,CHQ4_BANK
        OUT  (CHQ4_LMPR),A
        RET
    ELSE
        LD   A,CHQ4_BUF0
        LD   (chq4_back),A
        LD   A,CHQ4_BUF1
        LD   (chq4_front),A
        LD   H,CHQ4_BUF0
        CALL chq4_fill
        LD   H,CHQ4_BUF1
        ; fall through
    ENDIF

chq4_fill:
    IF CHQ4_PAGED
        LD   H,CHQ4_SCREEN / 256
    ENDIF
        LD   L,0
        PUSH HL
        LD   D,0x60
chq4_f1:
        LD   B,0
chq4_f2:
        LD   (HL),CHQ4_SKYC & 255
        INC  HL
        DJNZ chq4_f2
        DEC  D
        JR   NZ,chq4_f1
        POP  HL
    IF CHQ4_TOP > CHQ4_HZ + 1           ; then the haze, over the rows too
        LD   DE,(CHQ4_HZ + 1) * 128     ; far away to draw a board on - of
        ADD  HL,DE                      ; which there are none at all once
        LD   D,CHQ4_TOP - CHQ4_HZ - 1   ; the board reaches the horizon
chq4_f3:
        LD   B,128
chq4_f4:
        LD   (HL),CHQ4_HAZE
        INC  HL
        DJNZ chq4_f4
        DEC  D
        JR   NZ,chq4_f3
    ENDIF
        RET

;------------------------------------------------------------------
; chq4_frame - one frame
;------------------------------------------------------------------

chq4_frame:
        CALL chq4_msk8
        CALL chq4_floor
    IF CHQ4_PAGED
        IN   A,(CHQ4_HMPR)      ; which buffer is which is not written
        AND  31                 ; down anywhere: HMPR maps the one being
        LD   C,A                ; drawn and VMPR says which is shown
        OR   CHQ4_MODE4
        OUT  (CHQ4_VMPR),A      ; show what was just drawn
        LD   A,C
        XOR  CHQ4_SCR0 ^ CHQ4_SCR1
        OUT  (CHQ4_HMPR),A      ; and map the other, to draw into next
    ELSE
        LD   A,(chq4_back)
        LD   B,A
        LD   A,(chq4_front)
        LD   (chq4_back),A
        LD   A,B
        LD   (chq4_front),A
    ENDIF
        RET

;------------------------------------------------------------------
; chq4_msk8 - which way round each scanline's two colours go
;
; The depth at a scanline is ztab[y] + camz, and a square is 256 of
; those, so bit 8 of the sum is the parity of the row of squares this
; scanline is looking at. Where it is set the scanline wants its two
; colours exchanged, which is XOR 0x33 - and bit 4 of that same byte is
; where the complement of a value set lives.
;------------------------------------------------------------------

chq4_msk8:
    IF CHQ4_PAGED
        LD   A,(chq4_camz+1)    ; bit 8 of the depth picks the chunk, and
        LD   B,A                ; the camera's own square parity goes in
        LD   A,(chq4_camx+1)    ; with it, because adding 256 to the depth
        XOR  B                  ; is exactly what that parity does
        AND  1
        ADD  A,A                ; two pages a chunk
        ADD  A,CHQ4_MSK0
        OUT  (CHQ4_LMPR),A
        LD   A,(chq4_camz)      ; and the low byte picks the table: 128
        RRCA                    ; bytes each, so the index is a shift
        LD   H,A
        AND  0x80
        LD   L,A
        LD   A,H
        AND  0x7F
        LD   H,A
        LD   DE,chq4_msk
    IF CHQ4_DYNHZ               ; as many scanlines as this horizon has,
        LD   A,(chq4_rows)      ; taken out of the deep board's own mask a
        LD   B,A                ; step at a time - because a shallower
        LD   C,0x80             ; horizon draws the same board with
chq4_g1:                        ; scanlines left out, and the mask has to
        LD   A,(HL)             ; lose the same ones. Half a step in, so
        LD   (DE),A             ; that both ends of it are exact.
        INC  DE
        LD   A,C
chq4_gf:
        ADD  A,0                ; patched: the step's fraction, and
        LD   C,A
        LD   A,L
chq4_gi:
        ADC  A,0                ; patched: its whole part. A table is 128
        LD   L,A                ; bytes on a 128 byte boundary and the
        DJNZ chq4_g1            ; walk is 95 at most, so L cannot carry
    ELSE
        DUP  192 - CHQ4_TOP
        LDI                     ; 16 T-states a scanline against 81
        EDUP
    ENDIF
        LD   A,CHQ4_BANK        ; and the bank back, for the drawing
        OUT  (CHQ4_LMPR),A
        RET
    ELSE
        LD   A,(chq4_camz)
        LD   (chq4_z1+1),A
        LD   A,(chq4_camx+1)    ; the camera's own square is a parity
        AND  1                  ; too: crossing one exchanges the two
        LD   C,A                ; colours, which is what a square of
        LD   A,(chq4_camz+1)    ; depth does, so it goes in with it
        ADD  A,C
        LD   (chq4_z2+1),A
        LD   HL,chq4_ztab       ; which starts at the top row
        LD   DE,chq4_msk        ; which also starts at the top row
        LD   B,192 - CHQ4_TOP
chq4_m1:
        LD   A,(HL)
        INC  HL
chq4_z1:
        ADD  A,0
        LD   A,(HL)
        INC  HL
chq4_z2:
        ADC  A,0
        RRA                     ; the parity of the depth, into carry
        SBC  A,A                ; and out again as 0x00 or 0xFF
        AND  CHQ4_SWAP
        LD   (DE),A
        INC  DE
        DJNZ chq4_m1
        RET
    ENDIF

;------------------------------------------------------------------
; chq4_floor - the board, bottom row upwards, a band of rows a width
;
; The camera's offset scaled to a square is camx * p / 256, and the
; bands come widest first with p one smaller each time, so the whole
; of it is one subtraction of camx a band. What that offset says is
; which run to enter (the odd pixel of it), whether the stack pointer
; shifts (the next pixel), and where in the run to enter (the rest).
;------------------------------------------------------------------

chq4_floor:
        DI
        LD   (chq4_sp),SP
        LD   A,(chq4_camx)      ; the camera inside one square, times
        LD   L,A                ; the widest square and one more, so
        LD   H,0                ; that the first band's subtraction
        LD   (chq4_cx),HL       ; leaves it times the widest
    IF CHQ4_DYNHZ               ; which is a different square at every
        LD   DE,0               ; horizon, so it is a multiply rather
        LD   A,(chq4_wide)      ; than six shifts
chq4_m1:
        SRL  A
        JR   NC,chq4_m2
        EX   DE,HL
        ADD  HL,DE
        EX   DE,HL
chq4_m2:
        ADD  HL,HL
        OR   A
        JR   NZ,chq4_m1
        LD   (chq4_acc),DE
        LD   A,(chq4_bnk0)      ; and the chunk the bottom band is in
        OUT  (CHQ4_LMPR),A
        LD   HL,(chq4_bp0)      ; and where in its table that band is
    ELSE
        LD   B,H
        LD   C,A
        DUP  6
        ADD  HL,HL
        EDUP
        ADD  HL,BC
        LD   (chq4_acc),HL
        LD   HL,chq4_band
    ENDIF
        LD   (chq4_bp+1),HL
    IF CHQ4_PAGED
        EXX
        LD   HL,CHQ4_SCREEN + 0x6000 - 1        ; the last byte of the
    ELSE                                        ; last row, which is where
        LD   A,(chq4_back)                      ; a row's stack pointer
        ADD  A,0x60                             ; starts from and what the
        EXX                                     ; row loop stores into
        LD   H,A
        LD   L,0
        DEC  HL
    ENDIF
    IF CHQ4_DYNHZ
        LD   DE,(chq4_mskp)                     ; and the mask, which is
    ELSE                                        ; as long as the board
        LD   DE,chq4_msk + 191 - CHQ4_TOP       ; and the mask
    ENDIF
        EXX

chq4_b1:
    IF CHQ4_DYNHZ = 0
        LD   HL,(chq4_acc)      ; the phase for this band, in pixels:
        LD   BC,(chq4_cx)       ; one camx less than the band below
        OR   A
        SBC  HL,BC
        LD   (chq4_acc),HL
        LD   A,H
        EX   AF,AF'             ; parked; HL is wanted for the table
    ENDIF
chq4_bp:
        LD   HL,chq4_band       ; patched: this band's entry
        LD   A,(HL)             ; the rows it covers
        OR   A
        JP   Z,chq4_bend
        EXX
        LD   B,A                ; the count lives with the row pointer
        EXX
        INC  HL

    IF CHQ4_PAGED
    IF CHQ4_DYNHZ
        LD   A,(HL)             ; how many squares wider the band below
        INC  HL                 ; this one was: one on the deep board, and
        LD   E,(HL)             ; four or five where the horizon is low and
        INC  HL                 ; most of the board's scanlines are not
        LD   D,(HL)             ; drawn
        INC  HL
        LD   (chq4_bp+1),HL     ; and on to the next band
        LD   HL,(chq4_acc)      ; the phase for this band, in pixels: this
        LD   BC,(chq4_cx)       ; band's width times the camera inside one
chq4_d1:                        ; square
        OR   A                  ; which also clears the carry
        SBC  HL,BC
        DEC  A
        JR   NZ,chq4_d1
        LD   (chq4_acc),HL
        LD   A,H
    ELSE
        LD   E,(HL)             ; this band's table of compiled bodies
        INC  HL
        LD   D,(HL)
        INC  HL
        LD   (chq4_bp+1),HL     ; and on to the next band
        EX   AF,AF'             ; the phase
    ENDIF
        ADD  A,A                ; two bytes an entry
        ADD  A,E
        LD   E,A
        JR   NC,chq4_b2
        INC  D
chq4_b2:
        LD   A,(DE)             ; the body for this band and phase, which
        LD   (chq4_next+1),A    ; is the whole of what a band sets up now:
        INC  DE                 ; the row's last byte, the value set, the
        LD   A,(DE)             ; shift and the run are all baked into it
        LD   (chq4_next+2),A
        EXX                     ; the row loop turns round in the other
        LD   A,B                ; set. Rows is never zero, so the jump
        OR   A                  ; below is always taken the first time
        JP   chq4_next
    ELSE
        EX   AF,AF'
        SRL  A                  ; the odd pixel of phase picks the run
        JR   NC,chq4_b2
        INC  HL
        INC  HL
chq4_b2:
        LD   E,(HL)
        INC  HL
        LD   D,(HL)             ; DE = the record for this run
        INC  HL
        JR   C,chq4_b3
        INC  HL
        INC  HL
chq4_b3:
        LD   (chq4_bp+1),HL     ; and on to the next band

        SRL  A                  ; the next pixel of phase is a whole
        LD   C,A                ; byte, which the stack pointer shifts
        SBC  A,A                ; for the price of an INC SP
        CPL
        AND  0x33
        LD   (chq4_shift),A

        EX   DE,HL              ; HL = the record: entries, then values
        LD   E,(HL)
        INC  HL
        LD   D,(HL)             ; DE = where each PUSH of phase enters
        INC  HL
        LD   A,C                ; three bytes an entry
        ADD  A,A
        ADD  A,C
        ADD  A,E
        LD   E,A
        JR   NC,chq4_b4
        INC  D
chq4_b4:
        LD   A,(DE)             ; the run, entered where the phase says
        LD   (chq4_j+1),A
        INC  DE
        LD   A,(DE)
        LD   (chq4_j+2),A
        INC  DE
        LD   A,(DE)             ; and the row's last byte to go with it,
        LD   (chq4_ed+1),A      ; which the mask turns round
        LD   A,(HL)             ; where this run's values live, and
        LD   (chq4_bl+1),A      ; sixteen bytes on, their complement
        INC  HL
        LD   A,(HL)
        LD   (chq4_bh+1),A
        EXX                     ; the row loop turns round in the other
                                ; set: the row pointer, the mask pointer
                                ; and the count are all in it
    ENDIF

;------------------------------------------------------------------
; The row loop. Nothing between POP AF and the run may touch the
; flags - F is a colour - so the row's last byte goes in first, where
; the run overwrites it again if the run reaches that far.
;------------------------------------------------------------------

    IF CHQ4_PAGED = 0
chq4_row:
        LD   A,(DE)             ; this row's mask
chq4_ed:
        XOR  0                  ; patched: the row's last byte, unswapped
        LD   (HL),A
        LD   A,(DE)
        DEC  DE
        AND  0x10               ; the mask again, as the offset to the
chq4_bl:
        ADD  A,0                ; complement of this run's values
        EXX
        LD   L,A
chq4_bh:
        LD   H,0                ; patched: which values, and which way
        LD   SP,HL              ; round
        POP  BC
        POP  DE
        POP  HL
        POP  IX
        POP  IY
        POP  AF
        EXX
        LD   SP,HL              ; the runs fill rightwards to leftwards
chq4_shift:
        INC  SP                 ; patched: NOP, when the run is shifted
        EXX
chq4_j:
        JP   0                  ; patched: the run for this band
    ENDIF

chq4_ret:
chq3_ret:                       ; the names the run banks know: chequer3's
chq5_ret:                       ; bank, or chequer5's own full-depth one
        EXX
        LD   A,L                ; the row above is 128 bytes back, and
        SUB  128                ; DE is spoken for
        LD   L,A
        JR   NC,chq4_r2
        DEC  H
chq4_r2:
    IF CHQ4_PAGED
        DEC  B
chq4_next:
        JP   NZ,0               ; patched: this band's compiled body, and
        EXX                     ; one T-state dearer than the DJNZ it
        JP   chq4_b1            ; replaces
    ELSE
        DJNZ chq4_row
        EXX                     ; the band code wants the main set back
        JP   chq4_b1
    ENDIF

chq4_bend:
    IF CHQ4_PAGED
        INC  HL                 ; the byte after the count says which chunk
        LD   A,(HL)             ; of the bank comes next, or zero for the
        OR   A                  ; end of the board
        JR   Z,chq4_bdone
    IF CHQ4_DYNHZ
        INC  HL                 ; where this horizon's bands go on in the
        LD   E,(HL)             ; next chunk, because every horizon has a
        INC  HL                 ; list of its own - and read BEFORE the
        LD   D,(HL)             ; OUT, because after it this table is not
        LD   (chq4_bp+1),DE     ; mapped any more
        OUT  (CHQ4_LMPR),A
    ELSE
        OUT  (CHQ4_LMPR),A
        LD   HL,chq4_band       ; every chunk keeps its band table at its
        LD   (chq4_bp+1),HL     ; foot, so that is all there is to it
        LD   HL,(chq4_acc)      ; but getting here cost a step of the
        LD   BC,(chq4_cx)       ; phase, because the terminator went round
        ADD  HL,BC              ; the band loop to be found - so give it
        LD   (chq4_acc),HL      ; back
    ENDIF
        JP   chq4_b1
chq4_bdone:
    ENDIF
        EXX                     ; the top run spilled into the haze row
        LD   SP,HL              ; above it; put that back
        INC  SP
        EXX
        LD   BC,CHQ4_ABOVE * 0x101
        DUP  CHQ4_SPILL
        PUSH BC
        EDUP
        LD   SP,(chq4_sp)
    IF CHQ4_PAGED
        LD   A,CHQ4_BANK        ; the caller's stack is in the first chunk
        OUT  (CHQ4_LMPR),A
    ENDIF
        EI
        RET

;------------------------------------------------------------------
; Workspace
;------------------------------------------------------------------

chq4_back:      DEFB CHQ4_BUF0
chq4_front:     DEFB CHQ4_BUF1
chq4_camx:      DEFW 0
chq4_camz:      DEFW 0
chq4_sp:        DEFS 2
chq4_cx:        DEFS 2
chq4_acc:       DEFS 2
    IF CHQ4_DYNHZ
chq4_rows:      DEFS 1          ; scanlines of board, 191 - the horizon
chq4_wide:      DEFS 1          ; the widest square down there, and one
chq4_bnk0:      DEFS 1          ; the chunk the bottom band is in
chq4_bp0:       DEFS 2          ; where in its table that band is
chq4_mskp:      DEFS 2          ; and the last byte of the swap mask
chq4_msk:       DEFS 128        ; which is as long as the tallest board
    ELSE
chq4_msk:       DEFS 192 - CHQ4_TOP
    ENDIF
