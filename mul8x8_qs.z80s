;------------------------------------------------------------------
; mul8x8_qs.z80s - 8x8 -> 16 unsigned multiply by quarter squares
;
;   qsmul8   B * C -> DE, in 131 T-states (134 when B < C)
;
; The table-of-squares multiply in 8x8multiply_r16.z80s costs 155T /
; 158T for the same job in half the table space. This one is about
; 20% quicker, and it is the difference-of-quarter-squares identity
; rather than the half-squares one:
;
;   a*b = floor((a+b)^2 / 4) - floor((a-b)^2 / 4)
;
; which is exact for integers, because (a+b) and (a-b) are always the
; same parity, so the two floors lose the same quarter and it cancels.
; No odd/even correction is needed, which is where the saving comes
; from: the half-square version has to work out whether both operands
; are odd and fold a carry in.
;
; The price is the index range. (a+b) reaches 510, so the table needs
; 512 entries rather than 256 - 1024 bytes across four pages, against
; 512 across two. The (a-b) term never exceeds 255, so it reads the
; first page of the same table.
;
; Layout, which must stay exactly this and page-aligned:
;
;   page 0   low byte  of f(0..255)      <- also serves (a-b)
;   page 1   low byte  of f(256..511)
;   page 2   high byte of f(0..255)
;   page 3   high byte of f(256..511)
;
; Entry : B = a, C = b
; Exit  : DE = a*b
; Trash : AF, DE, HL.  B and C are preserved, as are BC', IX and IY.
;
; Verified over all 65,536 operand pairs and timed exactly by
; tests/test_mul8x8_qs.py.
;
; Written by Claude (Opus) for the Z80AIexperiments repo.
;------------------------------------------------------------------

qsmul8:
        LD   A,B            ; [4T]  s = a + b, carry = bit 8 of s
        ADD  A,C            ; [4T]
        LD   L,A            ; [4T]
        LD   A,qs_f / 256   ; [7T]  LD A,n leaves the carry alone, so
        ADC  A,0            ; [7T]  the page picks itself
        LD   H,A            ; [4T]
        LD   E,(HL)         ; [7T]  f(s), low byte
        INC  H              ; [4T]
        INC  H              ; [4T]  the high bytes are two pages up
        LD   D,(HL)         ; [7T]  f(s), high byte
        LD   A,B            ; [4T]  d = |a - b|
        SUB  C              ; [4T]
        JR   NC,qs_abs      ; [7/12T]
        NEG                 ; [8T]
qs_abs:
        LD   L,A            ; [4T]  d never exceeds 255, so page 0
        LD   H,qs_f / 256   ; [7T]
        LD   A,E            ; [4T]  DE = f(s) - f(d) = a*b
        SUB  (HL)           ; [7T]
        LD   E,A            ; [4T]
        INC  H              ; [4T]
        INC  H              ; [4T]
        LD   A,D            ; [4T]
        SBC  A,(HL)         ; [7T]
        LD   D,A            ; [4T]
        RET                 ; [10T]

;------------------------------------------------------------------
; f(x) = floor(x*x/4) for x = 0..511, split low bytes then high.
; Generated - do not edit by hand. MUST be 256-byte aligned.
;------------------------------------------------------------------

        ALIGN 256
qs_f:
        DEFB 0,0,1,2,4,6,9,12,16,20,25,30,36,42,49,56
        DEFB 64,72,81,90,100,110,121,132,144,156,169,182,196,210,225,240
        DEFB 0,16,33,50,68,86,105,124,144,164,185,206,228,250,17,40
        DEFB 64,88,113,138,164,190,217,244,16,44,73,102,132,162,193,224
        DEFB 0,32,65,98,132,166,201,236,16,52,89,126,164,202,241,24
        DEFB 64,104,145,186,228,14,57,100,144,188,233,22,68,114,161,208
        DEFB 0,48,97,146,196,246,41,92,144,196,249,46,100,154,209,8
        DEFB 64,120,177,234,36,94,153,212,16,76,137,198,4,66,129,192
        DEFB 0,64,129,194,4,70,137,204,16,84,153,222,36,106,177,248
        DEFB 64,136,209,26,100,174,249,68,144,220,41,118,196,18,97,176
        DEFB 0,80,161,242,68,150,233,60,144,228,57,142,228,58,145,232
        DEFB 64,152,241,74,164,254,89,180,16,108,201,38,132,226,65,160
        DEFB 0,96,193,34,132,230,73,172,16,116,217,62,164,10,113,216
        DEFB 64,168,17,122,228,78,185,36,144,252,105,214,68,178,33,144
        DEFB 0,112,225,82,196,54,169,28,144,4,121,238,100,218,81,200
        DEFB 64,184,49,170,36,158,25,148,16,140,9,134,4,130,1,128

