        DEFB 29,66,37,112,206,179,213,166,237,32,22,97,94,14,223,24
        DEFB 39,30,2,233,228,6,165,251,156,175,226,23,63,125,208,181
        DEFB 171,80,49,168,218,195,79,223,220,239,137,45,198,134,62,196

;------------------------------------------------------------------
; Workspace - 20 bytes, must be in RAM
;------------------------------------------------------------------

tab64_seed:     DEFB 0,0,0,0    ; 32-bit seed, set it before hashing
tab64_h:        DEFS 8          ; the hash: lane 0 then lane 1
tab_ptr:        DEFS 2
tab_len:        DEFS 2
tab_lenv:       DEFS 2
tab_page:       DEFS 1
tab_pad:        DEFS 1

tab64_end:
TAB64_SIZE:     EQU tab64_end - tab64

