;------------------------------------------------------------------
; tab64.z80s - a 64-bit hash built for a CPU with no multiplier
;
;   tab64        HL = string, BC = length -> a 64-bit hash, in memory
;   tab64_km13   thirteen Bloom filter indices from it
;
; MurmurHash3 is built out of 64-bit multiplies, which a Z80 does not
; have: murmur3.z80s in this repo spends about 90,000 T-states on a
; short string, nearly all of it multiplying. This does the same job
; in 234 T-states per byte plus 2,578 of fixed cost - twenty-five
; times quicker on a short key - by replacing the multiply with the
; one operation a Z80 is good at: a table lookup.
;
; The update is a tabulation (Zobrist) hash in the shape of a CRC:
;
;   h = (h >> 8) XOR T[(h XOR byte) AND 255]
;
; over a 32-bit state, with T a table of 256 random 32-bit words - so
; each input byte pulls in a fresh random word, and the index depends
; on the state, which is what makes it nonlinear (a CRC uses the same
; loop with a table that is linear in the index, and is not a hash).
; Two lanes with independent tables and starting values are run over
; the string, giving 32 bits each; together they are the 64-bit hash,
; and they are exactly the h1 and h2 that Kirsch-Mitzenmacher wants.
;
; Entry : HL = pointer to the string, BC = length in bytes (0..65535)
;         (tab64_seed) = 32-bit seed, little-endian, zero unless set
; Exit  : DE:HL = the low 32 bits (lane 0), and the whole 64-bit hash
;         is in memory at tab64_h as eight little-endian bytes: lane 0
;         then lane 1
; Trash : AF, BC, DE, HL, BC', DE', HL'
;
; Quality, measured against MurmurHash3 x64 on the same tests (see
; tests/test_tab64.py, which runs both):
;
;   avalanche       flipping one input bit flips each output bit with
;                   probability 0.494 to 0.506, against murmur3's
;                   0.495 to 0.508
;   collisions      60,000 sequential integers, 60,000 formatted
;                   strings, every three-letter word, 60,000 random
;                   keys: no 64-bit collisions, and low-24-bit
;                   collision counts within noise of the birthday
;                   expectation, same as murmur3
;   Bloom filter    m = 65536, n = 4000, k = 13: false positive rate
;                   0.0005 against murmur3's 0.0006, both against a
;                   theoretical 0.0004
;   chi-square      the 13 indices over every 1- and 2-byte key, into
;                   a 4096-entry filter: 4194 and 4261 on 4096 cells,
;                   the same range as murmur3's 4143 and 4148
;
; What it is not: a standard. MurmurHash3 gives the same answer here
; as it does in C on a PC; this does not, unless the other end has the
; same 2K of tables. Use murmur3.z80s when the hash has to travel, and
; this when it just has to be fast and well spread.
;
; The tables are eight 256-byte pages - one per byte of each lane's
; 32-bit word - so a lookup is LD L,index / LD H,page / LD A,(HL) with
; INC H stepping to the next byte, the same trick crc32.z80s and the
; table-of-squares multiply use. They MUST stay page-aligned and in
; this order. Their contents are splitmix64(lane*4096 + i + 1), taken
; 32 bits at a time; tests/test_tab64.py regenerates and checks them.
;
; Speed, measured on an emulated Z80 (tests/test_tab64.py):
;
;                        tab64      murmur3_64
;   empty string          2,578          61,064
;   1 byte                2,906          90,449
;   5 bytes               3,842          90,449
;   16 bytes              6,416         126,829
;   256 bytes            62,578       1,077,951
;
;   per byte              234.0         ~4,200 (long strings)
;   tab64_km13            1,496 T-states for all thirteen indices
;
; Written by Claude (Opus) for the Z80AIexperiments repo.
;------------------------------------------------------------------

;------------------------------------------------------------------
; tab64 - hash a block of memory
;------------------------------------------------------------------

tab64:
        LD   (tab_ptr),HL   ; the string
        LD   (tab_len),BC
        LD   (tab_lenv),BC  ; its length gets mixed in at the end

        ; --- lane 0 ------------------------------------------------
        LD   A,tab_t0 / 256
        LD   (tab_page),A
        LD   HL,tab_i0
        CALL tab_start      ; state = init XOR seed, counters set up
        JR   Z,tab_f0       ; nothing to hash
tab_l0:
        LD   A,(DE)         ; [7T]  next byte of the string
        INC  DE             ; [6T]
        EXX                 ; [4T]
        XOR  E              ; [4T]  index = (h XOR byte) AND 255
        LD   L,A            ; [4T]
        LD   H,tab_t0 / 256 ; [7T]
        LD   A,(HL)         ; [7T]  h = (h >> 8) XOR T[index]
        XOR  D              ; [4T]
        LD   E,A            ; [4T]
        INC  H              ; [4T]
        LD   A,(HL)         ; [7T]
        XOR  C              ; [4T]
        LD   D,A            ; [4T]
        INC  H              ; [4T]
        LD   A,(HL)         ; [7T]
        XOR  B              ; [4T]
        LD   C,A            ; [4T]
        INC  H              ; [4T]
        LD   A,(HL)         ; [7T]
        LD   B,A            ; [4T]
        EXX                 ; [4T]
        DJNZ tab_l0         ; [13/8T]
        DEC  C              ; [4T]
        JR   NZ,tab_l0      ; [12/7T]
tab_f0:
        CALL tab_finish     ; length and avalanche rounds
        EXX
        LD   (tab64_h),DE   ; lane 0 is the low half of the hash
        LD   (tab64_h+2),BC
        EXX

        ; --- lane 1 ------------------------------------------------
        LD   A,tab_t1 / 256
        LD   (tab_page),A
        LD   HL,tab_i1
        CALL tab_start
        JR   Z,tab_f1
tab_l1:
        LD   A,(DE)
        INC  DE
        EXX
        XOR  E
        LD   L,A
        LD   H,tab_t1 / 256
        LD   A,(HL)
        XOR  D
        LD   E,A
        INC  H
        LD   A,(HL)
        XOR  C
        LD   D,A
        INC  H
        LD   A,(HL)
        XOR  B
        LD   C,A
        INC  H
        LD   A,(HL)
        LD   B,A
        EXX
        DJNZ tab_l1
        DEC  C
        JR   NZ,tab_l1
tab_f1:
        CALL tab_finish
        EXX
        LD   (tab64_h+4),DE ; lane 1 is the high half
        LD   (tab64_h+6),BC
        EXX
        LD   HL,(tab64_h)   ; hand back the low 32 bits in DE:HL
        LD   DE,(tab64_h+2)
        RET

;------------------------------------------------------------------
; tab_start - set a lane going
;
; Entry : HL = pointer to the lane's four init bytes
; Exit  : the shadow set holds the state, DE = string, BC = the
;         two-level loop counter, Z set if the string is empty
;------------------------------------------------------------------

tab_start:
        LD   DE,(tab64_seed) ; state = init XOR seed
        LD   A,(HL)
        XOR  E
        LD   E,A
        INC  HL
        LD   A,(HL)
        XOR  D
        LD   D,A
        INC  HL
        PUSH DE
        LD   DE,(tab64_seed+2)
        LD   A,(HL)
        XOR  E
        LD   C,A
        INC  HL
        LD   A,(HL)
        XOR  D
        LD   B,A
        POP  DE
        EXX                 ; park it in the shadow set
        LD   DE,(tab_ptr)
        LD   BC,(tab_len)
        LD   A,B            ; an empty string skips the byte loop
        OR   C
        RET  Z              ; Z: the caller jumps past it
        LD   A,B            ; split the count into whole pages and a
        LD   B,C            ; remainder, so the inner loop is a DJNZ
        LD   C,A
        LD   A,B
        OR   A
        JR   Z,tab_pages    ; an exact number of pages
        INC  C              ; one short page, then C full ones
tab_pages:
        LD   A,1            ; return NZ, so the caller runs the loop
        OR   A
        RET

;------------------------------------------------------------------
; tab_finish - mix in the length, then avalanche
;
; Two rounds fed with the length, then four fed with the state's own
; low byte. Four is what it takes for a difference sitting in the top
; byte of the state to be shifted down into the table index, which is
; what decorrelates it.
;------------------------------------------------------------------

tab_finish:
        LD   HL,tab_lenv
        LD   B,2
tab_flen:
        LD   A,(HL)
        INC  HL
        CALL tab_round
        DJNZ tab_flen
        LD   B,4
tab_fmix:
        XOR  A              ; nothing to fold in: index = h AND 255
        CALL tab_round
        DJNZ tab_fmix
        RET

tab_round:                  ; h = (h >> 8) XOR T[(h XOR A) AND 255]
        EXX
        XOR  E
        LD   L,A
        LD   A,(tab_page)
        LD   H,A
        LD   A,(HL)
        XOR  D
        LD   E,A
        INC  H
        LD   A,(HL)
        XOR  C
        LD   D,A
        INC  H
        LD   A,(HL)
        XOR  B
        LD   C,A
        INC  H
        LD   A,(HL)
        LD   B,A
        EXX
        RET

;------------------------------------------------------------------
; tab64_km13 - Kirsch-Mitzenmacher, thirteen indices from one hash
;
; g_i = h1 + i*h2 mod m, i = 0..12, with lane 0 as h1 and lane 1 as
; h2. For m a power of two only the low bits matter, so this is all
; 16-bit and every index is one addition. See murmur3.z80s for the
; reference and for the h2-is-zero caveat.
;
; Entry : HL = pointer to 13 words of output
;         DE = mask, that is m-1, for m a power of two up to 65536
; Exit  : the thirteen indices stored, HL past the end
; Trash : AF, BC, DE, HL, IX, BC'
;------------------------------------------------------------------

tab64_km13:
        PUSH HL
        POP  IX             ; IX = where the indices go
        LD   B,D            ; BC = mask
        LD   C,E
        LD   DE,(tab64_h+4) ; DE = step = lane 1
        LD   HL,(tab64_h)   ; HL = g    = lane 0
        LD   A,13
        EXX
        LD   B,A            ; counter, out of the way in the shadow set
tab_km_loop:
        EXX
        LD   A,L            ; index = g AND mask
        AND  C
        LD   (IX+0),A
        LD   A,H
        AND  B
        LD   (IX+1),A
        INC  IX
        INC  IX
        ADD  HL,DE          ; g += h2
        EXX
        DJNZ tab_km_loop
        EXX
        PUSH IX
        POP  HL
        RET

;------------------------------------------------------------------
; The lane starting values, little-endian
;------------------------------------------------------------------

tab_i0:         DEFB 0x07,0xE2,0xC0,0x6D ; 0x6DC0E207
tab_i1:         DEFB 0x1C,0x3F,0x4B,0x7D ; 0x7D4B3F1C

;------------------------------------------------------------------
; The tables. Eight pages: four bytes of each lane's 32-bit words,
; one byte per page. They MUST be 256-byte aligned and in this order.
;------------------------------------------------------------------

        ALIGN 256
