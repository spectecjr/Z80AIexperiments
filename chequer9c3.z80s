chq5_y47_0:
        LD   A,(DE)             ; this row's mask
        XOR  17
        LD   (HL),A
        LD   A,(DE)
        DEC  DE
        AND  0x90               ; the mask again, as the offset
        ADD  A,(chq4_val + 3328) & 255       ; the complement of this run's
        EXX                     ; values
        LD   L,A
        LD   H,(chq4_val + 3328) >> 8
        LD   SP,HL
        POP  BC
        POP  DE
        POP  HL
        POP  IX
        POP  IY
        POP  AF
        EXX
        LD   SP,HL              ; the runs fill rightwards to left
        INC  SP
        EXX
        JP   chq5_r47_0 + 11

