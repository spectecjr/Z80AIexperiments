        DEFB 15488 % 256,15664 % 256,15842 % 256,16020 % 256,16200 % 256,16380 % 256,16562 % 256,16744 % 256
        DEFB 16928 % 256,17112 % 256,17298 % 256,17484 % 256,17672 % 256,17860 % 256,18050 % 256,18240 % 256
        DEFB 18432 % 256,18624 % 256,18818 % 256,19012 % 256,19208 % 256,19404 % 256,19602 % 256,19800 % 256
        DEFB 20000 % 256,20200 % 256,20402 % 256,20604 % 256,20808 % 256,21012 % 256,21218 % 256,21424 % 256
        DEFB 21632 % 256,21840 % 256,22050 % 256,22260 % 256,22472 % 256,22684 % 256,22898 % 256,23112 % 256
        DEFB 23328 % 256,23544 % 256,23762 % 256,23980 % 256,24200 % 256,24420 % 256,24642 % 256,24864 % 256
        DEFB 25088 % 256,25312 % 256,25538 % 256,25764 % 256,25992 % 256,26220 % 256,26450 % 256,26680 % 256
        DEFB 26912 % 256,27144 % 256,27378 % 256,27612 % 256,27848 % 256,28084 % 256,28322 % 256,28560 % 256
        DEFB 28800 % 256,29040 % 256,29282 % 256,29524 % 256,29768 % 256,30012 % 256,30258 % 256,30504 % 256
        DEFB 30752 % 256,31000 % 256,31250 % 256,31500 % 256,31752 % 256,32004 % 256,32258 % 256,32512 % 256

        ; This table MUST occur 256 bytes after the first one.
m8x8_square_table_hgih:
        DEFB 0 / 256,0 / 256,2 / 256,4 / 256,8 / 256,12 / 256,18 / 256,24 / 256
        DEFB 32 / 256,40 / 256,50 / 256,60 / 256,72 / 256,84 / 256,98 / 256,112 / 256
        DEFB 128 / 256,144 / 256,162 / 256,180 / 256,200 / 256,220 / 256,242 / 256,264 / 256
