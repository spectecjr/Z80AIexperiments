;------------------------------------------------------------------
; mult8x8_16 - 8x8 unsigned multiply via quarter table of squares
;
; Uses the identity: M1*M2 = (M1^2/2 + M2^2/2) - (M1-M2)^2/2
; When both operands are odd, the half-squares are rounded down,
; so 1 is added via carry before accumulating.
;
; Entry : B = M1, C = M2
; Exit  : DE = 16-bit result
; Trash : AF, HL, DE
; Cycles: 159T (M1 >= M2) / 162T (M1 < M2)
;
; m8x8_square_table_low and m8x8_square_table_hgih must each be a 256-byte page-aligned table such that:
;   m8x8_square_table_low[n] = LOW (n*n / 2)
;   m8x8_square_table_hgih[n] = HIGH(n*n / 2)
;
; Based on "Fastest 6502 Multiply Yet" by Charles Putney, published
; in Apple Assembly Line, vol 6 Issue 6 (March 1986).
;
; https://www.txbobsc.com/aal/1986/aal8603.html
;
; Ported by AI, then optimized by Simon Cooke to shave off
; a few t-states (ahhhh.. still better than a robot ;-) ) 
;
;------------------------------------------------------------------

mult8x8_16:
        LD   H,m8x8_square_table_low / 256    ; [7T]  m8x8_square_table_low[M2]
        LD   A,B            ; [4T]  A = M1
        AND  C              ; [4T]  A = M1 AND M2
        RRCA                ; [4T]  carry = bit 0: set iff both factors are odd

        LD   L,C            ; [4T]
        LD   A,(HL)         ; [7T]  A = m8x8_square_table_low[M2]  (carry preserved; LD doesn't touch flags)
        LD   L,B            ; [4T]  m8x8_square_table_low[M1] + odd carry
        ADC  A,(HL)         ; [7T]  A = m8x8_square_table_low[M2] + m8x8_square_table_low[M1] + carry
        LD   E,A            ; [4T]  E = low byte of half-sum

        INC  H              ; [4T]  m8x8_square_table_hgih[M2]
        LD   L,C            ; [4T]
        LD   A,(HL)         ; [7T]  A = m8x8_square_table_hgih[M2]
        LD   L,B            ; [4T]  m8x8_square_table_hgih[M1] + carry from above
        ADC  A,(HL)         ; [7T]  A = m8x8_square_table_hgih[M2] + m8x8_square_table_hgih[M1] + carry
        LD   D,A            ; [4T]  DE = floor(M1^2/2) + floor(M2^2/2) [+1 if both odd]

        LD   A,B            ; [4T]  compute |M1 - M2|
        SUB  C              ; [4T]  carry set if M1 < M2
        JR   NC,m8x8_absok  ; [7T/12T]  branch if M1 >= M2 (not taken / taken)
        NEG                 ; [8T]  A = M2 - M1 = |M1 - M2|
m8x8_absok: LD   C,A            ; [4T]  C = |M1 - M2|  (reuse; M2 no longer needed)
        AND  A              ; [4T]  clear carry for a clean subtraction

        DEC  H              ; [4T]  subtract m8x8_square_table_low[|M1-M2|] from low byte
        LD   L,C            ; [4T]
        LD   A,E            ; [4T]
        SBC  A,(HL)         ; [7T]  A = sum_lo - m8x8_square_table_low[|M1-M2|]
        LD   E,A            ; [4T]  save low byte; borrow propagates in carry

        INC  H              ; [4T]  subtract m8x8_square_table_hgih[|M1-M2|] from high byte
        LD   L,C            ; [4T]  C still holds |M1-M2|
        LD   A,D            ; [4T]
        SBC  A,(HL)         ; [7T]  A = sum_hi - m8x8_square_table_hgih[|M1-M2|] - borrow

        LD   D,A            ; [4T]  D = high byte of product; E is already low part.
        RET                 ; [10T]

;------------------------------------------------------------

;------------------------------------------------------------------
; stream_mult8x8_16 - streaming 8x8 unsigned multiply via table of squares
;
; Entry : IX = address of input stream (M1, M2 pairs)
;         IY = address of output stream (16-bit results)
;         B  = number of operations to perform.
; Trash : AF, BC', HL', DE'
;
; When you positively absolutey have to do a whole bunch of
; multiplies in a row, this version saves a few t-states. 
;------------------------------------------------------------------

stream_mult8x8_16:
        EXX                 ; [4T]
        LD   H,m8x8_square_table_low / 256    ; [7T]  m8x8_square_table_low[M2]
        DEFB 62             ; [7T]  LD A,xxx - consumes following EXX instruction, trashes A.
                            ;       Saves 1 T-state vs doing an EXX followed by an EXX.
stream_mult8x8_16_loop:
        EXX                 ; [4T]
        LD B,(IX)           ; [19T]
        INC IX              ; [10T]
        LD C,(IX)           ; [19T]
        INC IX              ; [10T]
        LD   A,B            ; [4T]  A = M1
        AND  C              ; [4T]  A = M1 AND M2
        RRCA                ; [4T]  carry = bit 0: set iff both factors are odd

        LD   L,C            ; [4T]
        LD   A,(HL)         ; [7T]  A = m8x8_square_table_low[M2]  (carry preserved; LD doesn't touch flags)
        LD   L,B            ; [4T]  m8x8_square_table_low[M1] + odd carry
        ADC  A,(HL)         ; [7T]  A = m8x8_square_table_low[M2] + m8x8_square_table_low[M1] + carry
        LD   E,A            ; [4T]  E = low byte of half-sum

        INC  H              ; [4T]  m8x8_square_table_hgih[M2]
        LD   L,C            ; [4T]
        LD   A,(HL)         ; [7T]  A = m8x8_square_table_hgih[M2]
        LD   L,B            ; [4T]  m8x8_square_table_hgih[M1] + carry from above
        ADC  A,(HL)         ; [7T]  A = m8x8_square_table_hgih[M2] + m8x8_square_table_hgih[M1] + carry
        LD   D,A            ; [4T]  DE = floor(M1^2/2) + floor(M2^2/2) [+1 if both odd]

        LD   A,B            ; [4T]  compute |M1 - M2|
        SUB  C              ; [4T]  carry set if M1 < M2
        JR   NC,m8x8_absok  ; [7T/12T]  branch if M1 >= M2 (not taken / taken)
        NEG                 ; [8T]  A = M2 - M1 = |M1 - M2|
m8x8_absok: LD   C,A            ; [4T]  C = |M1 - M2|  (reuse; M2 no longer needed)
        AND  A              ; [4T]  clear carry for a clean subtraction

        DEC  H              ; [4T]  subtract m8x8_square_table_low[|M1-M2|] from low byte
        LD   L,C            ; [4T]
        LD   A,E            ; [4T]
        SBC  A,(HL)         ; [7T]  A = sum_lo - m8x8_square_table_low[|M1-M2|]
        LD   (IY),A         ; [19T] save low byte; borrow propagates in carry
        INC IY              ; [10T]

        INC  H              ; [4T]  subtract m8x8_square_table_hgih[|M1-M2|] from high byte
        LD   L,C            ; [4T]  C still holds |M1-M2|
        LD   A,D            ; [4T]
        SBC  A,(HL)         ; [7T]  A = sum_hi - m8x8_square_table_hgih[|M1-M2|] - borrow

        LD (IY),A           ; [19T] D = high byte of product
        INC IY              ; [10T]
        EXX                 ; [4T]
        DJNZ stream_mult8x8_16_loop ; [13T/8T] taken/not taken

        RET                 ; [10T]

;------------------------------------------------------------

; This table MUST be 256-byte aligned.
m8x8_square_table_low:
        ALIGN 256
        DEFB 0 % 256,0 % 256,2 % 256,4 % 256,8 % 256,12 % 256,18 % 256,24 % 256
        DEFB 32 % 256,40 % 256,50 % 256,60 % 256,72 % 256,84 % 256,98 % 256,112 % 256
        DEFB 128 % 256,144 % 256,162 % 256,180 % 256,200 % 256,220 % 256,242 % 256,264 % 256
