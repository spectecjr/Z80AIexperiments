        LD   (CHQ4_SCREEN + 17724),A
        LD   A,(CHQ4_SCREEN + 17859)
        AND  0x0F
        LD   (CHQ4_SCREEN + 17859),A
        LD   SP,CHQ4_SCREEN + 17859
        PUSH DE
        LD   DE,0x00A0
        PUSH DE
        LD   DE,0xAAAA
        PUSH DE
        LD   A,(CHQ4_SCREEN + 17852)
        AND  0xF0
        LD   (CHQ4_SCREEN + 17852),A
        LD   A,(CHQ4_SCREEN + 17987)
        AND  0x0F
        LD   (CHQ4_SCREEN + 17987),A
        LD   SP,CHQ4_SCREEN + 17987
        PUSH DE
        LD   DE,0x0AA0
        PUSH DE
        LD   DE,0xAAAA
        PUSH DE
        LD   A,(CHQ4_SCREEN + 17980)
        AND  0xF0
        LD   (CHQ4_SCREEN + 17980),A
        LD   A,(CHQ4_SCREEN + 18115)
        AND  0x0F
        LD   (CHQ4_SCREEN + 18115),A
        LD   SP,CHQ4_SCREEN + 18115
        PUSH DE
        LD   DE,0x0AA0
        PUSH DE
        LD   DE,0xAAAA
        PUSH DE
        LD   A,(CHQ4_SCREEN + 18108)
        AND  0xF0
        LD   (CHQ4_SCREEN + 18108),A
        LD   A,(CHQ4_SCREEN + 18243)
        AND  0x0F
        LD   (CHQ4_SCREEN + 18243),A
        LD   SP,CHQ4_SCREEN + 18243
        LD   DE,0x0000
        PUSH DE
