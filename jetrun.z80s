        PUSH DE
        LD   A,(CHQ4_SCREEN + 18236)
        AND  0xF0
        LD   (CHQ4_SCREEN + 18236),A
        LD   SP,(jet8_sp)
        EI
        RET

        ASSERT $ <= 0x7F00       ; the window, less the caller's stack
