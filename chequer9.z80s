;------------------------------------------------------------------
; chequer9.z80s - the horizon moves
;
;   cq9_init     sky into both buffers, once
;   cq9_frame    draw from (chq4_camx, chq4_camz, cq9_hz), and flip
;
; chequer8's board is the bottom 40% of the screen and stays there.
; This one's horizon moves between row 172 and row 95 - the board taking
; 10% of the screen when the pilot is at the bottom of it and half the
; screen when he is at the top - the way Space Harrier's ground rises to
; meet the player: not because the camera is doing anything a camera
; could do, but because it puts the ground where the eye wants it.
;
; ONE BANK SERVES EVERY HORIZON. A square's width at row y is
; round(S * (y - horizon) / CAMH), which depends on the row's distance
; from the horizon and nothing else. So the band table - how many
; scanlines each square width gets - is the same table at every
; horizon: a taller board simply starts further down it, at the band
; that holds the bottom row of the screen. The bands before that one
; would be off the bottom.
;
; The bank goes up to 80 pixel squares rather than 64, because pitching
; the horizon up brings coarser ground into view: 3,240 compiled bodies
; in four chunks, against chequer8's 2,080 in three.
;
; A HORIZON IS ALLOWED WHEN THE SCREEN'S BOTTOM ROW IS THE LAST ROW OF
; ITS BAND, because a band is drawn whole. 65 of the 78 rows in the
; range are - near the horizon a band is a scanline or two, so nearly
; every row is, and it is the wide bands at the bottom of the screen
; that rule out runs of them. The table in
; chequer9hz.z80s has them: the chunk to page in, where in its band
; table to start, how many scanlines that is, and the widest square,
; which is what the phase accumulator is seeded with.
;
; WHAT THE SWAP MASK DOES ABOUT IT: nothing at all. A scanline's depth
; is CAMH * FOCAL / (y - horizon), which is the same function of the
; same distance, so the 512 lookup tables are the ones chequer5 built -
; only longer, 96 rows rather than 77, and copied as far as the horizon
; says. That is the whole of it: 522 T-states at the shortest board and
; 1,754 at the tallest, against the 1,500 to 7,800 that computing the
; mask a scanline again would have cost.
;
; AND WHAT MOVES DOWN HAS TO BE PUT BACK. When the horizon drops, rows
; that held board or desert become sky, and nothing else paints there.
; Each buffer remembers the board it was drawn with last - per buffer,
; free, because the paged map keeps a copy of this block behind each -
; and puts back the difference.
;
; Written by Claude (Opus) for the Z80AIexperiments repo.
;------------------------------------------------------------------

;------------------------------------------------------------------
; cq9_init - sky into both buffers
;------------------------------------------------------------------

cq9_init:
        JP   chq4_init

;------------------------------------------------------------------
; cq9_frame - one frame at the horizon (cq9_hz) says
;------------------------------------------------------------------

cq9_frame:
        LD   A,(cq9_hz)         ; five bytes a horizon, lowest first -
        LD   L,A                ; and there are 65 of them, so the index
        LD   H,0                ; does not fit in a byte
        LD   E,A
        LD   D,H
        ADD  HL,HL
        ADD  HL,HL
        ADD  HL,DE
        LD   DE,chq4_hztab
        ADD  HL,DE
        LD   A,(HL)             ; the chunk the bottom band is in
        LD   (chq4_bnk0),A
        INC  HL
        LD   E,(HL)
        INC  HL
        LD   D,(HL)
        LD   (chq4_bp0),DE      ; where in its table that band is
        INC  HL
        LD   A,(HL)             ; how many scanlines of board
        LD   (chq4_rows),A
        INC  HL
        LD   A,(HL)
        LD   (chq4_wide),A      ; and the widest square, plus one

        LD   A,(chq4_rows)      ; the swap mask is as long as the board
        DEC  A
        LD   E,A
        LD   D,0
        LD   HL,chq4_msk
        ADD  HL,DE
        LD   (chq4_mskp),HL

        LD   A,(cq9_seen)       ; what this buffer was drawn with last:
        LD   HL,chq4_rows       ; if the board has shrunk since, the rows
        SUB  (HL)               ; it has given up are sky now and nothing
        CALL NZ,cq9_sky         ; else will paint them
        LD   A,(chq4_rows)
        LD   (cq9_seen),A

        CALL cq9_wipe           ; where he was, if nothing else paints it
        CALL chq4_msk8
        CALL chq4_floor
        CALL c9_band
        CALL cq9_pilot

        IN   A,(CHQ4_HMPR)      ; the flip, which is the hardware's own
        AND  31                 ; record of which buffer is which
        LD   C,A
        OR   CHQ4_MODE4
        OUT  (CHQ4_VMPR),A
        LD   A,C
        XOR  CHQ4_SCR0 ^ CHQ4_SCR1
        OUT  (CHQ4_HMPR),A
        RET

;------------------------------------------------------------------
; cq9_wipe - put the sky back where the pilot was
;
; He moves, so the box he has left behind has to be cleared - but only
; the rows of it above the band's top, because the band and the board
; paint everything below that themselves. Where he was is per buffer,
; like everything else here that is remembered at all.
;------------------------------------------------------------------

cq9_wipe:
        LD   A,(cq9_oy)
        INC  A
        RET  Z                  ; he has never been drawn in this buffer
        DEC  A
        LD   B,A
        LD   A,(chq4_rows)      ; the band's top row, which is as far down
        ADD  A,C9_ROWS          ; as the sky now goes
        NEG
        ADD  A,192
        SUB  B                  ; how many of his rows were above it
        RET  C                  ; none, and the band covers the lot
        RET  Z
        CP   JET_H
        JR   C,cq9_w1
        LD   A,JET_H            ; and no more of them than he is tall
cq9_w1:
        LD   C,A
        ADD  A,B
        DEC  A                  ; the last row to put back
        LD   H,A
        LD   L,0
        SRL  H
        RR   L
        LD   A,(cq9_ox)         ; and its right hand end
        ADD  A,JET_W
        LD   E,A
        LD   D,0
        ADD  HL,DE
        LD   DE,CHQ4_SCREEN
        ADD  HL,DE
        DI                      ; SP is about to be the screen
        LD   (cq9_sp),SP
        LD   DE,CHQ4_C1
        LD   A,C                ; the rows to put back, and a row's step
        LD   BC,-128
cq9_w2:
        LD   SP,HL
        DUP  JET_W / 2
        PUSH DE
        EDUP
        ADD  HL,BC
        DEC  A
        JR   NZ,cq9_w2
        LD   SP,(cq9_sp)
        EI
        RET

;------------------------------------------------------------------
; cq9_pilot - draw him where he is now
;
; His page goes in over the board's bank for the length of it, and the
; compiled pose is one walk of the stack pointer from the byte after
; his bottom right corner to his top left - so all this has to do is
; put SP there. No CALL in between: the caller's stack is not mapped.
;------------------------------------------------------------------

cq9_pilot:
        LD   A,(cq9_py)         ; the byte after his bottom right corner
        ADD  A,JET_H - 1
        LD   H,A
        LD   L,0
        SRL  H
        RR   L
        LD   A,(cq9_px)
        ADD  A,JET_W
        LD   E,A
        LD   D,0
        ADD  HL,DE
        LD   DE,CHQ4_SCREEN
        ADD  HL,DE
        DI
        LD   (cq9_sp),SP
        LD   A,JET_BANK         ; his page, over the board's bank
        OUT  (CHQ4_LMPR),A
        LD   A,(cq9_pose)
        ADD  A,A
        LD   E,A
        LD   D,JET_POSE >> 8
        EX   DE,HL              ; DE = his corner, HL = the pose's entry
        LD   A,(HL)
        INC  HL
        LD   H,(HL)
        LD   L,A
        EX   DE,HL              ; and back again
        LD   SP,HL
        EX   DE,HL
        JP   (HL)               ; in, and out at cq9_ret

cq9_ret:
        LD   SP,(cq9_sp)
        LD   A,CHQ4_BANK        ; the caller's stack is in chunk 0
        OUT  (CHQ4_LMPR),A
        EI
        LD   A,(cq9_px)         ; and this buffer has him here now
        LD   (cq9_ox),A
        LD   A,(cq9_py)
        LD   (cq9_oy),A
        RET

;------------------------------------------------------------------
; cq9_sky - put back the rows the band and the board have given up
;
;   A = how many scanlines of board this buffer has lost, and the
;   carry set if it has gained them instead, in which case there is
;   nothing to do: what grew covers its own rows.
;
; The rows in question are the ones above the band's new top, which is
; where the fill ends: the band and the board paint everything below.
;------------------------------------------------------------------

cq9_sky:
        RET  C                  ; it grew, and covers its own rows
        LD   B,A
        LD   A,(chq4_rows)      ; the band's top row, which is where the
        ADD  A,C9_ROWS          ; sky now has to reach down to
        NEG
        ADD  A,192
        LD   H,A
        LD   L,0
        SRL  H
        RR   L                  ; that row's first byte
        LD   DE,CHQ4_SCREEN
        ADD  HL,DE
        DI                      ; SP is about to be the screen
        LD   (cq9_sp),SP
        LD   SP,HL
        LD   DE,CHQ4_C1
cq9_s1:
        DUP  64
        PUSH DE
        EDUP
        DJNZ cq9_s1
        LD   SP,(cq9_sp)
        EI
        RET

cq9_hz:         DEFB 0          ; which horizon, 0 to CHQ4_HZN - 1, from
                                ; the caller: 0 is the tallest board
cq9_seen:       DEFB 0          ; and how many scanlines of board this
                                ; buffer has on it, which is per buffer
cq9_px:         DEFB 56         ; where the pilot is: his left hand byte
cq9_py:         DEFB 48         ; and his top row, both from the caller
cq9_pose:       DEFB 1          ; 0 banking left, 1 level, 2 right
cq9_ox:         DEFB 0          ; and where he is in THIS buffer, which is
cq9_oy:         DEFB 255        ; what has to be put back: 255 for nowhere
cq9_sp:         DEFS 2
