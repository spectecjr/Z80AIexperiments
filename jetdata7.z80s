; Generated by tests/mkjetdata.py - do not edit by hand.
; The pilot, divided at row 81: chequer7, where the city starts.
; Above that line it is a run of PUSHes with the sky baked
; in; below it, a stream to be played over what is there.

        ASSERT (CHQ4_C1 & 255) == 0x11

JET_X:          EQU 112          ; the pilot's left edge
JET_Y:          EQU 48          ; and its top row
JET_SPLIT:      EQU 81          ; where the redrawing starts
JET_W:          EQU 16           ; bytes wide
JET_POSES:      EQU 3           ; banking left, level, right

jet_pose:       ; the two halves of each pose
        DEFW jet_sky0,jet_floor0
        DEFW jet_sky1,jet_floor1
        DEFW jet_sky2,jet_floor2

jet_sp:         DEFS 2          ; the run's way back

