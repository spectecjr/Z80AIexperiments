;------------------------------------------------------------------
; crowdata.z80s - generated by tests/mkcrowdata.py, do not edit
;
; The caw: one 50 Hz frame a row, and the three-caw call above it.
;------------------------------------------------------------------

CROW_FRAMES:    EQU 18           ; 50 Hz frames in one caw
CROW_CAWS:      EQU 3           ; caws in one call
CROW_GAP:       EQU 12           ; frames of silence between them
CROW_D1:        EQU 26          ; ch1 sits this far below ch0
CROW_D2:        EQU 14          ; and ch4 below ch2
CROW_H4:        EQU 4           ; 4f is this much quieter
CROW_SEED:      EQU 0xACE1      ; the LFSR that varies each call

; frequency byte, noise clock byte, tone level, noise level
crow_env:
        DEFB 182,248,  5, 15        ;  0   380 Hz, rasp 3802 Hz
        DEFB 210,217, 12, 14        ;  1   415 Hz, rasp 3401 Hz
        DEFB 217,188, 15, 12        ;  2   425 Hz, rasp 3096 Hz
        DEFB 215,166, 15, 11        ;  3   422 Hz, rasp 2899 Hz
        DEFB 213,154, 14, 10        ;  4   419 Hz, rasp 2801 Hz
        DEFB 209,147, 14,  9        ;  5   414 Hz, rasp 2747 Hz
        DEFB 206,141, 13,  9        ;  6   410 Hz, rasp 2703 Hz
        DEFB 203,134, 13,  8        ;  7   406 Hz, rasp 2653 Hz
        DEFB 200,126, 12,  8        ;  8   402 Hz, rasp 2597 Hz
        DEFB 197,119, 12,  7        ;  9   398 Hz, rasp 2551 Hz
        DEFB 194,111, 11,  7        ; 10   394 Hz, rasp 2500 Hz
        DEFB 190,108, 10,  6        ; 11   389 Hz, rasp 2481 Hz
        DEFB 187,104,  8,  6        ; 12   386 Hz, rasp 2457 Hz
        DEFB 184,101,  6,  5        ; 13   382 Hz, rasp 2439 Hz
        DEFB 180, 98,  4,  4        ; 14   378 Hz, rasp 2421 Hz
        DEFB 178, 94,  2,  3        ; 15   375 Hz, rasp 2398 Hz
        DEFB 176, 94,  1,  1        ; 16   373 Hz, rasp 2398 Hz
        DEFB 176, 94,  0,  0        ; 17   373 Hz, rasp 2398 Hz

; a call: how far up, and how much quieter, each caw of it is
crow_seq:
        DEFB  20,  0
        DEFB  30,  1
        DEFB   8,  2

; what crow_init sends: register, value
CROW_INITS:     EQU 16
crow_ini:
        DEFB 0x1C,0x02
        DEFB 0x1C,0x01
        DEFB 0x14,0x37
        DEFB 0x15,0x08
        DEFB 0x16,0x30
        DEFB 0x18,0x00
        DEFB 0x19,0x00
        DEFB 0x10,0x33
        DEFB 0x11,0x64
        DEFB 0x12,0x54
        DEFB 0x00,0x00
        DEFB 0x01,0x00
        DEFB 0x02,0x00
        DEFB 0x03,0x00
        DEFB 0x04,0x00
        DEFB 0x05,0x00

