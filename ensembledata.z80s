;------------------------------------------------------------------
; ensembledata.z80s - generated by tests/mkensembledata.py, do not edit
;
; The tables that change when the flute and the strings share the
; chip. Everything else - envelopes, vibrato, the phrase, the chord
; lengths - is shakudata.z80s's and stringsdata.z80s's.
;------------------------------------------------------------------

EN_NOISEOCT:    EQU 6           ; the breath's octave, register 0x10
EN_SUS:         EQU 8           ; the pad, under the flute
EN_INITS:       EQU 14          ; registers en_init sets up

; each flute note: frequency byte, its octave in the high nibble for
; register 0x10, and the octave above in the low nibble for 0x11
en_notes:
        DEFB  85,0x30,0x04            ; D4   293.4 Hz
        DEFB 153,0x30,0x04            ; F4   349.2 Hz
        DEFB 192,0x30,0x04            ; G4   391.8 Hz
        DEFB 227,0x30,0x04            ; A4   440.1 Hz
        DEFB  33,0x40,0x05            ; C5   523.0 Hz
        DEFB  85,0x40,0x05            ; D5   586.9 Hz
        DEFB 153,0x40,0x05            ; F5   698.3 Hz

; each chord: the root's byte and its octave for 0x11's high nibble,
; then the third and the fifth for 0x12's two nibbles, then frames
en_chords:
        DEFB  85,0x20,153,0x02,227,0x20,120   ; D3-F3-A3      2.40 s
        DEFB 243,0x10, 85,0x02,153,0x20,120   ; Bb2-D3-F3     2.40 s
        DEFB 153,0x20,227,0x02, 33,0x30,120   ; F3-A3-C4      2.40 s
        DEFB  33,0x20,132,0x02,192,0x20,120   ; C3-E3-G3      2.40 s
        DEFB  85,0x20,153,0x02,227,0x20,170   ; D3-F3-A3      3.40 s

en_ini:
        DEFB 0x1C,0x02
        DEFB 0x1C,0x01
        DEFB 0x14,0x3E
        DEFB 0x15,0x01
        DEFB 0x16,0x03
        DEFB 0x18,0x00
        DEFB 0x19,0x00
        DEFB 0x08,0xC6
        DEFB 0x00,0x00
        DEFB 0x01,0x00
        DEFB 0x02,0x00
        DEFB 0x03,0x00
        DEFB 0x04,0x00
        DEFB 0x05,0x00

