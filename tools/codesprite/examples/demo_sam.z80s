;-----------------------------------------------------------------------
; demo_sam.z80s - a worked example of using compiled sprites
;
; This shows the calling sequences, not a finished game.  Everything to do
; with sprites here is real and verified; the hardware setup at the top is
; deliberately left as a stub, because codesprite never touches hardware
; and the right mode/palette/paging code belongs to your program.
;
; Note the interrupt handling: routines that write through SP need
; interrupts off, and they do NOT disable them themselves - one DI/EI goes
; around a whole batch of sprite work.  Every generated file says whether
; it needs this, as <label>_uses_stack.  All registers are trashed by a
; sprite routine; SP is the only thing guaranteed to come back unchanged.
;
; Build (once sjasmplus is on PATH):
;     sjasmplus examples/demo_sam.z80s
;
; The generated files were produced by:
;     codesprite compile examples/ship14.txt --name spr_ship \
;         --out-dir examples/generated --reloc patch \
;         --routines draw,erase,save,restore
;     codesprite compile examples/solid16.txt --name tile \
;         --out-dir examples/generated --reloc register --form list \
;         --x-align 2 --y-align 2
;-----------------------------------------------------------------------

                ORG  $8000 - $4000      ; code below the display file

                INCLUDE "../runtime/sprite_rt.z80s"

;-----------------------------------------------------------------------
; TODO (yours): select mode 4, point VMPR/HMPR at the display page so the
; whole 24K screen is contiguous at SPR_SCREEN, and load the palette.
; codesprite assumes only that:
;   * the display file starts at SPR_SCREEN and is 256-byte aligned,
;   * the code and the screen are paged in together,
;   * patched routines live in RAM (they rewrite their own immediates).
;-----------------------------------------------------------------------
setup_hardware:
                RET

;-----------------------------------------------------------------------
; A row of identical tiles, drawn by one list-form routine.
;
; The tile is byte-aligned and even-row only (--x-align 2 --y-align 2), so
; a single variant covers every position it is used at.
;-----------------------------------------------------------------------
TILE_COUNT      EQU  8
TILE_Y          EQU  32

draw_tile_row:
                DI                              ; the list lives on the stack
                SPR_LIST_BEGIN                  ; push the return address
                LD   B,TILE_COUNT
                LD   D,TILE_Y
                LD   E,(TILE_COUNT - 1) * 16    ; rightmost tile first
.push_one:
                PUSH BC
                PUSH DE
                SPR_ADDR                        ; HL = address of (E, D)
                SPR_LIST_ADD                    ; push it as an item
                POP  DE
                POP  BC
                LD   A,E
                SUB  16
                LD   E,A
                DJNZ .push_one

                LD   A,TILE_COUNT
                SPR_LIST_CALL tile_draw_list_xe
                EI
                RET

;-----------------------------------------------------------------------
; One moving sprite: keep what is under it, draw, then put it back.
;
; The patched variant is compiled for even x and even y, so this loop
; steps two pixels at a time.  Odd positions would call the xo/yo files.
;-----------------------------------------------------------------------
SHIP_Y          EQU  80

move_ship:
                LD   E,0                ; x
.step:
                PUSH DE
                LD   D,SHIP_Y

                ; Position every routine that is about to run.
                SPR_SETPOS_REGS
                CALL spr_ship_save_single_xe_ye_setpos
                CALL spr_ship_draw_single_xe_ye_setpos
                CALL spr_ship_restore_single_xe_ye_setpos

                ; One DI/EI around the whole batch, not around each routine:
                ; anything with <label>_uses_stack = 1 points SP into the
                ; display file while it runs.  SP itself is always restored
                ; by the routine, so nesting calls like this is safe.
                DI
                CALL spr_ship_save_single_xe_ye     ; keep the background
                CALL spr_ship_draw_single_xe_ye     ; draw the ship
                EI

                HALT                                ; wait for the frame

                DI
                CALL spr_ship_restore_single_xe_ye  ; put it back
                EI

                POP  DE
                LD   A,E
                ADD  A,2                ; stay on an even x for this variant
                LD   E,A
                CP   240
                JP   NZ,.step
                RET

;-----------------------------------------------------------------------
main:
                CALL setup_hardware
                CALL draw_tile_row
                CALL move_ship
                RET

                INCLUDE "generated/tile_draw_list_xe.z80s"
                INCLUDE "generated/spr_ship_draw_single_xe_ye.z80s"
                INCLUDE "generated/spr_ship_save_single_xe_ye.z80s"
                INCLUDE "generated/spr_ship_restore_single_xe_ye.z80s"
                INCLUDE "generated/spr_ship_erase_single_xe_ye.z80s"
