;------------------------------------------------------------------
; chequer10.z80s - a tree on the board
;
;   cq10_init    sky into both buffers, once
;   cq10_frame   draw from (chq4_camx, chq4_camz, cq10_hz), and flip
;
; chequer9's frame with one piece of scenery standing on the board: a
; Space Harrier tree, at whichever of its eight sizes its distance
; calls for, drawn over the board and the desert and under the pilot.
;
; A SCALED SPRITE IS EIGHT SPRITES. Scaling a masked shape as it is
; drawn costs more on a Z80 than drawing it does, so the tree is
; compiled at each of the eight sizes the arcade uses and pops from one
; to the next as it comes in - which is what the arcade does too.
; tests/mktree.py compiles them the way the pilot is compiled, one
; descending walk of the stack pointer a size, so all this has to do is
; put SP at the byte after the bottom right corner of the box and jump
; in. 24 T-states at the smallest size and 21,466 at the largest.
;
; WHERE IT STANDS IS THE CALLER'S BUSINESS. cq10_tk, cq10_tx and
; cq10_ty are its size, its left hand byte and the row it stands on;
; the demo works those out from the tree's depth and the same
; perspective the board is drawn with, and this draws what it is told.
; A size of TREE_N or more is no tree at all, which is how it leaves.
;
; AND WHAT IT LEAVES BEHIND HAS TO BE PUT BACK. The band and the board
; repaint everything below the band's top every frame, so a tree that
; stands on the board needs nothing - but a near one is taller than the
; board is and reaches into the sky, and the sky is painted once.
; cq10_wipe puts back the part of a box that is above the band's top,
; and the tree and the pilot both want it: a box each per buffer,
; because each buffer was last drawn two frames ago with them somewhere
; else. It is entered at 16 - pairs of a block of PUSHes, which is why
; a sprite's box here is a whole number of pairs wide.
;
; Written by Claude (Opus) for the Z80AIexperiments repo.
;------------------------------------------------------------------

;------------------------------------------------------------------
; cq10_init - sky into both buffers
;------------------------------------------------------------------

cq10_init:
        JP   chq4_init

;------------------------------------------------------------------
; cq10_frame - one frame at the horizon (cq10_hz) says
;------------------------------------------------------------------

cq10_frame:
        LD   A,(cq10_hz)        ; seven bytes a horizon, tallest board
        LD   L,A                ; first, and 78 of them - so the index is
        LD   H,0                ; hz * 8 - hz rather than anything that
        LD   E,A                ; fits in a byte
        LD   D,H
        ADD  HL,HL
        ADD  HL,HL
        ADD  HL,HL
        OR   A
        SBC  HL,DE
        LD   DE,chq4_hztab
        ADD  HL,DE
        LD   A,(HL)             ; the chunk this horizon's widest band is
        LD   (chq4_bnk0),A      ; in
        INC  HL
        LD   E,(HL)
        INC  HL
        LD   D,(HL)
        LD   (chq4_bp0),DE      ; and where its list of bands starts
        INC  HL
        LD   A,(HL)             ; how many scanlines of board
        LD   (chq4_rows),A
        INC  HL
        LD   A,(HL)
        LD   (chq4_wide),A      ; the widest square, plus one
        INC  HL
        LD   A,(HL)             ; and how fast the mask walks the deep
        LD   (chq4_gf+1),A      ; board: a step of 1.00 draws every
        INC  HL                 ; scanline of it, 5.28 draws one in five
        LD   A,(HL)
        LD   (chq4_gi+1),A

        LD   A,(chq4_rows)      ; the swap mask is as long as the board
        DEC  A
        LD   E,A
        LD   D,0
        LD   HL,chq4_msk
        ADD  HL,DE
        LD   (chq4_mskp),HL

        LD   A,(cq10_seen)      ; what this buffer was drawn with last:
        LD   HL,chq4_rows       ; if the board has shrunk since, the rows
        SUB  (HL)               ; it has given up are sky now and nothing
        CALL NZ,cq10_sky        ; else will paint them
        LD   A,(chq4_rows)
        LD   (cq10_seen),A

        CALL cq10_gone          ; the boxes the pilot and the tree have
        CALL chq4_msk8          ; left behind, as far as the sky reaches
        CALL chq4_floor
        CALL c9_band
        CALL cq10_tree          ; the tree over the board and the desert,
        CALL cq10_pilot         ; and the pilot over the tree

        IN   A,(CHQ4_HMPR)      ; the flip, which is the hardware's own
        AND  31                 ; record of which buffer is which
        LD   C,A
        OR   CHQ4_MODE4
        OUT  (CHQ4_VMPR),A
        LD   A,C
        XOR  CHQ4_SCR0 ^ CHQ4_SCR1
        OUT  (CHQ4_HMPR),A
        RET

;------------------------------------------------------------------
; cq10_gone - put the sky back where the pilot and the tree were
;
; Both are per buffer, because this buffer was last drawn two frames
; ago with them somewhere else and the paged map keeps a copy of this
; block behind each. Afterwards the cells say where they are now,
; whether they are drawn or not: a tree that has gone off the bottom
; still has to be wiped out of the buffer it was last in.
;------------------------------------------------------------------

cq10_gone:
        LD   A,(cq10_oy)        ; the pilot, if he has ever been here
        INC  A
        JR   Z,cq10_g1
        DEC  A                  ; his top row
        LD   B,JET_H
        LD   C,JET_W
        LD   HL,cq10_ox
        LD   D,(HL)
        CALL cq10_wipe
cq10_g1:
        LD   A,(cq10_otk)       ; and the tree, if there was one
        CP   TREE_N
        JR   NC,cq10_g2
        ADD  A,A                ; two bytes a size: wide, and tall
        LD   L,A
        LD   H,0
        LD   DE,tree_box
        ADD  HL,DE
        LD   C,(HL)
        INC  HL
        LD   B,(HL)
        LD   A,(cq10_oty)       ; it stands ON its bottom row, so its top
        SUB  B                  ; is that many scanlines above
        INC  A
        LD   HL,cq10_otx
        LD   D,(HL)
        CALL cq10_wipe
cq10_g2:
        LD   A,(cq10_px)        ; and now they are here
        LD   (cq10_ox),A
        LD   A,(cq10_py)
        LD   (cq10_oy),A
        LD   A,(cq10_tk)
        LD   (cq10_otk),A
        LD   A,(cq10_tx)
        LD   (cq10_otx),A
        LD   A,(cq10_ty)
        LD   (cq10_oty),A
        RET

;------------------------------------------------------------------
; cq10_wipe - the sky back over a box, as far down as the band's top
;
;   A = the box's top row      C = how many bytes wide, and even
;   B = how many rows it has   D = its left hand byte
;
; Everything below the band's top is painted by the band and the board
; every frame, so only what is above it is anyone's business here. The
; fill is a block of PUSHes entered at 16 - pairs, which is why a box
; is a whole number of pairs wide: see tests/tree.py.
;------------------------------------------------------------------

cq10_wipe:
        LD   (cq10_wt),A
        LD   A,B
        LD   (cq10_wh),A
        LD   A,(chq4_rows)      ; the band's top row, which is as far
        ADD  A,C9_ROWS          ; down as the sky goes
        NEG
        ADD  A,192
        LD   HL,cq10_wt
        SUB  (HL)               ; how many of the box's rows are above it
        RET  C                  ; none: the band covers the lot
        RET  Z
        LD   HL,cq10_wh
        CP   (HL)
        JR   C,cq10_w1
        LD   A,(HL)             ; and no more of them than the box is tall
cq10_w1:
        LD   (cq10_wh),A        ; the rows to put back
        LD   HL,cq10_wt
        ADD  A,(HL)
        DEC  A                  ; the last of them
        LD   H,A
        LD   L,0
        SRL  H
        RR   L
        LD   A,D                ; and its right hand end
        ADD  A,C
        LD   E,A
        LD   D,0
        ADD  HL,DE
        LD   DE,CHQ4_SCREEN
        ADD  HL,DE
        SRL  C                  ; pairs, and so where to enter the block
        LD   A,16
        SUB  C
        LD   C,A
        LD   B,0
        LD   IX,cq10_wp
        ADD  IX,BC
        LD   DE,CHQ4_SKYC
        LD   BC,-128            ; a row's step, and the rows to do
        LD   A,(cq10_wh)
        DI                      ; SP is about to be the screen
        LD   (cq10_sp),SP
cq10_w2:
        LD   SP,HL
        JP   (IX)
cq10_wp:
        DUP  16
        PUSH DE
        EDUP
        ADD  HL,BC
        DEC  A
        JR   NZ,cq10_w2
        LD   SP,(cq10_sp)
        EI
        RET

;------------------------------------------------------------------
; cq10_tree - the tree where it stands now
;
; Its page goes in over the board's bank for the length of it, and the
; compiled size is one walk of the stack pointer from the byte after
; the bottom right corner of its box to the top left - so all this has
; to do is put SP there. The box comes out of the resident copy of the
; table, because SP has to be on the corner before the page that holds
; the sprite is mapped over the board's. No CALL in between: the
; caller's stack is not mapped.
;------------------------------------------------------------------

cq10_tree:
        LD   A,(cq10_tk)
        CP   TREE_N
        RET  NC                 ; no tree this frame
        ADD  A,A
        LD   L,A
        LD   H,0
        LD   DE,tree_box
        ADD  HL,DE
        LD   C,(HL)             ; how many bytes wide it is
        LD   A,(cq10_ty)        ; the byte after its bottom right corner,
        LD   H,A                ; which is the row it stands on
        LD   L,0
        SRL  H
        RR   L
        LD   A,(cq10_tx)
        ADD  A,C
        LD   E,A
        LD   D,0
        ADD  HL,DE
        LD   DE,CHQ4_SCREEN
        ADD  HL,DE
        DI
        LD   (cq10_sp),SP
        LD   A,TREE_BANK        ; its page, over the board's bank
        OUT  (CHQ4_LMPR),A
        LD   A,(cq10_tk)        ; four bytes a size in the table there
        ADD  A,A
        ADD  A,A
        LD   E,A
        LD   D,TREE_TAB >> 8
        EX   DE,HL              ; DE = the corner, HL = the size's entry
        LD   A,(HL)
        INC  HL
        LD   H,(HL)
        LD   L,A
        EX   DE,HL              ; and back again
        LD   SP,HL
        EX   DE,HL
        JP   (HL)               ; in, and out at cq10_ret

cq10_ret:
        LD   SP,(cq10_sp)
        LD   A,CHQ4_BANK        ; the caller's stack is in chunk 0
        OUT  (CHQ4_LMPR),A
        EI
        RET

;------------------------------------------------------------------
; cq10_pilot - draw him where he is now
;
; chequer9's, less the note of where he is: cq10_gone keeps that now,
; because the tree wants the same thing and a sprite that is not drawn
; still has to be wiped.
;------------------------------------------------------------------

cq10_pilot:
        LD   A,(cq10_py)        ; the byte after his bottom right corner
        ADD  A,JET_H - 1
        LD   H,A
        LD   L,0
        SRL  H
        RR   L
        LD   A,(cq10_px)
        ADD  A,JET_W
        LD   E,A
        LD   D,0
        ADD  HL,DE
        LD   DE,CHQ4_SCREEN
        ADD  HL,DE
        DI
        LD   (cq10_sp),SP
        LD   A,JET_BANK         ; his page, over the board's bank
        OUT  (CHQ4_LMPR),A
        LD   A,(cq10_pose)
        ADD  A,A
        LD   E,A
        LD   D,JET_POSE >> 8
        EX   DE,HL              ; DE = his corner, HL = the pose's entry
        LD   A,(HL)
        INC  HL
        LD   H,(HL)
        LD   L,A
        EX   DE,HL              ; and back again
        LD   SP,HL
        EX   DE,HL
        JP   (HL)               ; in, and out at cq10_ret

;------------------------------------------------------------------
; cq10_sky - put back the rows the band and the board have given up
;
;   A = how many scanlines of board this buffer has lost, and the
;   carry set if it has gained them instead, in which case there is
;   nothing to do: what grew covers its own rows.
;------------------------------------------------------------------

cq10_sky:
        RET  C                  ; it grew, and covers its own rows
        LD   B,A
        LD   A,(chq4_rows)      ; the band's top row, which is where the
        ADD  A,C9_ROWS          ; sky now has to reach down to
        NEG
        ADD  A,192
        LD   H,A
        LD   L,0
        SRL  H
        RR   L                  ; that row's first byte
        LD   DE,CHQ4_SCREEN
        ADD  HL,DE
        DI                      ; SP is about to be the screen
        LD   (cq10_sp),SP
        LD   SP,HL
        LD   DE,CHQ4_SKYC
cq10_s1:
        DUP  64
        PUSH DE
        EDUP
        DJNZ cq10_s1
        LD   SP,(cq10_sp)
        EI
        RET

cq10_hz:        DEFB 0          ; which horizon, 0 to CHQ4_HZN - 1, from
                                ; the caller: 0 is the tallest board
cq10_seen:      DEFB 0          ; and how many scanlines of board this
                                ; buffer has on it, which is per buffer
cq10_px:        DEFB 56         ; where the pilot is: his left hand byte
cq10_py:        DEFB 48         ; and his top row, both from the caller
cq10_pose:      DEFB 1          ; 0 banking left, 1 level, 2 right
cq10_tk:        DEFB 255        ; and the tree: its size, TREE_N or more
cq10_tx:        DEFB 0          ; for none, its left hand byte, and the
cq10_ty:        DEFB 0          ; row it stands on
cq10_ox:        DEFB 0          ; where they are in THIS buffer, which is
cq10_oy:        DEFB 255        ; what has to be put back: 255 for nowhere
cq10_otk:       DEFB 255
cq10_otx:       DEFB 0
cq10_oty:       DEFB 0
cq10_wt:        DEFB 0          ; and the box cq10_wipe is working on
cq10_wh:        DEFB 0
cq10_sp:        DEFS 2
