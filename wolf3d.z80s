;------------------------------------------------------------------
; wolf3d.z80s - a textured grid maze for the SAM Coupe
;
;   w3d_init     build the scalers, black both buffers
;   w3d_frame    cast, draw and show one frame from w3d_px/py/ang
;   w3d_cast     fill the column list by ray casting the map
;   w3d_draw     draw the column list in w3d_cols into the back buffer
;   w3d_flip     swap the buffers
;
; Half horizontal resolution, which is what makes this possible at all:
; 128 columns of two pixels, so a screen column is exactly one byte of
; a MODE 4 line, and a wall column is one byte written straight down
; the screen. The viewport is 256x144, letterboxed into 256x192.
;
; WHY THIS IS THE OPPOSITE OF room3d. That renderer never wrote a
; column, because a flat run along a row goes at 5.5 T-states a byte
; with PUSH and a column costs three times that. A textured wall has a
; different texel in every column, so there are no runs along a row to
; find - the texture forces column order, and the whole job becomes
; making a column write cheap.
;
; Measured on the emulator, per screen byte of a wall column:
;
;   an accumulator loop, stepping the texture by a fraction   72.6 T
;   an unrolled scaler with the texture steps baked in        22.8 T
;   a flat column with no texture at all                      18.4 T
;
; So the texturing costs 4 T-states a byte and the column order costs
; 13 more than a row would. That is the whole story of this file: the
; scalers exist to turn 72.6 into 22.8.
;
; THE SCALERS. w3d_scalgen writes, for each wall height on a ladder, a
; run of unrolled code that maps the 32 texels of a texture column onto
; that many screen rows:
;
;   LD A,(DE)          the next texel, once per texel rather than once
;   INC DE             per row
;   LD (HL),A          } as many times as this texel is stretched to
;   ADD HL,BC          } cover, BC being 128, one screen row
;
; and the caller points HL at the top of the column and DE at the
; texture column. The ladder is geometric rather than uniform - every
; second height while the wall is short, every eighth while it fills
; the screen - so the height error stays near 6% everywhere instead of
; being negligible near and hopeless far. That keeps the whole bank
; inside 5K; a uniform ladder to the same accuracy would need 30K.
;
; WHAT A FRAME COSTS, measured on the emulator over 96 camera poses in
; each of the two viewports the repo generates tables for:
;
;                     256x144, 128 rays      192x96, 96 rays
;   w3d_frame mean       712,706 T              453,596 T
;             min/max  583,652/780,755      391,511/483,338
;   at 6 MHz              8.4 Hz                 13.2 Hz
;
;   wall columns         363,110 T  51%        211,374 T  47%
;   w3d_cast             241,826 T  34%        184,564 T  41%
;   w3d_prefill          107,656 T  15%         57,544 T  13%
;
;   wall bytes a frame    14,297 at 25.4 T      7,353 at 28.7 T
;   T-states a ray         1,889                 1,923
;   scaler bank            5,508 bytes           3,624 bytes
;   w3d_init           1,899,320 T once      1,734,704 T once
;
; Those are the rates the work costs. What a display shows is coarser:
; a routine that syncs to the flyback holds a frame for a whole number
; of 50ths of a second, so 8.4 Hz is really 120ms in the cheap views
; and 140ms in the dear ones. Over the demo walk in demo/maze.gif that
; is 42 frames at 120ms and 58 at 140ms - 7.6 Hz - and in the small
; viewport 95 at 80ms and 55 at 100ms, 11.5 Hz. The GIFs are timed
; that way, a frame held as long as it really costs.
;
; The three lines divide the same way in both viewports, so neither is
; the thing to attack: the wall bytes are the floor for a textured
; wall, the prefill is the floor for anything at all, and the cast is
; what is left. Halving the pixels bought 1.57x, which is what the
; arithmetic says it should. A ray costs slightly more in the small
; view only because the two per-frame tables are shared out over 96
; rays instead of 128.
;
; Four pixels a column would be the next step: it halves the rays
; again and lets a scaler write two bytes a row rather than one.
;
; RAM outside the two screen buffers: the scaler bank at W3D_SCAL, two
; 512-byte tables at W3D_TX and W3D_TY that w3d_cast rebuilds each
; frame, and qsmul8's own 1K of quarter squares, which this file needs
; but does not contain - assemble mul8x8_qs.z80s alongside it.
;
; Written by Claude (Opus) for the Z80AIexperiments repo.
;------------------------------------------------------------------

; W3D_TOP, W3D_VH, W3D_HALF, W3D_COLS and W3D_XOFF - where the
; viewport is and how big - come from wolfview.z80s, which is generated
; with the height tables that have to agree with them. Assemble it
; first. Everything below is the same code whatever they say.

W3D_TEX:        EQU 32          ; textures are 32 wide by 32 tall
W3D_BUF0:       EQU 0x80
W3D_BUF1:       EQU 0x20
W3D_SCAL:       EQU 0xE000      ; the scaler bank lives up here
W3D_TX:         EQU 0xFA00      ; and the two per-frame product tables
W3D_TY:         EQU 0xFC00      ; at the top of memory

;------------------------------------------------------------------
; w3d_init - black both buffers and build the scaler bank
;------------------------------------------------------------------

w3d_init:
        LD   A,W3D_BUF0
        LD   (w3d_back),A
        LD   A,W3D_BUF1
        LD   (w3d_front),A
        LD   H,W3D_BUF0
        CALL w3d_black
        LD   H,W3D_BUF1
        CALL w3d_black
        ; fall through into the generator

;------------------------------------------------------------------
; w3d_scalgen - write the unrolled scalers, one per ladder height
;
; For a wall H screen rows tall the texel for row k is (k*32)/H, which
; is walked with a Bresenham accumulator rather than a division, and
; the texture pointer only moves when the texel changes.
;------------------------------------------------------------------

w3d_scalgen:
        LD   HL,W3D_SCAL
        LD   (w3d_gp),HL
        LD   IX,w3d_ladder
        LD   IY,w3d_scal
        LD   B,W3D_NLAD
w3d_sg1:
        PUSH BC
        LD   HL,(w3d_gp)    ; this height's scaler starts here
        LD   (IY+0),L
        LD   (IY+1),H
        INC  IY
        INC  IY
        LD   A,(IX+0)       ; H, the drawn height
        LD   (w3d_gh),A
        INC  IX

        LD   (HL),0x1A      ; LD A,(DE)   - the first texel
        INC  HL
        XOR  A
        LD   (w3d_gacc),A   ; the Bresenham accumulator
        LD   (w3d_gmoved),A
        LD   A,(w3d_gh)
        LD   B,A
w3d_sg2:
        LD   (HL),0x77      ; LD (HL),A   - this row, with the texel the
        INC  HL             ; accumulator has reached so far
        LD   (HL),0x09      ; ADD HL,BC   - one row down
        INC  HL

        LD   A,(w3d_gacc)   ; then acc += 32, stepping the texel while it
        ADD  A,W3D_TEX      ; overflows the height, ready for the next row
        LD   C,A
        LD   A,0
        ADC  A,0
        LD   D,A            ; D:C = acc
        LD   A,(w3d_gh)
        LD   E,A
w3d_sg3:
        LD   A,D            ; while acc >= H
        OR   A
        JR   NZ,w3d_sg4
        LD   A,C
        CP   E
        JR   C,w3d_sg5
w3d_sg4:
        LD   A,C
        SUB  E
        LD   C,A
        LD   A,D
        SBC  A,0
        LD   D,A
        LD   (HL),0x13      ; INC DE      - on to the next texel
        INC  HL
        LD   A,1
        LD   (w3d_gmoved),A
        JR   w3d_sg3
w3d_sg5:
        LD   A,C
        LD   (w3d_gacc),A
        LD   A,(w3d_gmoved) ; and reload it if it moved
        OR   A
        JR   Z,w3d_sg6
        XOR  A
        LD   (w3d_gmoved),A
        LD   (HL),0x1A      ; LD A,(DE)
        INC  HL
w3d_sg6:
        DJNZ w3d_sg2

        LD   (HL),0xC9      ; RET
        INC  HL
        LD   (w3d_gp),HL
        POP  BC
        DJNZ w3d_sg1
        RET

;------------------------------------------------------------------
; w3d_black - 0x6000 bytes from H:00
;------------------------------------------------------------------

w3d_black:
        LD   L,0
        LD   D,0x60
w3d_bl1:
        LD   B,0
w3d_bl2:
        LD   (HL),0
        INC  HL
        DJNZ w3d_bl2
        DEC  D
        JR   NZ,w3d_bl1
        RET

        MACRO W3DSKIP       ; from the start of one row to the end of
        IF 128 - W3D_COLS   ; the one above, when there is a border
        LD   HL,W3D_COLS - 128
        ADD  HL,SP
        LD   SP,HL
        ENDIF
        ENDM

;------------------------------------------------------------------
; w3d_prefill - ceiling over the top half of the viewport, floor over
; the bottom, off the stack pointer at 5.5 T-states a byte
;
; Every wall column is written over the top of this. Filling the lot
; and overdrawing is cheaper than working out what the walls will not
; cover, because a byte written along a row costs a third of one
; written down a column.
;------------------------------------------------------------------

w3d_prefill:
        DI
        LD   (w3d_sp),SP
        LD   A,(w3d_back)
        LD   H,A
        LD   L,0
        LD   DE,(W3D_TOP + W3D_HALF - 1) * 128 + W3D_XOFF + W3D_COLS
        ADD  HL,DE          ; one past the last ceiling byte
        LD   SP,HL
        LD   A,(w3d_ceil)
        LD   B,A
        LD   C,A
        LD   A,W3D_HALF
        LD   (w3d_pfn),A
w3d_pf1:
        DUP  W3D_COLS / 2
        PUSH BC
        EDUP
        W3DSKIP
        LD   A,(w3d_pfn)
        DEC  A
        LD   (w3d_pfn),A
        JR   NZ,w3d_pf1

        LD   A,(w3d_back)
        LD   H,A
        LD   L,0
        LD   DE,(W3D_TOP + W3D_VH - 1) * 128 + W3D_XOFF + W3D_COLS
        ADD  HL,DE          ; one past the last floor byte
        LD   SP,HL
        LD   A,(w3d_floor)
        LD   B,A
        LD   C,A
        LD   A,W3D_HALF
        LD   (w3d_pfn),A
w3d_pf2:
        DUP  W3D_COLS / 2
        PUSH BC
        EDUP
        W3DSKIP
        LD   A,(w3d_pfn)
        DEC  A
        LD   (w3d_pfn),A
        JR   NZ,w3d_pf2

        LD   SP,(w3d_sp)
        EI
        RET

;------------------------------------------------------------------
; w3d_draw - the whole viewport from the column list
;
; w3d_cols holds three bytes a column: the wall half height, which
; texture, and which column of it. A half height of zero leaves the
; column as ceiling and floor.
;------------------------------------------------------------------

w3d_draw:
        CALL w3d_prefill
        LD   IX,w3d_cols
        LD   A,W3D_XOFF
        LD   (w3d_cx),A
w3d_dr1:
        LD   A,(IX+0)       ; the half height
        OR   A
        JP   Z,w3d_dr2

        LD   L,A            ; the ladder rung for it
        LD   H,w3d_hidx / 256
        LD   A,(HL)
        ADD  A,A
        LD   L,A
        LD   H,w3d_scal / 256
        LD   E,(HL)
        INC  L
        LD   D,(HL)
        LD   (w3d_call+1),DE    ; the scaler to run

        LD   A,(IX+0)       ; where its top is: 72 - h, rounded onto the
        LD   L,A            ; rung the scaler was built for
        LD   H,w3d_htop / 256
        LD   A,(HL)
        SRL  A              ; and a row is half a page, so the address
        LD   L,0            ; is (row >> 1) pages on and (row & 1) half
        RR   L              ; pages in - no multiply
        LD   H,A
        LD   A,(w3d_back)
        ADD  A,H
        LD   H,A
        LD   A,(w3d_cx)
        ADD  A,L
        LD   L,A            ; HL -> the top of this column

        LD   A,(IX+2)       ; the texture column: base + u * 32, which
        RRCA                ; needs sixteen bits - u reaches 31, so the
        RRCA                ; product reaches 992
        RRCA
        LD   E,A
        AND  0x1F
        LD   D,A
        LD   A,E
        AND  0xE0
        LD   E,A
        LD   A,(IX+1)
        ADD  A,D
        LD   D,A
        LD   BC,128
w3d_call:
        CALL 0              ; patched: the scaler for this height
w3d_dr2:
        LD   BC,3
        ADD  IX,BC
        LD   A,(w3d_cx)
        INC  A
        LD   (w3d_cx),A
        CP   W3D_XOFF + W3D_COLS
        JP   C,w3d_dr1
        RET

;------------------------------------------------------------------
; w3d_cast - one ray a screen column, into the column list
;
; Lodev's DDA: step to whichever grid line comes next, in x or in y,
; until the cell stepped into is solid. Everything inside the loop is
; an add and a compare. The two things that would otherwise be a
; division and a multiply are a table each:
;
;   w3d_recip   the distance along the ray between one grid line and
;               the next, from the ray component - built once, ever
;
;   W3D_TX/TY   the camera's position inside its own cell times i, for
;               i = 0..255 - built once a frame, because the position
;               is the same for every ray in the frame, and read twice
;               a ray to get the distance to the first grid line
;
; The second one is the interesting one. It wants (f * dd) >> 8 with f
; a byte and dd sixteen bits, which is two multiplies; but f is fixed
; for the whole frame, so a table of f*i answers both halves:
;
;   f * dd = 256 * T[dd >> 8] + T[dd & 255]
;
; and the table is built by pushing a running sum onto the stack, 22
; T-states an entry. Two of them cost 11,000 T-states a frame and save
; four quarter-square multiplies a ray, which would be 76,000.
;
; The map is 16 by 16 page aligned, one byte a cell, so the map pointer
; is a whole cell step at INC C or ADD A,16 and the cell is LD A,(BC)
; at seven T-states. That is why BC is the map pointer and the two
; delta distances are patched into the loop as immediates instead.
;
; The map must have a solid border: nothing bounds checks, and a ray
; that escaped would wrap around the page rather than stop.
;
; Entry : (w3d_px), (w3d_py) the camera, 8.8 in map cells
;         (w3d_ang) the heading, 0..255
; Exit  : w3d_cols filled, three bytes a column
; Needs : qsmul8 from mul8x8_qs.z80s, for the texture coordinate
;------------------------------------------------------------------

w3d_cast:
        LD   A,(w3d_ang)        ; the direction vector
        ADD  A,64
        CALL w3d_sinlk
        LD   (w3d_rx),HL        ; dx
        LD   A,(w3d_ang)
        CALL w3d_planelk
        EX   DE,HL
        LD   HL,0
        OR   A
        SBC  HL,DE              ; plx = -PLANE[ang]
        PUSH HL
        EX   DE,HL
        LD   HL,(w3d_rx)
        OR   A
        SBC  HL,DE              ; the leftmost ray, dir - plane
        LD   (w3d_rx),HL
        POP  HL
        CALL w3d_asr6           ; and a 128th of the plane's width is
        LD   (w3d_sx),HL        ; the step from one ray to the next

        LD   A,(w3d_ang)
        CALL w3d_sinlk
        LD   (w3d_ry),HL        ; dy
        LD   A,(w3d_ang)
        ADD  A,64
        CALL w3d_planelk        ; ply = PLANE[ang+64]
        PUSH HL
        EX   DE,HL
        LD   HL,(w3d_ry)
        OR   A
        SBC  HL,DE
        LD   (w3d_ry),HL
        POP  HL
        CALL w3d_asr6
        LD   (w3d_sy),HL

        LD   A,(w3d_px)         ; where the camera sits inside its cell
        LD   HL,W3D_TX
        CALL w3d_ftab
        LD   A,(w3d_py)
        LD   HL,W3D_TY
        CALL w3d_ftab

        LD   A,(w3d_py+1)       ; and which cell that is
        ADD  A,A
        ADD  A,A
        ADD  A,A
        ADD  A,A
        LD   C,A
        LD   A,(w3d_px+1)
        ADD  A,C
        LD   (w3d_c0),A
        LD   A,w3d_map / 256
        LD   (w3d_c0+1),A

        LD   IY,w3d_cols
        LD   A,W3D_COLS
        LD   (w3d_cn),A

;------------------------------------------------------------------
; one ray: the x axis first - which way it steps, how far to the first
; vertical grid line, and the delta distance patched into the loop
;------------------------------------------------------------------

w3d_cl:
        LD   HL,(w3d_rx)
        LD   A,H
        OR   A
        JP   P,w3d_xpos
        XOR  A                  ; |rx|
        SUB  L
        LD   L,A
        SBC  A,A
        SUB  H
        LD   H,A
        LD   A,0x0D             ; DEC C - one cell left
        LD   (w3d_xstep),A
        XOR  A                  ; and no flip of the texture across it
        LD   (w3d_uxor1+1),A
        INC  A
        JR   w3d_xsg
w3d_xpos:
        LD   A,0x0C             ; INC C - one cell right
        LD   (w3d_xstep),A
        LD   A,0xFF
        LD   (w3d_uxor1+1),A
        XOR  A
w3d_xsg:
        LD   (w3d_xsgn),A

        SLA  L                  ; i = |rx| >> 7, the reciprocal index
        LD   A,H
        ADC  A,A
        ADD  A,A                ; DE = w3d_recip[i] = the delta distance
        LD   L,A
        LD   A,w3d_recip / 256
        ADC  A,0
        LD   H,A
        LD   E,(HL)
        INC  L
        LD   D,(HL)
        LD   A,E                ; which the DDA adds as an immediate
        LD   (w3d_xa1+1),A
        LD   A,D
        LD   (w3d_xa2+1),A

        LD   A,D                ; n = (f * ddx) >> 8, out of the table
        ADD  A,A                ;   = TX[ddx >> 8] + high(TX[ddx & 255])
        LD   L,A
        LD   A,W3D_TX / 256
        ADC  A,0
        LD   H,A
        LD   C,(HL)
        INC  L
        LD   B,(HL)
        LD   A,E
        ADD  A,A
        LD   L,A
        LD   A,W3D_TX / 256
        ADC  A,0
        LD   H,A
        LD   A,(HL)             ; the low byte only decides a rounding
        INC  L
        LD   L,(HL)
        LD   H,0
        ADD  HL,BC              ; HL = n
        LD   B,A                ; B = the low byte
        LD   A,(w3d_xsgn)
        OR   A
        JR   NZ,w3d_xdone       ; stepping left: the distance is n

        LD   A,B                ; stepping right: it is the rest of the
        OR   A                  ; cell, ddx - ceil(n), which the low
        EX   DE,HL              ; byte says whether to round up
        JR   Z,w3d_xd1
        DEC  HL
w3d_xd1:
        SBC  HL,DE
w3d_xdone:
        LD   (w3d_sdx),HL

;------------------------------------------------------------------
; the y axis, the same again
;------------------------------------------------------------------

        LD   HL,(w3d_ry)
        LD   A,H
        OR   A
        JP   P,w3d_ypos
        XOR  A
        SUB  L
        LD   L,A
        SBC  A,A
        SUB  H
        LD   H,A
        LD   A,-16              ; ADD A,-16 - one cell back
        LD   (w3d_ystep+1),A
        LD   A,0xFF
        LD   (w3d_uxor2+1),A
        LD   A,1
        JR   w3d_ysg
w3d_ypos:
        LD   A,16               ; ADD A,16 - one cell on
        LD   (w3d_ystep+1),A
        XOR  A
        LD   (w3d_uxor2+1),A
w3d_ysg:
        LD   (w3d_ysgn),A

        SLA  L
        LD   A,H
        ADC  A,A
        ADD  A,A
        LD   L,A
        LD   A,w3d_recip / 256
        ADC  A,0
        LD   H,A
        LD   E,(HL)
        INC  L
        LD   D,(HL)
        LD   A,E
        LD   (w3d_ya1+1),A
        LD   A,D
        LD   (w3d_ya2+1),A

        LD   A,D
        ADD  A,A
        LD   L,A
        LD   A,W3D_TY / 256
        ADC  A,0
        LD   H,A
        LD   C,(HL)
        INC  L
        LD   B,(HL)
        LD   A,E
        ADD  A,A
        LD   L,A
        LD   A,W3D_TY / 256
        ADC  A,0
        LD   H,A
        LD   A,(HL)
        INC  L
        LD   L,(HL)
        LD   H,0
        ADD  HL,BC
        LD   B,A
        LD   A,(w3d_ysgn)
        OR   A
        JR   NZ,w3d_ydone

        LD   A,B
        OR   A
        EX   DE,HL
        JR   Z,w3d_yd1
        DEC  HL
w3d_yd1:
        SBC  HL,DE
w3d_ydone:

;------------------------------------------------------------------
; the DDA. HL is the distance to the next vertical grid line, DE to
; the next horizontal one, BC the cell the ray is in.
;------------------------------------------------------------------

        EX   DE,HL              ; DE = the y distance
        LD   HL,(w3d_sdx)
        LD   BC,(w3d_c0)
w3d_dda:
        LD   A,H                ; whichever grid line is nearer
        CP   D
        JR   C,w3d_ddax
        JR   NZ,w3d_dday
        LD   A,L
        CP   E
        JR   NC,w3d_dday
w3d_ddax:
        LD   A,L
w3d_xa1:
        ADD  A,0                ; patched: the x delta distance
        LD   L,A
        LD   A,H
w3d_xa2:
        ADC  A,0
        LD   H,A
w3d_xstep:
        INC  C                  ; patched: INC C or DEC C
        LD   A,(BC)
        OR   A
        JP   Z,w3d_dda
        JP   w3d_hitx
w3d_dday:
        LD   A,E
w3d_ya1:
        ADD  A,0                ; patched: the y delta distance
        LD   E,A
        LD   A,D
w3d_ya2:
        ADC  A,0
        LD   D,A
        LD   A,C
w3d_ystep:
        ADD  A,16               ; patched: one map row either way
        LD   C,A
        LD   A,(BC)
        OR   A
        JP   Z,w3d_dda

;------------------------------------------------------------------
; a horizontal wall: the distance is the one before the last step, and
; the texture coordinate comes off the x axis
;------------------------------------------------------------------

w3d_hity:
        LD   (w3d_cell),A
        EX   DE,HL
        LD   A,(w3d_ya1+1)
        LD   C,A
        LD   A,(w3d_ya2+1)
        LD   B,A
        OR   A
        SBC  HL,BC
        PUSH HL
        LD   A,(w3d_rx+1)
        LD   C,A
        CALL w3d_umul
        LD   A,(w3d_px)
        ADD  A,E
w3d_uxor2:
        XOR  0                  ; patched: which way the wall faces
        JP   w3d_ufin

w3d_hitx:
        LD   (w3d_cell),A
        LD   A,(w3d_xa1+1)
        LD   C,A
        LD   A,(w3d_xa2+1)
        LD   B,A
        OR   A
        SBC  HL,BC
        PUSH HL
        LD   A,(w3d_ry+1)
        LD   C,A
        CALL w3d_umul
        LD   A,(w3d_py)
        ADD  A,E
w3d_uxor1:
        XOR  0

;------------------------------------------------------------------
; A is the texture coordinate, the stack holds the distance
;------------------------------------------------------------------

w3d_ufin:
        RRCA                    ; the texture is 32 wide
        RRCA
        RRCA
        AND  0x1F
        LD   (IY+2),A
        LD   A,(w3d_cell)       ; which texture
        LD   HL,w3d_pages-1
        LD   C,A
        LD   B,0
        ADD  HL,BC
        LD   A,(HL)
        LD   (IY+1),A
        POP  HL                 ; and how tall to draw it
        SRL  H
        RR   L
        SRL  H
        RR   L
        SRL  H
        RR   L
        LD   A,H
        CP   4
        JR   NC,w3d_uf2         ; further than the table goes
        ADD  A,w3d_htab / 256
        LD   H,A
        LD   A,(HL)
        OR   A
        JR   NZ,w3d_uf3
w3d_uf2:
        LD   A,1                ; never nothing at all
w3d_uf3:
        LD   (IY+0),A

        LD   HL,(w3d_rx)        ; on to the next ray
        LD   DE,(w3d_sx)
        ADD  HL,DE
        LD   (w3d_rx),HL
        LD   HL,(w3d_ry)
        LD   DE,(w3d_sy)
        ADD  HL,DE
        LD   (w3d_ry),HL
        LD   DE,3
        ADD  IY,DE
        LD   A,(w3d_cn)
        DEC  A
        LD   (w3d_cn),A
        JP   NZ,w3d_cl
        RET

;------------------------------------------------------------------
; w3d_umul - where along the wall the ray hit, as a fraction of a cell
;
; The hit point is pos + dist * ray / 16384, and dist >> 5 times
; ray >> 8 is that product to within the five bits of it anyone reads.
; Both fit in a byte - no ray in a 16 by 16 map is longer than the
; diagonal - so it is one unsigned multiply and a correction: with
; b = bu - 256 for a negative ray, a*b is a*bu less a*256, which is
; the high byte only.
;
; Entry : HL = distance, C = the ray component's high byte
; Exit  : E = the offset within the cell.  Trashes AF, BC, DE, HL.
;------------------------------------------------------------------

w3d_umul:
        LD   A,L                ; a = dist >> 5
        RLCA
        RLCA
        RLCA
        AND  7
        LD   E,A
        LD   A,H
        ADD  A,A
        ADD  A,A
        ADD  A,A
        OR   E
        LD   B,A
        CALL qsmul8             ; DE = a * bu
        BIT  7,C
        JR   Z,w3d_um1
        LD   A,D
        SUB  B
        LD   D,A
w3d_um1:
        SRA  D                  ; and the last halving of the fraction
        RR   E
        RET

;------------------------------------------------------------------
; w3d_sinlk / w3d_planelk - the table entry for angle A, into HL
;------------------------------------------------------------------

w3d_sinlk:
        ADD  A,A
        LD   L,A
        LD   A,w3d_sin / 256
        ADC  A,0
        LD   H,A
        LD   A,(HL)
        INC  L
        LD   H,(HL)
        LD   L,A
        RET

w3d_planelk:
        ADD  A,A
        LD   L,A
        LD   A,w3d_plane / 256
        ADC  A,0
        LD   H,A
        LD   A,(HL)
        INC  L
        LD   H,(HL)
        LD   L,A
        RET

;------------------------------------------------------------------
; w3d_asr6 - HL >> 6, signed
;------------------------------------------------------------------

w3d_asr6:
        LD   B,6
w3d_a61:
        SRA  H
        RR   L
        DJNZ w3d_a61
        RET

;------------------------------------------------------------------
; w3d_ftab - 256 entries of A times i at HL, by pushing a running sum
;------------------------------------------------------------------

w3d_ftab:
        LD   C,A
        LD   B,0
        LD   DE,512
        ADD  HL,DE
        DI
        LD   (w3d_sp),SP
        LD   SP,HL              ; the table fills downwards
        LD   H,C                ; from f * 255 at the top
        LD   L,0
        OR   A
        SBC  HL,BC
        XOR  A                  ; and steps by -f
        SUB  C
        LD   C,A
        SBC  A,A
        LD   B,A
        LD   A,4
w3d_ft1:
        DUP  64
        PUSH HL
        ADD  HL,BC
        EDUP
        DEC  A
        JP   NZ,w3d_ft1
        LD   SP,(w3d_sp)
        EI
        RET

;------------------------------------------------------------------
; w3d_frame - cast, draw, show
;------------------------------------------------------------------

w3d_frame:
        CALL w3d_cast
        CALL w3d_draw
        JP   w3d_flip

;------------------------------------------------------------------
; w3d_flip - swap the buffers
;------------------------------------------------------------------

w3d_flip:
        LD   A,(w3d_back)
        LD   B,A
        LD   A,(w3d_front)
        LD   (w3d_back),A
        LD   A,B
        LD   (w3d_front),A
        RET

w3d_back:       DEFB W3D_BUF0
w3d_front:      DEFB W3D_BUF1
w3d_ceil:       DEFB 0xEE
w3d_floor:      DEFB 0xFF
w3d_gp:         DEFS 2
w3d_gh:         DEFS 1
w3d_gacc:       DEFS 1
w3d_gmoved:     DEFS 1
w3d_pfn:        DEFS 1
w3d_cx:         DEFS 1
w3d_sp:         DEFS 2
w3d_pages:      DEFB w3d_tex1 / 256, w3d_tex2 / 256
w3d_px:         DEFW 0x0380     ; the camera, 8.8 in map cells
w3d_py:         DEFW 0x0380
w3d_ang:        DEFB 0
w3d_rx:         DEFS 2          ; this ray
w3d_ry:         DEFS 2
w3d_sx:         DEFS 2          ; and the step to the next one
w3d_sy:         DEFS 2
w3d_sdx:        DEFS 2
w3d_c0:         DEFS 2
w3d_cn:         DEFS 1
w3d_xsgn:       DEFS 1
w3d_ysgn:       DEFS 1
w3d_cell:       DEFS 1

w3d_cols:       DEFS 3 * W3D_COLS   ; half height, texture page, texture column

        ALIGN 256
w3d_scal:       DEFS 2 * W3D_NLAD   ; where each rung's scaler starts
