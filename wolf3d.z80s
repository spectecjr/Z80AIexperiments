;------------------------------------------------------------------
; wolf3d.z80s - a textured grid maze for the SAM Coupe
;
;   w3d_init     build the scalers, black both buffers
;   w3d_frame    cast, draw and show one frame from w3d_px/py/ang
;   w3d_cast     fill the column list by ray casting the map
;   w3d_draw     draw the column list in w3d_cols into the back buffer
;   w3d_flip     swap the buffers
;
; Half horizontal resolution, which is what makes this possible at all:
; 128 columns of two pixels, so a screen column is exactly one byte of
; a MODE 4 line, and a wall column is one byte written straight down
; the screen. The viewport is 256x144, letterboxed into 256x192.
;
; WHY THIS IS THE OPPOSITE OF room3d. That renderer never wrote a
; column, because a flat run along a row goes at 5.5 T-states a byte
; with PUSH and a column costs three times that. A textured wall has a
; different texel in every column, so there are no runs along a row to
; find - the texture forces column order, and the whole job becomes
; making a column write cheap.
;
; Measured on the emulator, per screen byte of a wall column:
;
;   an accumulator loop, stepping the texture by a fraction   72.6 T
;   an unrolled scaler with the texture steps baked in        22.8 T
;   a flat column with no texture at all                      18.4 T
;
; So the texturing costs 4 T-states a byte and the column order costs
; 13 more than a row would. That is the whole story of this file: the
; scalers exist to turn 72.6 into 22.8.
;
; THE SCALERS. w3d_scalgen writes, for each wall height on a ladder, a
; run of unrolled code that maps the 32 texels of a texture column onto
; that many screen rows:
;
;   LD A,(DE)          the next texel, once per texel rather than once
;   INC DE             per row
;   LD (HL),A          } as many times as this texel is stretched to
;   ADD HL,BC          } cover, BC being 128, one screen row
;
; and the caller points HL at the top of the column and DE at the
; texture column. At four pixels a column each row is instead
;
;   LD (HL),A          the byte, then the one beside it, and BC is a
;   INC L              row less one to make up for the INC
;   LD (HL),A
;   ADD HL,BC
;
; which is 29 T-states for two bytes against 18 for one, and doubles
; the size of the bank. The ladder is geometric rather than uniform - every
; second height while the wall is short, every eighth while it fills
; the screen - so the height error stays near 6% everywhere instead of
; being negligible near and hopeless far. That keeps the whole bank
; inside 5K; a uniform ladder to the same accuracy would need 30K.
;
; WHAT A FRAME COSTS, measured on the emulator over 96 camera poses in
; each of the three viewports the repo generates tables for. The third
; is four pixels a column rather than two: half as many rays, and a
; scaler that writes a pair of bytes a row.
;
;                    256x144        192x96          256x96
;                    128 rays, 2px  96 rays, 2px    64 rays, 4px
;   w3d_frame mean     712,596 T      453,991 T       405,333 T
;             min      583,453        396,709         349,814
;             max      780,547        482,607         428,394
;   at 6 MHz             8.4 Hz        13.2 Hz         14.8 Hz
;   held to the flyback  7.6 Hz        12.1 Hz         12.5 Hz
;
;   wall columns       362,688  51%   211,406  47%    205,693  51%
;   w3d_cast           242,138  34%   184,926  41%    127,678  32%
;   w3d_prefill        107,656  15%    57,544  13%     71,848  18%
;
;   wall bytes a frame  14,302 at      7,376 at       10,554 at
;                       25.4 T          28.7 T         19.5 T
;   T-states a ray       1,892          1,926           1,995
;   scaler bank          5,508 bytes    3,624           5,640
;   w3d_init         1,899,320 T    1,734,704       1,766,960
;
; Those are the rates the work costs. What a display shows is coarser:
; a routine that syncs to the flyback holds a frame for a whole number
; of 50ths of a second, so 8.4 Hz is really 120ms in the cheap views
; and 140ms in the dear ones. The demo/*.gif walks are timed that way,
; a frame held as long as it really costs, and the row above is what
; they come out at.
;
; The three costs divide about the same way whichever viewport it is,
; so none of them is the thing to attack on its own: the wall bytes
; are the floor for a textured wall, the prefill is the floor for
; anything at all, and the cast is what is left.
;
; Four pixels a column is the best of the three, and it is the wall
; bytes that make it so: 19.5 T-states each against 25.4, because a
; row of a column is LD (HL),A / INC L / LD (HL),A / ADD HL,BC - 29
; T-states for two bytes where the narrow one spends 18 on one - and
; the texel it writes was fetched once for both. Casting halves as
; well. What it costs is the horizontal resolution and, awkwardly,
; twice the scaler bank.
;
; That bank is what stops 256x144 at four pixels, which the arithmetic
; puts near 12.5 Hz: it would want about 9K of scaler and there are
; only 6K to be had between the screen buffers and the stack. On a
; machine that can page it in, that is the combination to build.
;
; RAM outside the two screen buffers: the scaler bank at W3D_SCAL, the
; two 512-byte tables w3d_txtab and W3D_TY that w3d_cast rebuilds every
; frame, and qsmul8's own 1K of quarter squares, which this file needs
; but does not contain - assemble mul8x8_qs.z80s alongside it. Four
; pixel columns double the scaler bank, so it is the thing that decides
; whether a viewport fits: 5,640 bytes for 256x96 at four pixels.
;
; Written by Claude (Opus) for the Z80AIexperiments repo.
;------------------------------------------------------------------

; The viewport - W3D_TOP, W3D_VH, W3D_HALF, W3D_XOFF, how many rays
; W3D_COLS, how many bytes wide a column W3D_BPC and a row W3D_BYTES -
; comes from wolfview.z80s, generated with the ray step and height
; tables that have to agree with it. Assemble that first. Everything
; below is the same code whatever it says.

W3D_TEX:        EQU 32          ; textures are 32 wide by 32 tall
W3D_BUF0:       EQU 0x80
W3D_BUF1:       EQU 0x20
W3D_SCAL:       EQU 0xE000      ; the scaler bank lives up here
W3D_TY:         EQU 0xFC00      ; one per-frame product table up here,
                                ; the other is w3d_txtab, down with the
                                ; code where there is room for it

;------------------------------------------------------------------
; w3d_init - black both buffers and build the scaler bank
;------------------------------------------------------------------

w3d_init:
        LD   A,W3D_BUF0
        LD   (w3d_back),A
        LD   A,W3D_BUF1
        LD   (w3d_front),A
        LD   H,W3D_BUF0
        CALL w3d_black
        LD   H,W3D_BUF1
        CALL w3d_black
        ; fall through into the generator

;------------------------------------------------------------------
; w3d_scalgen - write the unrolled scalers, one per ladder height
;
; For a wall H screen rows tall the texel for row k is (k*32)/H, which
; is walked with a Bresenham accumulator rather than a division, and
; the texture pointer only moves when the texel changes.
;------------------------------------------------------------------

w3d_scalgen:
        LD   HL,W3D_SCAL
        LD   (w3d_gp),HL
        LD   IX,w3d_ladder
        LD   IY,w3d_scal
        LD   B,W3D_NLAD
w3d_sg1:
        PUSH BC
        LD   HL,(w3d_gp)    ; this height's scaler starts here
        LD   (IY+0),L
        LD   (IY+1),H
        INC  IY
        INC  IY
        LD   A,(IX+0)       ; H, the drawn height
        LD   (w3d_gh),A
        INC  IX

        LD   (HL),0x1A      ; LD A,(DE)   - the first texel
        INC  HL
        XOR  A
        LD   (w3d_gacc),A   ; the Bresenham accumulator
        LD   (w3d_gmoved),A
        LD   A,(w3d_gh)
        LD   B,A
w3d_sg2:
        LD   (HL),0x77      ; LD (HL),A   - this row, with the texel the
        INC  HL             ; accumulator has reached so far
        IF W3D_BPC = 2
        LD   (HL),0x2C      ; INC L       - and the byte beside it, for
        INC  HL             ; a four pixel column
        LD   (HL),0x77      ; LD (HL),A
        INC  HL
        ENDIF
        LD   (HL),0x09      ; ADD HL,BC   - one row down, BC being one
        INC  HL             ; row less whatever the writes advanced

        LD   A,(w3d_gacc)   ; then acc += 32, stepping the texel while it
        ADD  A,W3D_TEX      ; overflows the height, ready for the next row
        LD   C,A
        LD   A,0
        ADC  A,0
        LD   D,A            ; D:C = acc
        LD   A,(w3d_gh)
        LD   E,A
w3d_sg3:
        LD   A,D            ; while acc >= H
        OR   A
        JR   NZ,w3d_sg4
        LD   A,C
        CP   E
        JR   C,w3d_sg5
w3d_sg4:
        LD   A,C
        SUB  E
        LD   C,A
        LD   A,D
        SBC  A,0
        LD   D,A
        LD   (HL),0x13      ; INC DE      - on to the next texel
        INC  HL
        LD   A,1
        LD   (w3d_gmoved),A
        JR   w3d_sg3
w3d_sg5:
        LD   A,C
        LD   (w3d_gacc),A
        LD   A,(w3d_gmoved) ; and reload it if it moved
        OR   A
        JR   Z,w3d_sg6
        XOR  A
        LD   (w3d_gmoved),A
        LD   (HL),0x1A      ; LD A,(DE)
        INC  HL
w3d_sg6:
        DJNZ w3d_sg2

        LD   (HL),0xC9      ; RET
        INC  HL
        LD   (w3d_gp),HL
        POP  BC
        DJNZ w3d_sg1
        RET

;------------------------------------------------------------------
; w3d_black - 0x6000 bytes from H:00
;------------------------------------------------------------------

w3d_black:
        LD   L,0
        LD   D,0x60
w3d_bl1:
        LD   B,0
w3d_bl2:
        LD   (HL),0
        INC  HL
        DJNZ w3d_bl2
        DEC  D
        JR   NZ,w3d_bl1
        RET

        MACRO W3DSKIP       ; from the start of one row to the end of
        IF 128 - W3D_BYTES  ; the one above, when there is a border
        LD   HL,W3D_BYTES - 128
        ADD  HL,SP
        LD   SP,HL
        ENDIF
        ENDM

;------------------------------------------------------------------
; w3d_prefill - ceiling over the top half of the viewport, floor over
; the bottom, off the stack pointer at 5.5 T-states a byte
;
; Every wall column is written over the top of this. Filling the lot
; and overdrawing is cheaper than working out what the walls will not
; cover, because a byte written along a row costs a third of one
; written down a column.
;------------------------------------------------------------------

w3d_prefill:
        DI
        LD   (w3d_sp),SP
        LD   A,(w3d_back)
        LD   H,A
        LD   L,0
        LD   DE,(W3D_TOP + W3D_HALF - 1) * 128 + W3D_XOFF + W3D_BYTES
        ADD  HL,DE          ; one past the last ceiling byte
        LD   SP,HL
        LD   A,(w3d_ceil)
        LD   B,A
        LD   C,A
        LD   A,W3D_HALF
        LD   (w3d_pfn),A
w3d_pf1:
        DUP  W3D_BYTES / 2
        PUSH BC
        EDUP
        W3DSKIP
        LD   A,(w3d_pfn)
        DEC  A
        LD   (w3d_pfn),A
        JR   NZ,w3d_pf1

        LD   A,(w3d_back)
        LD   H,A
        LD   L,0
        LD   DE,(W3D_TOP + W3D_VH - 1) * 128 + W3D_XOFF + W3D_BYTES
        ADD  HL,DE          ; one past the last floor byte
        LD   SP,HL
        LD   A,(w3d_floor)
        LD   B,A
        LD   C,A
        LD   A,W3D_HALF
        LD   (w3d_pfn),A
w3d_pf2:
        DUP  W3D_BYTES / 2
        PUSH BC
        EDUP
        W3DSKIP
        LD   A,(w3d_pfn)
        DEC  A
        LD   (w3d_pfn),A
        JR   NZ,w3d_pf2

        LD   SP,(w3d_sp)
        EI
        RET

;------------------------------------------------------------------
; w3d_draw - the whole viewport from the column list
;
; w3d_cols holds three bytes a column: the wall half height, which
; texture, and which column of it. A half height of zero leaves the
; column as ceiling and floor.
;------------------------------------------------------------------

w3d_draw:
        CALL w3d_prefill
        LD   IX,w3d_cols
        LD   A,W3D_XOFF
        LD   (w3d_cx),A
w3d_dr1:
        LD   A,(IX+0)       ; the half height
        OR   A
        JP   Z,w3d_dr2

        LD   L,A            ; the ladder rung for it
        LD   H,w3d_hidx / 256
        LD   A,(HL)
        ADD  A,A
        LD   L,A
        LD   H,w3d_scal / 256
        LD   E,(HL)
        INC  L
        LD   D,(HL)
        LD   (w3d_call+1),DE    ; the scaler to run

        SRL  L              ; where its top is, which the rung knows:
        SET  7,L            ; the hidx page again, half of it up
        LD   H,w3d_hidx / 256
        LD   A,(HL)
        SRL  A              ; and a row is half a page, so the address
        LD   L,0            ; is (row >> 1) pages on and (row & 1) half
        RR   L              ; pages in - no multiply
        LD   H,A
        LD   A,(w3d_back)
        ADD  A,H
        LD   H,A
        LD   A,(w3d_cx)
        ADD  A,L
        LD   L,A            ; HL -> the top of this column

        LD   A,(IX+2)       ; the texture column: base + u * 32, which
        RRCA                ; needs sixteen bits - u reaches 31, so the
        RRCA                ; product reaches 992
        RRCA
        LD   E,A
        AND  0x1F
        LD   D,A
        LD   A,E
        AND  0xE0
        LD   E,A
        LD   A,(IX+1)
        ADD  A,D
        LD   D,A
        LD   BC,129 - W3D_BPC
w3d_call:
        CALL 0              ; patched: the scaler for this height
w3d_dr2:
        LD   BC,3
        ADD  IX,BC
        LD   A,(w3d_cx)
        ADD  A,W3D_BPC
        LD   (w3d_cx),A
        CP   W3D_XOFF + W3D_BYTES
        JP   C,w3d_dr1
        RET

;------------------------------------------------------------------
; w3d_cast - one ray a screen column, into the column list
;
; Lodev's DDA: step to whichever grid line comes next, in x or in y,
; until the cell stepped into is solid. Everything inside the loop is
; an add and a compare. The two things that would otherwise be a
; division and a multiply are a table each:
;
;   w3d_recip   the distance along the ray between one grid line and
;               the next, from the ray component - built once, ever
;
;   W3D_TX/TY   the camera's position inside its own cell times i, for
;               i = 0..255 - built once a frame, because the position
;               is the same for every ray in the frame, and read twice
;               a ray to get the distance to the first grid line
;
; The second one is the interesting one. It wants (f * dd) >> 8 with f
; a byte and dd sixteen bits, which is two multiplies; but f is fixed
; for the whole frame, so a table of f*i answers both halves:
;
;   f * dd = 256 * T[dd >> 8] + T[dd & 255]
;
; and the table is built by pushing a running sum onto the stack, 22
; T-states an entry. Two of them cost 11,000 T-states a frame and save
; four quarter-square multiplies a ray, which would be 76,000.
;
; The map is 16 by 16 page aligned, one byte a cell, so the map pointer
; is a whole cell step at INC C or ADD A,16 and the cell is LD A,(BC)
; at seven T-states. That is why BC is the map pointer and the two
; delta distances are patched into the loop as immediates instead.
;
; The map must have a solid border: nothing bounds checks, and a ray
; that escaped would wrap around the page rather than stop.
;
; Entry : (w3d_px), (w3d_py) the camera, 8.8 in map cells
;         (w3d_ang) the heading, 0..255
; Exit  : w3d_cols filled, three bytes a column
; Needs : qsmul8 from mul8x8_qs.z80s, for the texture coordinate
;------------------------------------------------------------------

w3d_cast:
        LD   A,(w3d_ang)        ; the step from one ray to the next is
        CALL w3d_pstplk         ; the camera plane over half the rays,
        EX   DE,HL              ; which is a table rather than a shift
        LD   HL,0               ; because half the rays need not be a
        OR   A                  ; power of two
        SBC  HL,DE
        LD   (w3d_sx),HL        ; sx = -PSTEP[ang]
        LD   C,W3D_HALFC
        CALL w3d_mulc
        EX   DE,HL
        LD   A,(w3d_ang)
        ADD  A,64
        CALL w3d_sinlk
        OR   A
        SBC  HL,DE              ; and the sweep starts half of them out
        LD   (w3d_rx),HL        ; from the direction, so it is centred

        LD   A,(w3d_ang)
        ADD  A,64
        CALL w3d_pstplk
        LD   (w3d_sy),HL        ; sy = PSTEP[ang + 64]
        LD   C,W3D_HALFC
        CALL w3d_mulc
        EX   DE,HL
        LD   A,(w3d_ang)
        CALL w3d_sinlk
        OR   A
        SBC  HL,DE
        LD   (w3d_ry),HL

        LD   A,(w3d_px)         ; where the camera sits inside its cell
        LD   HL,w3d_txtab
        CALL w3d_ftab
        LD   A,(w3d_py)
        LD   HL,W3D_TY
        CALL w3d_ftab

        LD   A,(w3d_py+1)       ; and which cell that is
        ADD  A,A
        ADD  A,A
        ADD  A,A
        ADD  A,A
        LD   C,A
        LD   A,(w3d_px+1)
        ADD  A,C
        LD   (w3d_c0),A
        LD   A,w3d_map / 256
        LD   (w3d_c0+1),A

        LD   IY,w3d_cols
        LD   A,W3D_COLS
        LD   (w3d_cn),A

;------------------------------------------------------------------
; one ray: the x axis first - which way it steps, how far to the first
; vertical grid line, and the delta distance patched into the loop
;------------------------------------------------------------------

w3d_cl:
        LD   HL,(w3d_rx)
        LD   A,H
        OR   A
        JP   P,w3d_xpos
        XOR  A                  ; |rx|
        SUB  L
        LD   L,A
        SBC  A,A
        SUB  H
        LD   H,A
        LD   A,0x0D             ; DEC C - one cell left
        LD   (w3d_xstep),A
        XOR  A                  ; and no flip of the texture across it
        LD   (w3d_uxor1+1),A
        INC  A
        JR   w3d_xsg
w3d_xpos:
        LD   A,0x0C             ; INC C - one cell right
        LD   (w3d_xstep),A
        LD   A,0xFF
        LD   (w3d_uxor1+1),A
        XOR  A
w3d_xsg:
        LD   (w3d_xsgn),A

        SLA  L                  ; i = |rx| >> 7, the reciprocal index
        LD   A,H
        ADC  A,A
        ADD  A,A                ; DE = w3d_recip[i] = the delta distance
        LD   L,A
        LD   A,w3d_recip / 256
        ADC  A,0
        LD   H,A
        LD   E,(HL)
        INC  L
        LD   D,(HL)
        LD   A,E                ; which the DDA adds as an immediate
        LD   (w3d_xa1+1),A
        LD   A,D
        LD   (w3d_xa2+1),A

        LD   A,D                ; n = (f * ddx) >> 8, out of the table
        ADD  A,A                ;   = TX[ddx >> 8] + high(TX[ddx & 255])
        LD   L,A
        LD   A,w3d_txtab / 256
        ADC  A,0
        LD   H,A
        LD   C,(HL)
        INC  L
        LD   B,(HL)
        LD   A,E
        ADD  A,A
        LD   L,A
        LD   A,w3d_txtab / 256
        ADC  A,0
        LD   H,A
        LD   A,(HL)             ; the low byte only decides a rounding
        INC  L
        LD   L,(HL)
        LD   H,0
        ADD  HL,BC              ; HL = n
        LD   B,A                ; B = the low byte
        LD   A,(w3d_xsgn)
        OR   A
        JR   NZ,w3d_xdone       ; stepping left: the distance is n

        LD   A,B                ; stepping right: it is the rest of the
        OR   A                  ; cell, ddx - ceil(n), which the low
        EX   DE,HL              ; byte says whether to round up
        JR   Z,w3d_xd1
        DEC  HL
w3d_xd1:
        SBC  HL,DE
w3d_xdone:
        LD   (w3d_sdx),HL

;------------------------------------------------------------------
; the y axis, the same again
;------------------------------------------------------------------

        LD   HL,(w3d_ry)
        LD   A,H
        OR   A
        JP   P,w3d_ypos
        XOR  A
        SUB  L
        LD   L,A
        SBC  A,A
        SUB  H
        LD   H,A
        LD   A,-16              ; ADD A,-16 - one cell back
        LD   (w3d_ystep+1),A
        LD   A,0xFF
        LD   (w3d_uxor2+1),A
        LD   A,1
        JR   w3d_ysg
w3d_ypos:
        LD   A,16               ; ADD A,16 - one cell on
        LD   (w3d_ystep+1),A
        XOR  A
        LD   (w3d_uxor2+1),A
w3d_ysg:
        LD   (w3d_ysgn),A

        SLA  L
        LD   A,H
        ADC  A,A
        ADD  A,A
        LD   L,A
        LD   A,w3d_recip / 256
        ADC  A,0
        LD   H,A
        LD   E,(HL)
        INC  L
        LD   D,(HL)
        LD   A,E
        LD   (w3d_ya1+1),A
        LD   A,D
        LD   (w3d_ya2+1),A

        LD   A,D
        ADD  A,A
        LD   L,A
        LD   A,W3D_TY / 256
        ADC  A,0
        LD   H,A
        LD   C,(HL)
        INC  L
        LD   B,(HL)
        LD   A,E
        ADD  A,A
        LD   L,A
        LD   A,W3D_TY / 256
        ADC  A,0
        LD   H,A
        LD   A,(HL)
        INC  L
        LD   L,(HL)
        LD   H,0
        ADD  HL,BC
        LD   B,A
        LD   A,(w3d_ysgn)
        OR   A
        JR   NZ,w3d_ydone

        LD   A,B
        OR   A
        EX   DE,HL
        JR   Z,w3d_yd1
        DEC  HL
w3d_yd1:
        SBC  HL,DE
w3d_ydone:

;------------------------------------------------------------------
; the DDA. HL is the distance to the next vertical grid line, DE to
; the next horizontal one, BC the cell the ray is in.
;------------------------------------------------------------------

        EX   DE,HL              ; DE = the y distance
        LD   HL,(w3d_sdx)
        LD   BC,(w3d_c0)
w3d_dda:
        LD   A,H                ; whichever grid line is nearer
        CP   D
        JR   C,w3d_ddax
        JR   NZ,w3d_dday
        LD   A,L
        CP   E
        JR   NC,w3d_dday
w3d_ddax:
        LD   A,L
w3d_xa1:
        ADD  A,0                ; patched: the x delta distance
        LD   L,A
        LD   A,H
w3d_xa2:
        ADC  A,0
        LD   H,A
w3d_xstep:
        INC  C                  ; patched: INC C or DEC C
        LD   A,(BC)
        OR   A
        JP   Z,w3d_dda
        JP   w3d_hitx
w3d_dday:
        LD   A,E
w3d_ya1:
        ADD  A,0                ; patched: the y delta distance
        LD   E,A
        LD   A,D
w3d_ya2:
        ADC  A,0
        LD   D,A
        LD   A,C
w3d_ystep:
        ADD  A,16               ; patched: one map row either way
        LD   C,A
        LD   A,(BC)
        OR   A
        JP   Z,w3d_dda

;------------------------------------------------------------------
; a horizontal wall: the distance is the one before the last step, and
; the texture coordinate comes off the x axis
;------------------------------------------------------------------

w3d_hity:
        LD   (w3d_cell),A
        EX   DE,HL
        LD   A,(w3d_ya1+1)
        LD   C,A
        LD   A,(w3d_ya2+1)
        LD   B,A
        OR   A
        SBC  HL,BC
        PUSH HL
        LD   A,(w3d_rx+1)
        LD   C,A
        CALL w3d_umul
        LD   A,(w3d_px)
        ADD  A,E
w3d_uxor2:
        XOR  0                  ; patched: which way the wall faces
        JP   w3d_ufin

w3d_hitx:
        LD   (w3d_cell),A
        LD   A,(w3d_xa1+1)
        LD   C,A
        LD   A,(w3d_xa2+1)
        LD   B,A
        OR   A
        SBC  HL,BC
        PUSH HL
        LD   A,(w3d_ry+1)
        LD   C,A
        CALL w3d_umul
        LD   A,(w3d_py)
        ADD  A,E
w3d_uxor1:
        XOR  0

;------------------------------------------------------------------
; A is the texture coordinate, the stack holds the distance
;------------------------------------------------------------------

w3d_ufin:
        RRCA                    ; the texture is 32 wide
        RRCA
        RRCA
        AND  0x1F
        LD   (IY+2),A
        LD   A,(w3d_cell)       ; which texture
        LD   HL,w3d_pages-1
        LD   C,A
        LD   B,0
        ADD  HL,BC
        LD   A,(HL)
        LD   (IY+1),A
        POP  HL                 ; and how tall to draw it
        SRL  H
        RR   L
        SRL  H
        RR   L
        SRL  H
        RR   L
        LD   A,H
        CP   4
        JR   NC,w3d_uf2         ; further than the table goes
        ADD  A,w3d_htab / 256
        LD   H,A
        LD   A,(HL)
        OR   A
        JR   NZ,w3d_uf3
w3d_uf2:
        LD   A,1                ; never nothing at all
w3d_uf3:
        LD   (IY+0),A

        LD   HL,(w3d_rx)        ; on to the next ray
        LD   DE,(w3d_sx)
        ADD  HL,DE
        LD   (w3d_rx),HL
        LD   HL,(w3d_ry)
        LD   DE,(w3d_sy)
        ADD  HL,DE
        LD   (w3d_ry),HL
        LD   DE,3
        ADD  IY,DE
        LD   A,(w3d_cn)
        DEC  A
        LD   (w3d_cn),A
        JP   NZ,w3d_cl
        RET

;------------------------------------------------------------------
; w3d_umul - where along the wall the ray hit, as a fraction of a cell
;
; The hit point is pos + dist * ray / 16384, and dist >> 5 times
; ray >> 8 is that product to within the five bits of it anyone reads.
; Both fit in a byte - no ray in a 16 by 16 map is longer than the
; diagonal - so it is one unsigned multiply and a correction: with
; b = bu - 256 for a negative ray, a*b is a*bu less a*256, which is
; the high byte only.
;
; Entry : HL = distance, C = the ray component's high byte
; Exit  : E = the offset within the cell.  Trashes AF, BC, DE, HL.
;------------------------------------------------------------------

w3d_umul:
        LD   A,L                ; a = dist >> 5
        RLCA
        RLCA
        RLCA
        AND  7
        LD   E,A
        LD   A,H
        ADD  A,A
        ADD  A,A
        ADD  A,A
        OR   E
        LD   B,A
        CALL qsmul8             ; DE = a * bu
        BIT  7,C
        JR   Z,w3d_um1
        LD   A,D
        SUB  B
        LD   D,A
w3d_um1:
        SRA  D                  ; and the last halving of the fraction
        RR   E
        RET

;------------------------------------------------------------------
; w3d_sinlk / w3d_planelk - the table entry for angle A, into HL
;------------------------------------------------------------------

w3d_sinlk:
        ADD  A,A
        LD   L,A
        LD   A,w3d_sin / 256
        ADC  A,0
        LD   H,A
        LD   A,(HL)
        INC  L
        LD   H,(HL)
        LD   L,A
        RET

w3d_pstplk:
        ADD  A,A
        LD   L,A
        LD   A,w3d_pstep / 256
        ADC  A,0
        LD   H,A
        LD   A,(HL)
        INC  L
        LD   H,(HL)
        LD   L,A
        RET

;------------------------------------------------------------------
; w3d_mulc - HL = HL * C, twice a frame, so a shift and add will do
;------------------------------------------------------------------

w3d_mulc:
        LD   D,H
        LD   E,L
        LD   HL,0
        LD   B,8
w3d_mc1:
        ADD  HL,HL
        SLA  C
        JR   NC,w3d_mc2
        ADD  HL,DE
w3d_mc2:
        DJNZ w3d_mc1
        RET

;------------------------------------------------------------------
; w3d_ftab - 256 entries of A times i at HL, by pushing a running sum
;------------------------------------------------------------------

w3d_ftab:
        LD   C,A
        LD   B,0
        LD   DE,512
        ADD  HL,DE
        DI
        LD   (w3d_sp),SP
        LD   SP,HL              ; the table fills downwards
        LD   H,C                ; from f * 255 at the top
        LD   L,0
        OR   A
        SBC  HL,BC
        XOR  A                  ; and steps by -f
        SUB  C
        LD   C,A
        SBC  A,A
        LD   B,A
        LD   A,4
w3d_ft1:
        DUP  64
        PUSH HL
        ADD  HL,BC
        EDUP
        DEC  A
        JP   NZ,w3d_ft1
        LD   SP,(w3d_sp)
        EI
        RET

;------------------------------------------------------------------
; w3d_frame - cast, draw, show
;------------------------------------------------------------------

w3d_frame:
        CALL w3d_cast
        CALL w3d_draw
        JP   w3d_flip

;------------------------------------------------------------------
; w3d_flip - swap the buffers
;------------------------------------------------------------------

w3d_flip:
        LD   A,(w3d_back)
        LD   B,A
        LD   A,(w3d_front)
        LD   (w3d_back),A
        LD   A,B
        LD   (w3d_front),A
        RET

w3d_back:       DEFB W3D_BUF0
w3d_front:      DEFB W3D_BUF1
w3d_ceil:       DEFB 0xEE
w3d_floor:      DEFB 0xFF
w3d_gp:         DEFS 2
w3d_gh:         DEFS 1
w3d_gacc:       DEFS 1
w3d_gmoved:     DEFS 1
w3d_pfn:        DEFS 1
w3d_cx:         DEFS 1
w3d_sp:         DEFS 2
w3d_pages:      DEFB w3d_tex1 / 256, w3d_tex2 / 256
w3d_px:         DEFW 0x0380     ; the camera, 8.8 in map cells
w3d_py:         DEFW 0x0380
w3d_ang:        DEFB 0
w3d_rx:         DEFS 2          ; this ray
w3d_ry:         DEFS 2
w3d_sx:         DEFS 2          ; and the step to the next one
w3d_sy:         DEFS 2
w3d_sdx:        DEFS 2
w3d_c0:         DEFS 2
w3d_cn:         DEFS 1
w3d_xsgn:       DEFS 1
w3d_ysgn:       DEFS 1
w3d_cell:       DEFS 1

w3d_cols:       DEFS 3 * W3D_COLS   ; half height, texture page, texture column

        ALIGN 256
w3d_scal:       DEFS 2 * W3D_NLAD   ; where each rung's scaler starts

        ALIGN 256
w3d_txtab:      DEFS 512            ; f * i for the camera's x, rebuilt
                                    ; every frame by w3d_ftab
