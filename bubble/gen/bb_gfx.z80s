; ---- sprite descriptors --------------------------------------
;
; S_DRAW  is the general (masked) routine, always present.
; S_FILL  is the opaque stack-blitted routine, or 0 for a hollow
;         sprite. bb_draw_one uses it whenever the object's box is
;         entirely over plain backdrop.
SPR_BUBBLE      EQU 0
SPR_PLAYER      EQU 1
SPR_ENEMY       EQU 2
SPR_FRUIT       EQU 3
bb_sprite_table:
                DEFB 8, 16, 0, 0
                DEFW bb_spr_bubble, 0
                DEFB 8, 16, 0, 0
                DEFW bb_spr_player, bb_spro_player
                DEFB 8, 16, 0, 0
                DEFW bb_spr_enemy, bb_spro_enemy
                DEFB 8, 16, 0, 0
                DEFW bb_spr_fruit, bb_spro_fruit

; ---- bb_spr_bubble: masked, 577 accesses per draw
bb_spr_bubble:
                LD   C,$CC      ; [2a] most common solid byte
                LD   B,$C7      ; [2a] second most common
                INC  HL         ; [1a] row 0 skip
                INC  HL         ; [1a]
                INC  HL         ; [1a]
                LD   A,(HL)     ; [2a]
                AND  $F0        ; [2a]
                OR   $0C        ; [2a]
                LD   (HL),A     ; [2a]
                INC  HL         ; [1a]
                LD   A,(HL)     ; [2a]
                AND  $0F        ; [2a]
                OR   $C0        ; [2a]
