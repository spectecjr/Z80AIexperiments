                PUSH DE         ; [3a]
                LD   DE,$DD00   ; [3a]
                PUSH DE         ; [3a]
                ADD  HL,BC      ; [1a]
                LD   SP,(bb_savesp) ; [6a]
                RET             ; [3a]

