;------------------------------------------------------------------
; bb_flow.z80s - the bubble wind current
;
; In the arcade, bubbles rise and then ride a per-level wind current
; around the playfield; that is what makes them queue along ceilings and
; pour down the far wall. The arcade ships authored wind data. We derive
; it from the 96-byte level bitmap instead, with a purely local rule -
; no tracing, no flood fill, no extra level data.
;
; For each open cell, with U/R/D/L = "that neighbour is solid", the
; first matching rule wins:
;
;   1. U and not R  ->  RIGHT   slide along the underside of a ceiling
;   2. R and not D  ->  DOWN    run down the face of a wall
;   3. D and not L  ->  LEFT    slide along the top of a platform
;   4. L and not U  ->  UP      climb the far face of a wall
;   5. otherwise    ->  UP      plain buoyancy, feeds the ceiling stream
;
; On a plain box room that produces a clean clockwise circulation, and
; every corner resolves correctly because a rule that would turn into a
; wall is skipped by its "and not" clause. Interior platforms fall out
; for free: a bubble slides along the underside until the cell above it
; opens up, then rule 5 lifts it back into the main stream.
;
; bb_flow_sense mirrors rules 1..4 to give an anticlockwise level.
;
; Cost: ~130a per cell x 768 = ~100,000 accesses, once per level.
;------------------------------------------------------------------

bb_build_flow:
                LD   HL,bb_flowfield            ; [10T / 3a]
                LD   (bb_fl_dst),HL             ; [16T / 5a]
                XOR  A                          ; [4T / 1a]
                LD   (bb_fl_cy),A               ; [13T / 4a]

bb_fl_rowloop:
                XOR  A                          ; [4T / 1a]
                LD   (bb_fl_cx),A               ; [13T / 4a]
bb_fl_colloop:
                LD   A,(bb_fl_cy)               ; [13T / 4a]
                LD   B,A                        ; [4T / 1a]
                LD   A,(bb_fl_cx)               ; [13T / 4a]
                LD   C,A                        ; [4T / 1a]

                ; Solid cells carry no current at all.
                CALL bb_cell_solid              ; [17T / 5a]
                LD   A,DIR_NONE                 ; [7T / 2a]  flag-preserving
                JP   NZ,bb_fl_store             ; [10T / 3a]

                ; Gather the four neighbours into D as %0000 URDL.
                CALL bb_neighbours              ; [17T / 5a]

                ; rule 1: U and not R -> RIGHT
                LD   A,D                        ; [4T / 1a]
                AND  %00001100                  ; [7T / 2a]  U | R
                CP   %00001000                  ; [7T / 2a]  U only
                LD   A,DIR_R                    ; [7T / 2a]
                JR   Z,bb_fl_sense              ; [12T / 2a]

                ; rule 2: R and not D -> DOWN
                LD   A,D                        ; [4T / 1a]
                AND  %00000110                  ; [7T / 2a]  R | D
                CP   %00000100                  ; [7T / 2a]  R only
                LD   A,DIR_D                    ; [7T / 2a]
                JR   Z,bb_fl_sense              ; [12T / 2a]

                ; rule 3: D and not L -> LEFT
                LD   A,D                        ; [4T / 1a]
                AND  %00000011                  ; [7T / 2a]  D | L
                CP   %00000010                  ; [7T / 2a]  D only
                LD   A,DIR_L                    ; [7T / 2a]
                JR   Z,bb_fl_sense              ; [12T / 2a]

                ; rules 4 and 5 both give UP
                LD   A,DIR_U                    ; [7T / 2a]

bb_fl_sense:
                ; Optional mirror: swap LEFT<->RIGHT, UP<->DOWN, which
                ; turns the clockwise loop anticlockwise.
                LD   B,A                        ; [4T / 1a]
                LD   A,(bb_flow_sense)          ; [13T / 4a]
                OR   A                          ; [4T / 1a]
                LD   A,B                        ; [4T / 1a]
                JR   Z,bb_fl_store              ; [12T / 2a]
                ADD  A,4                        ; [7T / 2a]  rotate half a turn
                AND  7                          ; [7T / 2a]

bb_fl_store:
                LD   HL,(bb_fl_dst)             ; [16T / 5a]
                LD   (HL),A                     ; [7T / 2a]
                INC  HL                         ; [6T / 1a]
                LD   (bb_fl_dst),HL             ; [16T / 5a]

                LD   HL,bb_fl_cx                ; [10T / 3a]
                INC  (HL)                       ; [11T / 3a]
                LD   A,(HL)                     ; [7T / 2a]
                CP   MAP_W                      ; [7T / 2a]
                JR   C,bb_fl_colloop            ; [12T / 2a]

                LD   HL,bb_fl_cy                ; [10T / 3a]
                INC  (HL)                       ; [11T / 3a]
                LD   A,(HL)                     ; [7T / 2a]
                CP   MAP_H                      ; [7T / 2a]
                JR   C,bb_fl_rowloop            ; [12T / 2a]
                RET                             ; [10T / 3a]

; ---- bb_neighbours ----------------------------------------------
;
; Entry : B = cy, C = cx
; Exit  : D = %0000URDL, one bit per solid neighbour; B, C preserved
; Trash : AF, E, HL
; Cost  : [~500T / 130a]

bb_neighbours:
                LD   E,0                        ; [7T / 2a]
                DEC  B                          ; [4T / 1a]   up
                CALL bb_nb_probe                ; [17T / 5a]
                INC  B                          ; [4T / 1a]
                INC  C                          ; [4T / 1a]   right
                CALL bb_nb_probe                ; [17T / 5a]
                DEC  C                          ; [4T / 1a]
                INC  B                          ; [4T / 1a]   down
                CALL bb_nb_probe                ; [17T / 5a]
                DEC  B                          ; [4T / 1a]
                DEC  C                          ; [4T / 1a]   left
                CALL bb_nb_probe                ; [17T / 5a]
                INC  C                          ; [4T / 1a]
                LD   D,E                        ; [4T / 1a]
                RET                             ; [10T / 3a]

bb_nb_probe:
                PUSH BC                         ; [11T / 3a]
                PUSH DE                         ; [11T / 3a]
                CALL bb_cell_solid              ; [17T / 5a]
                LD   A,0                        ; [7T / 2a]   preserves flags
                JR   Z,bb_nb_open               ; [12T / 2a]
                INC  A                          ; [4T / 1a]
bb_nb_open:
                POP  DE                         ; [10T / 3a]
                SLA  E                          ; [8T / 2a]
                OR   E                          ; [4T / 1a]
                LD   E,A                        ; [4T / 1a]
                POP  BC                         ; [10T / 3a]
                RET                             ; [10T / 3a]

bb_fl_cx:       DEFB 0
bb_fl_cy:       DEFB 0
bb_fl_dst:      DEFW 0
bb_flow_sense:  DEFB 0          ; 0 = clockwise, 1 = anticlockwise
