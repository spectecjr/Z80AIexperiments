;------------------------------------------------------------------
; shakudata.z80s - generated by tests/mkshakudata.py, do not edit
;
; The notes the flute has, the envelope, the vibrato and the phrase.
;------------------------------------------------------------------

SK_ENVLEN:      EQU 32          ; rows of attack and swell
SK_RELLEN:      EQU 9           ; and of release
SK_VIBLEN:      EQU 12          ; frames a vibrato cycle: 50/12 = 4.2 Hz
SK_VIBRAMP:     EQU 48          ; frames until it is at full depth
SK_NOTES:       EQU 15           ; notes and rests in the phrase
SK_INITS:       EQU 14          ; registers sk_init sets up
SK_H2:          EQU 2           ; 2f is this much quieter than f
SK_H4:          EQU 6           ; and 4f this much
SK_REST:        EQU 255         ; a rest, in the phrase

; each note: frequency byte, the octave register pair for f and 2f,
; and the one for 4f and the breath
sk_notes:
        DEFB  85,0x43,0x65            ; D4   293.4 Hz
        DEFB 153,0x43,0x65            ; F4   349.2 Hz
        DEFB 192,0x43,0x65            ; G4   391.8 Hz
        DEFB 227,0x43,0x65            ; A4   440.1 Hz
        DEFB  33,0x54,0x66            ; C5   523.0 Hz
        DEFB  85,0x54,0x66            ; D5   586.9 Hz
        DEFB 153,0x54,0x66            ; F5   698.3 Hz

; tone level, noise level, pitch offset - by frame from the start
sk_env:
        DEFB   0,  9,253
        DEFB   2, 12,253
        DEFB   5, 13,254
        DEFB   8, 12,254
        DEFB  10, 10,255
        DEFB  11,  8,255
        DEFB  12,  7,  0
        DEFB  12,  6,  0
        DEFB  13,  6,  0
        DEFB  13,  5,  0
        DEFB  13,  5,  0
        DEFB  13,  5,  0
        DEFB  13,  5,  0
        DEFB  13,  5,  0
        DEFB  13,  5,  0
        DEFB  13,  5,  0
        DEFB  13,  5,  0
        DEFB  13,  5,  0
        DEFB  13,  5,  0
        DEFB  13,  5,  0
        DEFB  13,  5,  0
        DEFB  13,  5,  0
        DEFB  13,  5,  0
        DEFB  13,  5,  0
        DEFB  13,  5,  0
        DEFB  13,  5,  0
        DEFB  13,  5,  0
        DEFB  13,  5,  0
        DEFB  13,  5,  0
        DEFB  13,  5,  0
        DEFB  13,  5,  0
        DEFB  13,  5,  0

; and by frames remaining, at the end
sk_rel:
        DEFB  12,  5,  0
        DEFB  11,  5,  0
        DEFB   9,  4,255
        DEFB   7,  4,254
        DEFB   5,  3,253
        DEFB   3,  3,252
        DEFB   2,  2,251
        DEFB   1,  1,250
        DEFB   0,  0,  0

; the vibrato: 48 frames of it coming in, then one cycle for ever
sk_vin:
        DEFB   0,  0,  0,  0,  0,  0,  0,  0,255,255,255,255
        DEFB   0,  1,  2,  2,  2,  1,  0,255,254,253,254,255
        DEFB   0,  2,  3,  3,  3,  2,  0,254,253,252,252,254
        DEFB   0,  2,  4,  5,  4,  3,  0,253,251,250,251,253
sk_vst:
        DEFB   0,  3,  5,  6,  5,  3,  0,253,251,250,251,253

; the phrase: note, frames
sk_phrase:
        DEFB   0, 80                ; D4    1.60 s
        DEFB 255, 10                ; rest  0.20 s
        DEFB   1, 30                ; F4    0.60 s
        DEFB   2, 60                ; G4    1.20 s
        DEFB 255,  8                ; rest  0.16 s
        DEFB   3, 35                ; A4    0.70 s
        DEFB   4, 75                ; C5    1.50 s
        DEFB 255, 12                ; rest  0.24 s
        DEFB   5, 50                ; D5    1.00 s
        DEFB   4, 26                ; C5    0.52 s
        DEFB   3, 40                ; A4    0.80 s
        DEFB   2, 30                ; G4    0.60 s
        DEFB   1, 34                ; F4    0.68 s
        DEFB   0, 95                ; D4    1.90 s
        DEFB 255, 25                ; rest  0.50 s

; what sk_init sends: register, value
sk_ini:
        DEFB 0x1C,0x02
        DEFB 0x1C,0x01
        DEFB 0x14,0x07
        DEFB 0x15,0x08
        DEFB 0x16,0x30
        DEFB 0x18,0x00
        DEFB 0x19,0x00
        DEFB 0x0B,0xC6
        DEFB 0x00,0x00
        DEFB 0x01,0x00
        DEFB 0x02,0x00
        DEFB 0x03,0x00
        DEFB 0x04,0x00
        DEFB 0x05,0x00

