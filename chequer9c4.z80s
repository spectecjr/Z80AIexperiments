        XOR  17
        LD   (HL),A
        LD   A,(DE)
        DEC  DE
        AND  0x10               ; the mask again, as the offset to
        ADD  A,(chq4_val + 192) & 255       ; the complement of this run's
        EXX                     ; values
        LD   L,A
        LD   H,(chq4_val + 192) >> 8
        LD   SP,HL
        POP  BC
