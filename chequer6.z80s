;------------------------------------------------------------------
; chequer6.z80s - the board, with a pilot standing in front of it
;
;   chq6_init    the board's sky and haze, and the pilot's top half
;   chq6_frame   draw from (chq4_camx, chq4_camz), pilot and all, flip
;
; The board is chequer4's routine over chequer5's full-depth viewport,
; unchanged. What is here is the pilot: 32x96 pixels of person in a
; jetpack, back to us, in the middle of the screen and over the top of
; everything.
;
; TWO HALVES, DRAWN TWO DIFFERENT WAYS. The pilot stands on rows 48 to
; 143 and the board only redraws from row 97 down, so the top half is
; drawn once per buffer and only the 47 rows the board draws over are
; redrawn a frame. That is the whole reason it is affordable: 183 bytes
; of stream a frame rather than 565.
;
; And because nothing paints over the top half, its background is one
; constant - so it is not a stream at all but a compiled run of PUSHes
; with the sky baked into the transparent bytes and into the single
; pixel ones. 5.5 T-states a byte, no mask, and no clearing of the pose
; that was there: 3,600 T-states against 27,000.
;
; THREE POSES, and the top half follows them. Each buffer's copy of
; this code remembers which pose its top half has - which is free,
; because the paged map keeps a copy of the resident block behind each
; buffer - so changing pose costs one top half in each buffer and
; nothing at all after that.
;
; A MASK, now that there is room for one. A byte with one pixel covered
; is read, masked and written rather than stored: three times the work
; of a byte, 110 bytes of the pilot, and what it buys is an outline
; that stays one pixel wide where the silhouette does not land on a
; byte. The first version gave the odd pixel to the outline instead,
; because the board's bank had taken all but 250-odd bytes of the
; address space and there was nothing to spend.
;
; CHQ6_CITY, which the harness sets, puts chequer7's band of city in
; between the board and the pilot. Everything else about the routine is
; the same, including where the pilot's two halves divide - that comes
; from the stream data, and chequer7's is cut at the city's top row
; rather than the board's, because the city moves under the pilot.
;
; WHERE IT LIVES. In the 8K a MODE 4 screen leaves spare at the end of
; its odd page, with the board's code and both copies of the tables -
; and the board's bank is in pages of its own. See chequer5.md.
;
; Written by Claude (Opus) for the Z80AIexperiments repo.
;------------------------------------------------------------------

chq6_init:
        JP   chq4_init          ; the sky and the haze into both buffers.
                                ; The pilot's top half waits for a frame:
                                ; each buffer draws it the first time it
                                ; is drawn into, and again if the pose
                                ; changes

;------------------------------------------------------------------
; chq6_frame - one frame: the board, then the pilot over it
;------------------------------------------------------------------

chq6_frame:
        CALL chq4_msk8
        CALL chq4_floor
    IF CHQ6_CITY                ; chequer7: a band of city between the
        CALL c7_city            ; board and the sky, under the pilot
    ENDIF
        LD   A,(chq6_pose)      ; this pose's pair of streams
        ADD  A,A
        ADD  A,A
        LD   E,A
        LD   D,0
        LD   HL,jet_pose
        ADD  HL,DE
        LD   A,(chq6_seen)      ; which pose this buffer's top half has -
        LD   B,A                ; its own copy of this byte, because the
        LD   A,(chq6_pose)      ; resident block is duplicated behind each
        CP   B                  ; buffer
        JR   Z,chq6_f1
        LD   (chq6_seen),A
        PUSH HL
        LD   A,(HL)             ; the rows above are a compiled run rather
        INC  HL                 ; than a stream: nothing paints over them,
        LD   H,(HL)             ; so the sky is baked into the transparent
        LD   L,A                ; bytes and into the single pixel ones, and
        CALL chq6_jphl          ; the pose that was there needs no clearing
        POP  HL
chq6_f1:
        INC  HL
        INC  HL
        LD   E,(HL)
        INC  HL
        LD   D,(HL)
        EX   DE,HL
        LD   DE,JET_SPLIT * 128 + JET_X / 2
        CALL chq6_draw          ; and the rows the board drew over

        IN   A,(CHQ4_HMPR)      ; the flip, which is the hardware's own
        AND  31                 ; record of which buffer is which
        LD   C,A
        OR   CHQ4_MODE4
        OUT  (CHQ4_VMPR),A
        LD   A,C
        XOR  CHQ4_SCR0 ^ CHQ4_SCR1
        OUT  (CHQ4_HMPR),A
        RET

;------------------------------------------------------------------
; chq6_jphl - call the run whose address is in HL
;------------------------------------------------------------------

chq6_jphl:
        JP   (HL)

;------------------------------------------------------------------
; chq6_draw - play a stream of rows into a buffer
;
;   HL = the stream    DE = the first row's offset into the buffer
;
; ops:  0x01..0x10  skip n bytes        0x40+n  fill n with what follows
;       0x20+n      copy the n that follow      0x00  end of row
;       0x60        one pixel, the pilot's on the left, the screen keeps
;                   its right one; 0x61 the other way round
; and where a row's repeat count would be, 0 ends the stream and 0xFF
; says the stream goes on somewhere else.
;------------------------------------------------------------------

chq6_draw:
        LD   A,CHQ4_SCREEN / 256        ; the back buffer is always here
        ADD  A,D
        LD   D,A
        LD   (chq6_dst),DE

chq6_row:
        LD   A,(HL)
        INC  HL
        OR   A
        RET  Z                  ; the end of the pilot
        INC  A
        JR   Z,chq6_jump
        DEC  A
        LD   (chq6_rep),A
        LD   (chq6_ops),HL      ; where this row's ops start, for the
chq6_again:                     ; rows that repeat it
        LD   DE,(chq6_dst)

chq6_op:
        LD   A,(HL)
        INC  HL
        OR   A
        JR   Z,chq6_eor
        CP   0x60
        JR   NC,chq6_mask
        CP   0x40
        JR   NC,chq6_fill
        CP   0x20
        JR   NC,chq6_copy
        ADD  A,E                ; skip: the pilot is 16 bytes wide and
        LD   E,A                ; never crosses a page
        JR   chq6_op

chq6_copy:
        SUB  0x20
        LD   C,A
        LD   B,0
        LDIR
        JR   chq6_op

chq6_fill:
        SUB  0x40
        LD   B,A
        LD   A,(HL)
        INC  HL
chq6_fl1:
        LD   (DE),A
        INC  DE
        DJNZ chq6_fl1
        JR   chq6_op

chq6_eor:
        PUSH HL                 ; on down the screen a row
        LD   HL,(chq6_dst)
        LD   DE,128
        ADD  HL,DE
        LD   (chq6_dst),HL
        POP  HL
        LD   A,(chq6_rep)
        DEC  A
        LD   (chq6_rep),A
        JR   Z,chq6_row
        LD   HL,(chq6_ops)
        JR   chq6_again

chq6_mask:                      ; one pixel of this byte is the pilot's
        RRA                     ; and the board keeps the other
        LD   A,(DE)
        JR   C,chq6_m1
        AND  0x0F
        JR   chq6_m2
chq6_m1:
        AND  0xF0
chq6_m2:
        OR   (HL)
        INC  HL
        LD   (DE),A
        INC  DE
        JR   chq6_op

chq6_jump:
        LD   E,(HL)             ; the stream goes on somewhere else
        INC  HL
        LD   D,(HL)
        EX   DE,HL
        JR   chq6_row

chq6_dst:       DEFS 2
chq6_ops:       DEFS 2
chq6_rep:       DEFS 1
chq6_pose:      DEFB 1          ; 0 banking left, 1 level, 2 right
chq6_seen:      DEFB 255        ; and which pose this buffer's top half
                                ; has. One copy a buffer, and no pose is
                                ; 255, so each draws it once to start
