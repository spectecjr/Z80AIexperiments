; Generated by tests/mkprismdata.py - do not edit by hand.

PR_NP:          EQU 7           ; convex pieces
PR_NN:          EQU 18          ; distinct face normals
PR_TZ:          EQU 18816       ; how far away the logo sits
PR_NPAIR:       EQU 21          ; pairs of pieces to order
PR_MASK:        EQU 127         ; a bit a piece
PR_OVO:         EQU 14          ; pr_ov, from pr_fr

pr_da:          ; how fast the logo turns, an axis at a time
        DEFB 2,3,1
PR_DA:          EQU pr_da

pr_vert:        ; eight vertices a piece, in renderlit's order
        DEFB 90,57,14,90,57,242,90,38,14,90,38,242
        DEFB 250,57,14,250,57,242,250,38,14,250,38,242
        DEFB 90,217,14,90,217,242,90,198,14,90,198,242
        DEFB 250,217,14,250,217,242,250,198,14,250,198,242
        DEFB 22,38,14,22,38,242,61,0,14,61,0,242
        DEFB 250,38,14,250,38,242,32,0,14,32,0,242
        DEFB 61,0,14,61,0,242,22,217,14,22,217,242
        DEFB 32,0,14,32,0,242,250,217,14,250,217,242
        DEFB 166,48,14,166,48,242,244,0,14,244,0,242
        DEFB 178,26,14,178,26,242,221,0,14,221,0,242
        DEFB 244,0,14,244,0,242,166,208,14,166,208,242
        DEFB 221,0,14,221,0,242,178,229,14,178,229,242
        DEFB 166,208,14,166,208,242,166,48,14,166,48,242
        DEFB 178,229,14,178,229,242,178,26,14,178,26,242

pr_base:        ; and which ramp each piece wears
        DEFB 0,0,0,0,8,8,8

pr_pair:        ; every pair of pieces, and a face of the
                ; first whose plane has the second wholly
                ; outside it - which settles their order.
                ; Where its offset is, where pr_light will
                ; leave that normal's N.T, then the two
        DEFW pr_face + 10, pr_nsh + 10
        DEFB 0, 1
        DEFW pr_face + 10, pr_nsh + 10
        DEFB 0, 2
        DEFW pr_face + 10, pr_nsh + 10
        DEFB 0, 3
        DEFW pr_face + 4, pr_nsh + 4
        DEFB 0, 4
        DEFW pr_face + 4, pr_nsh + 4
        DEFB 0, 5
        DEFW pr_face + 4, pr_nsh + 4
        DEFB 0, 6
        DEFW pr_face + 25, pr_nsh + 7
        DEFB 1, 2
        DEFW pr_face + 25, pr_nsh + 7
        DEFB 1, 3
        DEFW pr_face + 22, pr_nsh + 4
        DEFB 1, 4
        DEFW pr_face + 22, pr_nsh + 4
        DEFB 1, 5
        DEFW pr_face + 22, pr_nsh + 4
        DEFB 1, 6
        DEFW pr_face + 46, pr_nsh + 10
        DEFB 2, 3
        DEFW pr_face + 40, pr_nsh + 22
        DEFB 2, 4
        DEFW pr_face + 40, pr_nsh + 22
        DEFB 2, 5
        DEFW pr_face + 40, pr_nsh + 22
        DEFB 2, 6
        DEFW pr_face + 58, pr_nsh + 28
        DEFB 3, 4
        DEFW pr_face + 58, pr_nsh + 28
        DEFB 3, 5
        DEFW pr_face + 58, pr_nsh + 28
        DEFB 3, 6
        DEFW pr_face + 82, pr_nsh + 10
        DEFB 4, 5
        DEFW pr_face + 79, pr_nsh + 37
        DEFB 4, 6
        DEFW pr_face + 100, pr_nsh + 46
        DEFB 5, 6

pr_bit:         ; a bit a piece, a word each
        DEFW 1
        DEFW 2
        DEFW 4
        DEFW 8
        DEFW 16
        DEFW 32
        DEFW 64

pr_norm:        ; every normal any face has, 1.7 signed
        DEFB 127,0,0,129,0,0,0,127,0,0,129,0
        DEFB 0,0,127,0,0,129,89,91,0,166,166,0
        DEFB 90,166,0,165,89,0,67,108,0,190,147,0
        DEFB 145,195,0,67,148,0,188,108,0,146,63,0
        DEFB 110,193,0,111,61,0

pr_face:        ; a normal and a plane offset, six a piece
        DEFB 0,64,22,1,64,1,2,0,14,3,128,246
        DEFB 4,128,3,5,128,3,0,64,22,1,64,1
        DEFB 2,64,246,3,64,14,4,128,3,5,128,3
        DEFB 6,128,10,7,64,250,130,64,9,131,0,0
        DEFB 4,128,3,5,128,3,8,128,10,9,64,250
        DEFB 130,0,0,131,128,9,4,128,3,5,128,3
        DEFB 10,64,254,11,128,4,140,192,13,131,0,0
        DEFB 4,128,3,5,128,3,13,64,254,14,128,4
        DEFB 130,0,0,143,64,13,4,128,3,5,128,3
        DEFB 1,64,22,0,128,236,144,128,242,145,0,242
        DEFB 4,128,3,5,128,3

pr_axes:        ; where each axis's values are, and how
                ; many - a frame builds only these
        DEFW pr_xv
        DEFB 9
        DEFW pr_yv
        DEFB 9
        DEFW pr_zv
        DEFB 2

pr_xv:         ; the x a vertex ever has
        DEFB 166,178,221,244,250,22,32,61,90

pr_yv:         ; the y a vertex ever has
        DEFB 198,208,217,229,0,26,38,48,57

pr_zv:         ; the z a vertex ever has
        DEFB 242,14
