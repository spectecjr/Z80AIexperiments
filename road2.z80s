;------------------------------------------------------------------
; road2.z80s - the Hang On road again, at 50 Hz and no CLUT writes
;
;   rd2_init     sky and grass into both buffers, once
;   rd2_frame    draw from (rd2_camx, rd2_camz) and flip
;
; road.z80s puts everything that repeats with distance into the
; palette - the mown stripes, the tarmac's bands, the kerb's red and
; white, the dashes - for two bits a scanline, and rides forward for
; nothing. That wants a CLUT write every scanline. At the ~150
; T-states a line interrupt costs here that is 28,800 a frame, about a
; quarter of a 50 Hz one, to save at most 14,000; and it cannot even be
; had, because the fill holds SP on the screen and an interrupt would
; push its return address into the middle of the road.
;
; So the palette is fixed and all of it is drawn. Two things pay:
;
; ONLY WHAT MOVED IS REPAINTED. A row's road is one interval, so the
; window is the road plus a fixed margin either side - which has to
; cover what it moves in the *two* frames a buffer waits its turn. No
; record of where it was is needed, which also means every entry below
; is a constant: the window moves with the road, so what the row does
; never depends on where the road actually is. Only SP does.
;
; ONE COMPILED RUN A ROW. A row's road has a shape fixed by the row and
; only its position moves, so it compiles once and SP places it - which
; is chequer3's trick with the road's edges in place of the phase. Both
; kerbs, their inner edges and the centre line all ride inside the run,
; baked to the pixel, so a row is one dispatch.
;
; WHICH IS ALSO WHY THE MARKINGS SURVIVE. road.z80s drops a kerb or a
; centre line below four pixels, because two boundaries inside one PUSH
; want a byte carrying three colours and its mixed-pair table holds two.
; A baked run has no such table: a one pixel line is a nibble in a
; PUSHed constant. The kerbs keep their red and white to the horizon.
;
; AND THE ROAD IS WIDER THAN THE SCREEN - 118% of it at the bottom - so
; both ends of that run are off the row, and they want opposite
; answers. A PUSH run cannot be started late, so the right hand end is
; entered through a STUB: seven bytes a skip that hand the run the HL
; it would have had and put back the odd byte at the screen's edge,
; because a run is a mix of one byte PUSHes and four byte LD HL,nn
; pairs and skipping n of those is a lookup, not arithmetic. And it
; cannot be stopped early, so the left hand end simply SPILLS into the
; previous row - which is the next one drawn, and which puts grass back
; over it first, through the same uniform PUSH block a stale band uses.
;
; The exception to the window is a row whose band parity has flipped
; since this buffer last had it, which wants its whole width back
; before the road goes on top. That is what sets the band period: at
; 256 world units it is one row in six a frame and the routine misses
; 50 Hz; at 512 it is one in twelve and the worst frame fits too. The
; longer bands also happen to look better.
;
; The geometry is road.z80s's, with a flatter camera: harrier's focal
; length, the bend integrated twice up the screen, steering as the
; constant of the first integration, and the centre held between rails
; that are now only there to keep the accumulator off its own wrap.
;
; Written by Claude (Opus) for the Z80AIexperiments repo.
;------------------------------------------------------------------

RD2_BUF0:       EQU 0x80
RD2_BUF1:       EQU 0x20
RD2_G0:         EQU 0x2222      ; the grass, one band and the other
RD2_G1:         EQU 0x3333

;------------------------------------------------------------------
; rd2_init - the sky into both buffers, and grass under it
;
; The sky is drawn once and never again: nothing below the horizon
; reaches it, not even the run's left hand end, because the window
; stops well short of the row's start. The road's rows get grass so
; that a buffer is never read before it is written, and every record's
; parity marks are set to something no row can match, so the first two
; frames repaint in full.
;------------------------------------------------------------------

rd2_init:
        LD   A,RD2_BUF0
        LD   (rd2_back),A
        LD   A,RD2_BUF1
        LD   (rd2_front),A
        LD   H,RD2_BUF0
        CALL rd2_fill
        LD   H,RD2_BUF1
        CALL rd2_fill
        LD   IX,rd2_rec         ; no row has drawn into either buffer yet
        LD   B,RD2_ROWS
rd2_i1:
        LD   (IX+4),255
        LD   (IX+5),255
        LD   DE,RD2_REC
        ADD  IX,DE
        DJNZ rd2_i1
        RET

rd2_fill:
        LD   L,0
        LD   DE,rd2_sky
        LD   C,RD2_HZ + 1       ; the sky's own rows, a byte each
rd2_f1:
        LD   A,(DE)
        INC  DE
        LD   B,128
rd2_f2:
        LD   (HL),A
        INC  HL
        DJNZ rd2_f2
        DEC  C
        JR   NZ,rd2_f1
        LD   A,RD2_G0 & 255     ; and grass under it, so that a buffer
        LD   C,192 - RD2_HZ - 1 ; is never read before it is written
rd2_f3:
        LD   B,128
rd2_f4:
        LD   (HL),A
        INC  HL
        DJNZ rd2_f4
        DEC  C
        JR   NZ,rd2_f3
        RET

;------------------------------------------------------------------
; rd2_frame - one frame
;------------------------------------------------------------------

rd2_frame:
        LD   HL,(rd2_camz)      ; the depth goes in as an immediate, so
        LD   (rd2_cl+1),HL      ; nothing has to carry it down the rows
        LD   A,(rd2_back)       ; and which of the two parity marks in
        CP   RD2_BUF0           ; each record is this buffer's
        LD   A,0xBD             ; CP L
        LD   HL,-2
        JR   Z,rd2_fr1
        LD   A,0xBC             ; CP H
        LD   HL,-1
rd2_fr1:
        LD   (rd2_mk),A
        LD   (rd2_mw+1),HL
        CALL rd2_draw
        LD   A,(rd2_back)
        LD   B,A
        LD   A,(rd2_front)
        LD   (rd2_back),A
        LD   A,B
        LD   (rd2_front),A
        RET

;------------------------------------------------------------------
; rd2_draw - the road, bottom row upwards
;
; IX is the row's first byte on screen, IY the road's centre in 8.8
; pixels, and SP walks the row's record until the moment it becomes
; the screen. Bottom upwards because that is the order the bend
; integrates in.
;------------------------------------------------------------------

rd2_draw:
        DI
        LD   (rd2_sp),SP
        LD   A,128              ; nothing has spilled into the bottom row
        LD   (rd2_dirt),A
        LD   HL,(rd2_camx)      ; the lateral step a row is the camera's
        LD   (rd2_dx),HL        ; offset itself, and the bottom row is
        LD   D,H                ; RD2_ROWS of them out
        LD   E,L
        ADD  HL,HL
        ADD  HL,HL
        ADD  HL,DE              ; 5 * camx
        ADD  HL,HL
        ADD  HL,HL
        ADD  HL,HL
        ADD  HL,HL              ; 80 * camx
        EX   DE,HL
        LD   HL,0x8000          ; the middle of the screen, 8.8
        OR   A
        SBC  HL,DE
        PUSH HL
        POP  IY                 ; IY = x
        LD   A,(rd2_back)
        LD   IXH,A
        LD   IXL,0
        LD   DE,(192 - 1) * 128 ; the last row's first byte
        ADD  IX,DE
        EXX
        LD   B,RD2_ROWS
        LD   HL,rd2_rec         ; the records, and the stride to the next
        LD   DE,RD2_REC
        EXX



;------------------------------------------------------------------
; One row: where the road is, and then the run that draws it
;
; The window - grass margin, road, grass margin - is one run, so a row
; is one dispatch. Where its right hand end is off the screen the run
; is entered through a stub, which hands it the HL it would have had
; and puts back the odd byte at the screen's edge. Where its left hand
; end is off, it simply spills into the previous row, which is the
; next one drawn.
;------------------------------------------------------------------

rd2_row:
        EXX
        LD   SP,HL              ; the record, which the other set walks
        ADD  HL,DE              ; on to the next while SP reads this one
        EXX
        POP  HL                 ; this row's depth, kept until the centre
        LD   A,IYH              ; is out. The rails are constants now:
        CP   RD2_CLO            ; they no longer keep the road on screen,
        JR   NC,rd2_r1          ; only the accumulator off its own wrap
        LD   A,RD2_CLO
rd2_r1:
        CP   RD2_CHI + 1
        JR   C,rd2_r2
        LD   A,RD2_CHI
rd2_r2:
        LD   IYH,A
        POP  DE                 ; E = w + margin + 1, D = the width's index
        ADD  A,E                ; nine bits, because a road wider than the
        RRA                     ; screen puts the window's end past 255
        LD   B,0                ; A = that end as a byte, and the bit that
        RL   B                  ; falls out of it is the phase
        LD   C,A
        LD   A,B                ; which run this row wants: four entries a
        ADD  A,A                ; width and two a phase. B keeps it through
        ADD  A,D                ; the geometry, which has no use for it
        LD   B,A
        LD   A,C                ; back to the window's end
        SUB  128                ; how far past the screen's right hand edge
        JR   C,rd2_r3
        INC  A                  ; it is, and so how many PUSHes of it are
        SRL  A                  ; off the screen
        JR   rd2_r4
rd2_r3:
        XOR  A
rd2_r4:
        LD   (rd2_sk),A
        ADD  A,A
        NEG
        ADD  A,C                ; and where SP goes: the window's right hand
        LD   (rd2_sp0),A        ; end, or the screen's, whichever is left of
                                ; the other
rd2_cl:
        LD   DE,0               ; patched: the camera's distance
        ADD  HL,DE
        LD   A,H                ; bit 8 of it is the band's parity, and
        AND  1                  ; all that riding forward costs
        LD   C,A
        LD   A,H
        AND  0x7E               ; bits 9 to 14 are the track's segment
        LD   L,A
        LD   H,rd2_trk / 256
        LD   A,(HL)
        INC  L
        LD   H,(HL)
        LD   L,A                ; HL = the curvature there
        LD   DE,(rd2_dx)
        ADD  HL,DE
        LD   (rd2_dx),HL        ; dx += curvature
        LD   D,H
        LD   E,L
        ADD  IY,DE              ; and x += dx, which is the row above's
        LD   E,B                ; the run's index, for rd2_road
        POP  HL                 ; the parity each buffer last painted
        LD   A,C
rd2_mk:
        CP   L                  ; patched: which of the two is ours
        JR   Z,rd2_r7
rd2_mw:
        LD   HL,-2              ; patched with it. The bands have moved on
        ADD  HL,SP              ; under this row, so all of its grass is
        LD   (HL),A             ; stale and the whole of it goes back
        XOR  A
        JR   rd2_r9
rd2_r7:
        LD   A,(rd2_dirt)       ; otherwise only what the row below spilled
        CP   128                ; into it, and usually nothing did
        JR   NC,rd2_road
        LD   HL,rd2_sp0         ; back to the window's end, or to the spill,
        CP   (HL)               ; whichever is further right - the run puts
        JR   NC,rd2_r8          ; the rest back itself
        LD   A,(HL)
rd2_r8:
        AND  0xFE               ; even: the odd byte under it is the run's
rd2_r9:
        RRA                     ; and a PUSH covers two
        LD   (rd2_f),A
        LD   B,E                ; the run's index, while DE carries the
        LD   D,RD2_G0 & 255     ; grass - which is the only thing a fill
        BIT  0,C                ; needs a register pair for, and the only
        JR   Z,rd2_r10          ; place the parity has to be a colour
        LD   D,RD2_G1 & 255
rd2_r10:
        LD   E,D
        LD   A,IXL
        ADD  A,128
        LD   L,A
        LD   A,IXH
        ADC  A,0
        LD   H,A
        LD   SP,HL              ; one past the row's last byte
        LD   A,(rd2_f)
        LD   L,A
        LD   H,rd2_fill128 / 256
        JP   (HL)

;------------------------------------------------------------------
; Into the run: SP first, because the run starts PUSHing at once.
;------------------------------------------------------------------

rd2_road:
        LD   A,(rd2_sp0)
        ADD  A,IXL
        LD   L,A
        LD   A,IXH
        ADC  A,0
        LD   H,A
        LD   SP,HL
        LD   A,(rd2_sk)
        OR   A
        JR   NZ,rd2_p1
        LD   L,E                ; nothing off the screen, so straight into
        LD   A,C                ; the run: it loads HL itself. A page a
        ADD  A,rd2_rt0 / 256    ; parity, so the parity is the page
        LD   H,A
        LD   A,(HL)
        INC  L
        LD   H,(HL)
        LD   L,A
        JP   (HL)

rd2_p1:
        DEC  A                  ; else the stub for that many PUSHes in,
        LD   B,A                ; seven bytes each
        ADD  A,A
        ADD  A,A
        ADD  A,A
        SUB  B
        LD   B,A
        LD   L,E
        LD   A,C
        ADD  A,rd2_st0 / 256
        LD   H,A
        LD   A,(HL)
        INC  L
        LD   H,(HL)
        LD   L,A
        LD   A,B
        ADD  A,L
        LD   L,A
        JR   NC,rd2_p2
        INC  H
rd2_p2:
        LD   A,(HL)             ; the byte the last skipped PUSH would have
        INC  HL                 ; put at the screen's own right hand edge.
        LD   (IX+127),A         ; Stored always: where it was not wanted the
        JP   (HL)               ; run's own first PUSH covers it

;------------------------------------------------------------------
; The runs all end here, and the row loop with them. SP is where the
; run ran out, which is the next row's problem if it is off the left
; hand end of this one.
;------------------------------------------------------------------

rd2_out:
        LD   HL,0
        ADD  HL,SP              ; where the run ran out
        LD   DE,-128
        ADD  IX,DE
        LD   A,L
        SUB  IXL                ; and how far into the row above that is
        LD   (rd2_dirt),A
        EXX
        DEC  B
        EXX
        JP   NZ,rd2_row
        LD   SP,(rd2_sp)
        EI
        RET

;------------------------------------------------------------------
; Grass, from a byte in the row to the end of it: the whole row when
; the bands have moved on under it, and just the right hand end when
; the row below spilled into it. A uniform run, so unlike the road's
; one it *can* be entered part way in by arithmetic. The road goes on
; top of it, so it falls back into the row rather than out of it.
;------------------------------------------------------------------

        ALIGN 256
rd2_fill128:
        DEFS 64,0xD5            ; PUSH DE
        LD   E,B                ; and the run's index back
        JP   rd2_road

;------------------------------------------------------------------
; Workspace
;------------------------------------------------------------------

rd2_back:       DEFB RD2_BUF0
rd2_front:      DEFB RD2_BUF1
rd2_camx:       DEFW 0          ; the camera's lateral offset, world units
rd2_camz:       DEFW 0          ; and how far it has come
rd2_dx:         DEFS 2
rd2_sp:         DEFS 2
rd2_sp0:        DEFS 1          ; where the window ends, a byte in the row
rd2_sk:         DEFS 1          ; and how many PUSHes of it are off screen
rd2_dirt:       DEFS 1          ; how far into this row the row below
                                ; spilled, 128 for not at all
rd2_f:          DEFS 1          ; and where a fill starts, in PUSHes
