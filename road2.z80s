;------------------------------------------------------------------
; road2.z80s - the Hang On road again, at 50 Hz, no CLUT writes, and
; wider than the screen
;
;   rd2_init     sky and grass into both buffers, once
;   rd2_frame    draw from (rd2_camx, rd2_camz) and flip
;
; road.z80s puts everything that repeats with distance into the
; palette - the mown stripes, the tarmac's bands, the kerb's red and
; white, the dashes - for two bits a scanline, and rides forward for
; nothing. That wants a CLUT write every scanline. At the ~150
; T-states a line interrupt costs here that is 28,800 a frame, about a
; quarter of a 50 Hz one, to save 11,762; and it cannot even be had,
; because the fill holds SP on the screen and an interrupt would push
; its return address into the middle of the road.
;
; So the palette is fixed and all of it is drawn. Two things pay:
;
; ONLY WHAT MOVED IS REPAINTED. A row's road is one interval, so the
; window is the road plus a fixed margin either side - which has to
; cover what it moves in the *two* frames a buffer waits its turn. No
; record of where it was is needed, which also means every entry in
; the bank is a constant: the window moves with the road, so what the
; row does never depends on where the road actually is. Only SP does.
;
; ONE COMPILED RUN A ROW. A row's road has a shape fixed by the row and
; only its position moves, so it compiles once and SP places it - which
; is chequer3's trick with the road's edges in place of the phase. Both
; kerbs, their inner edges and the centre line all ride inside the run,
; baked to the pixel, so a row is one dispatch.
;
; WHICH IS ALSO WHY THE MARKINGS SURVIVE. road.z80s drops a kerb or a
; centre line below four pixels, because two boundaries inside one PUSH
; want a byte carrying three colours and its mixed-pair table holds two.
; A baked run has no such table: a one pixel line is a nibble in a
; PUSHed constant. The kerbs keep their red and white to the horizon.
;
; AND THE ROAD IS WIDER THAN THE SCREEN - 121% of it at the bottom - so
; both ends of that run are off the row, and they want opposite
; answers. A PUSH run cannot be started late, so the right hand end is
; entered through a STUB: seven bytes a skip that hand the run the HL
; it would have had and put back the odd byte at the screen's edge,
; because a run is a mix of one byte PUSHes and four byte LD HL,nn
; pairs and skipping n of those is a lookup, not arithmetic. And it
; cannot be stopped early, so the left hand end simply SPILLS into the
; previous row - which is the next one drawn, and which puts grass back
; over it first, through the same uniform PUSH block a stale band uses.
;
; THE BANK IS PAGED, which is what lets every row have its own width
; rather than one shared between two rows or five. It is 41,297 bytes
; in two chunks of a 32K window; the rows are drawn widest first, so
; the bank is walked forwards and a row's record carries the LMPR value
; that pages its own chunk in. See .claude/skills/sam-coupe-hardware.
;
; THE MEMORY MAP, and it is the map that makes the rest simple:
;
;   0000-7FFF  LMPR: a chunk of the run bank, with its index tables at
;              the foot of it. The caller's stack lives up at 7FFE, in
;              chunk 0, and this routine leaves chunk 0 paged in.
;   8000-DFFF  HMPR: the back buffer, always - the displayed one needs
;              no mapping at all, which is what leaves the whole low
;              32K for the bank.
;   E000-FFFF  this code and its tables, in the 8K a MODE 4 screen
;              leaves spare at the end of its odd page. There is a copy
;              behind each buffer, and the only thing that differs
;              between them is the one thing that should: each row's
;              record remembers which band *that* buffer last painted.
;
; The geometry is road.z80s's, with a flatter camera: harrier's focal
; length, the bend integrated twice up the screen, steering as the
; constant of the first integration, and the centre held between rails
; that are only there to keep the accumulator off its own wrap.
;
; Written by Claude (Opus) for the Z80AIexperiments repo.
;------------------------------------------------------------------

RD2_LMPR:       EQU 250         ; the low 32K: the bank
RD2_HMPR:       EQU 251         ; the high 32K: the buffer being drawn
RD2_VMPR:       EQU 252         ; and what the video hardware displays
RD2_SCR0:       EQU 4           ; the two buffers, on even pages because a
RD2_SCR1:       EQU 6           ; MODE 4 screen wraps even to odd
RD2_MODE4:      EQU 0x60        ; the mode bits of VMPR
RD2_BANK0:      EQU 0x20        ; chunk 0, with RAM over ROM 0
RD2_SCREEN:     EQU 0x8000      ; where the back buffer is mapped
RD2_G0:         EQU 0x2222      ; the grass, one band and the other
RD2_G1:         EQU 0x3333

;------------------------------------------------------------------
; The way in, and the way back out of a run. RD2_OUT is a constant in
; the bank - a chunk is assembled on its own and knows nothing else
; about this code - so rd2_out has to be at a fixed address, which is
; what the three bytes above it are for.
;------------------------------------------------------------------

rd2_enter:
        JP   rd2_row

rd2_out:
        LD   HL,0
        ADD  HL,SP              ; where the run ran out
        LD   DE,-128
        ADD  IX,DE
        LD   A,L
        SUB  IXL                ; and how far into the row above that is
        LD   (rd2_dirt),A
        EXX
        DEC  B
        EXX
        JP   NZ,rd2_row

rd2_seg1:
        LD   HL,(rd2_segp)      ; the next stretch of rows, and the chunk of
        LD   A,(HL)             ; the bank their runs are in. The rows are
        INC  HL                 ; drawn widest first and the bank is cut in
        OR   A                  ; the same order, so a bank of any size is
        JR   Z,rd2_end          ; two OUTs a frame and nothing a row
        OUT  (RD2_LMPR),A
        LD   A,(HL)
        INC  HL
        LD   (rd2_segp),HL
        EXX
        LD   B,A
        EXX
        JP   rd2_row

rd2_end:
        LD   A,RD2_BANK0        ; the caller's stack is in chunk 0
        OUT  (RD2_LMPR),A
        LD   SP,(rd2_sp)
        EI
        RET

        ASSERT rd2_out == RD2_OUT

;------------------------------------------------------------------
; rd2_init - the sky into both buffers, and grass under it
;
; The sky is drawn once and never again: nothing below the horizon
; reaches it, not even a run's left hand end, because a row only
; spills once it is wider than the rails, which is forty rows below
; the horizon. The road's rows get grass so that a buffer is never
; read before it is written, and every record's parity mark is set to
; something no row can match, so the first frame in each repaints in
; full.
;
; On return HMPR maps buffer 0, which is the one to draw into, and the
; hardware is displaying buffer 1.
;------------------------------------------------------------------

rd2_init:
        LD   A,RD2_SCR1
        OUT  (RD2_HMPR),A
        CALL rd2_fill
        LD   A,RD2_SCR1 | RD2_MODE4
        OUT  (RD2_VMPR),A
        LD   A,RD2_SCR0
        OUT  (RD2_HMPR),A
        CALL rd2_fill
        LD   A,RD2_BANK0
        OUT  (RD2_LMPR),A
        RET

rd2_fill:
        LD   HL,RD2_SCREEN
        LD   DE,rd2_sky
        LD   C,RD2_HZ + 1       ; the sky's own rows, a byte each
rd2_f1:
        LD   A,(DE)
        INC  DE
        LD   B,128
rd2_f2:
        LD   (HL),A
        INC  HL
        DJNZ rd2_f2
        DEC  C
        JR   NZ,rd2_f1
        LD   A,RD2_G0 & 255     ; and grass under it, so that a buffer
        LD   C,192 - RD2_HZ - 1 ; is never read before it is written
rd2_f3:
        LD   B,128
rd2_f4:
        LD   (HL),A
        INC  HL
        DJNZ rd2_f4
        DEC  C
        JR   NZ,rd2_f3
        LD   HL,rd2_rec + 5     ; and no band has been painted into this
        LD   DE,RD2_REC         ; buffer yet
        LD   B,RD2_ROWS
rd2_f5:
        LD   (HL),255
        ADD  HL,DE
        DJNZ rd2_f5
        RET

;------------------------------------------------------------------
; rd2_frame - one frame, and the flip
;
; Which buffer is which is not written down anywhere: HMPR maps the
; one being drawn and VMPR says which is shown, so the hardware keeps
; that state and this reads it back. Note that the OUT to HMPR swaps
; this code for the copy behind the other buffer - which is why both
; copies have to be identical, and why the caller's stack has to be in
; the low 32K.
;------------------------------------------------------------------

rd2_frame:
        LD   HL,(rd2_camz)      ; the depth goes in as an immediate, so
        LD   (rd2_cl+1),HL      ; nothing has to carry it down the rows
        CALL rd2_draw
        IN   A,(RD2_HMPR)
        AND  31
        LD   C,A                ; the buffer just drawn
        OR   RD2_MODE4
        OUT  (RD2_VMPR),A       ; show it
        LD   A,C
        XOR  RD2_SCR0 ^ RD2_SCR1
        OUT  (RD2_HMPR),A       ; and map the other, to draw into next
        RET

;------------------------------------------------------------------
; rd2_draw - the road, bottom row upwards
;
; IX is the row's first byte on screen, IY the road's centre in 8.8
; pixels, and SP walks the row's record until the moment it becomes
; the screen. Bottom upwards because that is the order the bend
; integrates in - and because that is what makes a run's left hand
; spill repairable: it lands in the row that is drawn next.
;------------------------------------------------------------------

rd2_draw:
        DI
        LD   (rd2_sp),SP
        LD   A,128              ; nothing has spilled into the bottom row
        LD   (rd2_dirt),A
        LD   HL,(rd2_camx)      ; the lateral step a row is the camera's
        LD   (rd2_dx),HL        ; offset itself, and the bottom row is
        LD   D,H                ; RD2_ROWS of them out
        LD   E,L
        ADD  HL,HL
        ADD  HL,HL
        ADD  HL,DE              ; 5 * camx
        ADD  HL,HL
        ADD  HL,HL
        ADD  HL,HL
        ADD  HL,HL              ; 80 * camx
        EX   DE,HL
        LD   HL,0x8000          ; the middle of the screen, 8.8
        OR   A
        SBC  HL,DE
        PUSH HL
        POP  IY                 ; IY = x
        LD   IX,RD2_SCREEN + (192 - 1) * 128
        EXX
        LD   HL,rd2_rec         ; the records, and the stride to the next
        LD   DE,RD2_REC
        EXX
        LD   HL,rd2_seg         ; and the first stretch of rows
        LD   (rd2_segp),HL
        JP   rd2_seg1

;------------------------------------------------------------------
; One row: where the road is, and then the run that draws it
;------------------------------------------------------------------

rd2_row:
        EXX
        LD   SP,HL              ; the record, which the other set walks
        ADD  HL,DE              ; on to the next while SP reads this one
        EXX
        POP  HL                 ; this row's depth, kept until the centre
        LD   A,IYH              ; is out. The rails no longer keep the road
        CP   RD2_CLO            ; on screen - nothing does - they only keep
        JR   NC,rd2_r1          ; the accumulator off its own wrap
        LD   A,RD2_CLO
rd2_r1:
        CP   RD2_CHI + 1
        JR   C,rd2_r2
        LD   A,RD2_CHI
rd2_r2:
        LD   IYH,A
        POP  DE                 ; E = w + margin + 1, D = the width, as a
        ADD  A,E                ; word offset into the index tables. Nine
        RRA                     ; bits, because a road wider than the screen
        LD   C,A                ; puts the window's end past 255
        LD   A,D                ; and the bit that falls out is the phase,
        ADC  A,0                ; which rides in the width's spare bottom
        LD   B,A                ; bit until rd2_road wants both
        LD   A,C
        SUB  128                ; how far past the screen's right hand edge
        JR   C,rd2_r3
        INC  A                  ; the window ends, and so how many PUSHes of
        SRL  A                  ; it are off the screen
        JR   rd2_r4
rd2_r3:
        XOR  A
rd2_r4:
        LD   (rd2_sk),A
        ADD  A,A
        NEG
        ADD  A,C                ; and where SP goes: the window's right hand
        LD   (rd2_sp0),A        ; end, or the screen's, whichever is left of
                                ; the other
rd2_cl:
        LD   DE,0               ; patched: the camera's distance
        ADD  HL,DE
        LD   A,H                ; bit 8 of it is the band's parity, and
        AND  1                  ; all that riding forward costs
        LD   C,A
        LD   A,H                ; and bits 9 to 14 the track's segment
        AND  0x7E
        LD   L,A
        LD   H,rd2_trk / 256
        LD   A,(HL)
        INC  L
        LD   H,(HL)
        LD   L,A                ; HL = the curvature there
        LD   DE,(rd2_dx)
        ADD  HL,DE
        LD   (rd2_dx),HL        ; dx += curvature
        LD   D,H
        LD   E,L
        ADD  IY,DE              ; and x += dx, which is the row above's
        POP  HL                 ; L = the window's width in bytes, H = the
        LD   A,C                ; band this buffer last painted here
        CP   H
        JR   Z,rd2_r7
        ; --- the bands have moved on under this row, so its grass is
        ; stale - but only the grass, and the window is about to have the
        ; road drawn over it, so what goes back is the two ends
        LD   A,(rd2_sk)
        ADD  A,A
        LD   E,A
        LD   A,(rd2_sp0)
        ADD  A,E                ; the window's right hand end, unclipped
        SUB  L                  ; less its width: its left hand end
        JR   NC,rd2_r5
        XOR  A                  ; which may be off the row, and then there
rd2_r5:                         ; is nothing stale to the left of it
        INC  A                  ; round up: the byte it lands in is the
        AND  0xFE               ; run's own
        LD   (rd2_f),A
        LD   A,C                ; and this buffer has the new band now
        LD   HL,-1
        ADD  HL,SP
        LD   (HL),A
        LD   D,RD2_G0 & 255
        BIT  0,C
        JR   Z,rd2_r6
        LD   D,RD2_G1 & 255
rd2_r6:
        LD   E,D
        LD   A,(rd2_f)
        ADD  A,IXL              ; SP to where the left hand fill stops
        LD   L,A
        LD   A,IXH
        ADC  A,0
        LD   H,A
        LD   SP,HL
        LD   A,(rd2_f)
        SRL  A
        LD   L,A
        LD   A,64
        SUB  L                  ; and into the block that many PUSHes from
        LD   L,A                ; its end
        LD   H,rd2_fillL / 256
        JP   (HL)

rd2_r6b:
        LD   A,(rd2_sp0)        ; then the grass from the window's right
        JR   rd2_r8             ; hand end to the screen's

rd2_r7:
        LD   A,(rd2_dirt)       ; otherwise only what the row below spilled
        CP   128                ; into it, and usually nothing did
        JR   NC,rd2_road
        LD   HL,rd2_sp0         ; back to the window's end, or to the spill,
        CP   (HL)               ; whichever is further right - the run puts
        JR   NC,rd2_r8          ; the rest back itself
        LD   A,(HL)
rd2_r8:
        AND  0xFE               ; even: the odd byte under it is the run's
rd2_r9:
        RRA                     ; and a PUSH covers two
        LD   (rd2_f),A
        LD   D,RD2_G0 & 255     ; DE carries the grass, because BC is the
        BIT  0,C                ; width and the parity and HL is about to be
        JR   Z,rd2_r10          ; the screen
        LD   D,RD2_G1 & 255
rd2_r10:
        LD   E,D
        LD   A,IXL
        ADD  A,128
        LD   L,A
        LD   A,IXH
        ADC  A,0
        LD   H,A
        LD   SP,HL              ; one past the row's last byte
        LD   A,(rd2_f)
        LD   L,A
        LD   H,rd2_fill128 / 256
        JP   (HL)

;------------------------------------------------------------------
; Into the run: SP first, because the run starts PUSHing at once.
;
; The bank's index tables are eight pages at the foot of whichever
; chunk is in - a page for each parity and phase of the run table, and
; four more for the stubs - so the page is the parity and the phase,
; and the offset in it is the width.
;------------------------------------------------------------------

rd2_road:
        LD   A,(rd2_sp0)
        ADD  A,IXL
        LD   L,A
        LD   A,IXH
        ADC  A,0
        LD   H,A
        LD   SP,HL
        LD   A,B                ; the phase, out of the width's bottom bit
        AND  1
        LD   L,A
        LD   A,C                ; and the parity above it
        ADD  A,A
        ADD  A,L
        LD   H,A
        LD   A,(rd2_sk)
        OR   A
        JR   NZ,rd2_p1
        LD   A,B                ; nothing off the screen, so straight into
        AND  0xFE               ; the run: it loads HL itself
        LD   L,A
        LD   A,(HL)
        INC  L
        LD   H,(HL)
        LD   L,A
        JP   (HL)

rd2_p1:
        LD   E,A                ; else the stub for that many PUSHes in:
        DEC  A                  ; seven bytes each, in the stub table four
        LD   E,A                ; pages above the run table
        ADD  A,A
        ADD  A,A
        ADD  A,A
        SUB  E
        LD   E,A
        LD   A,H
        ADD  A,4
        LD   H,A
        LD   A,B
        AND  0xFE
        LD   L,A
        LD   A,(HL)
        INC  L
        LD   H,(HL)
        LD   L,A
        LD   A,E
        ADD  A,L
        LD   L,A
        JR   NC,rd2_p2
        INC  H
rd2_p2:
        LD   A,(HL)             ; the byte the last skipped PUSH would have
        INC  HL                 ; put at the screen's own right hand edge.
        LD   (IX+127),A         ; Stored always: where it was not wanted the
        JP   (HL)               ; run's own first PUSH covers it

;------------------------------------------------------------------
; Grass, from a byte in the row to the end of it: the whole row when
; the bands have moved on under it, and just the right hand end when
; the row below spilled into it. A uniform run, so unlike the road's
; one it *can* be entered part way in by arithmetic. The road goes on
; top of it, so it falls back into the row rather than out of it.
;------------------------------------------------------------------

        ALIGN 256
rd2_fill128:
        DEFS 64,0xD5            ; PUSH DE
        JP   rd2_road

        ALIGN 256
rd2_fillL:
        DEFS 64,0xD5            ; the same, for the grass to the left of a
        JP   rd2_r6b            ; window whose band has moved on

;------------------------------------------------------------------
; Workspace. There is a copy of all of this behind each buffer, so
; nothing here may carry state from one frame to the next - except
; each record's parity mark, which is per buffer and wants to be.
;------------------------------------------------------------------

rd2_camx:       DEFW 0          ; the camera's lateral offset, world units
rd2_camz:       DEFW 0          ; and how far it has come
rd2_dx:         DEFS 2
rd2_sp:         DEFS 2
rd2_sp0:        DEFS 1          ; where the window ends, a byte in the row
rd2_sk:         DEFS 1          ; and how many PUSHes of it are off screen
rd2_dirt:       DEFS 1          ; how far into this row the row below
                                ; spilled, 128 for not at all
rd2_f:          DEFS 1          ; and where a fill starts, in PUSHes
rd2_segp:       DEFS 2          ; where the row loop is in rd2_seg
