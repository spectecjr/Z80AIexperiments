;------------------------------------------------------------------
; prismpre.z80s - prism.z80s with the whole frame precomputed
;
; prism.z80s spends 197,413 of its 518,273 T-states a frame on work
; that depends on nothing but the frame number: the spin, the nine
; multiply tables, the eight projected corners of each of seven
; pieces, the shade and the visibility of each of 42 faces, and the
; back-to-front order. Precompute all of it and the frame is the
; rasteriser and a table walk - no multiply, no transform, no light,
; no sort. transform3d and democube are not needed at all.
;
; What it costs is the length of the animation, not accuracy: the
; frames are the same frames, to the byte. A frame's table is
;
;     112 bytes   seven pieces of eight (sx, sy)
;      21 bytes   42 faces of a nibble - the ramp level, bit 3 set if
;                 the face is turned away
;       7 bytes   the pieces, farthest first
;       4 bytes   the box to erase, in renderlit's record form
;
; and 144 bytes a frame into the free RAM either side of the screen
; buffers is 64 frames. So the spin has to return to where it started
; in 64 frames, which is one turn an axis here against prism's two,
; three and one per 256.
;
; The records go in the low 8K, the points above the buffers.
;
; Needs renderlit, and a demo_screen for renderlit's own default.
;
; Written by Claude (Opus) for the Z80AIexperiments repo.
;------------------------------------------------------------------

;------------------------------------------------------------------
; pp_init - renderlit's, and back to the top of the loop
;------------------------------------------------------------------

pp_init:
        CALL rndl_init
        XOR  A
        LD   (pp_f),A

        LD   HL,pp_ctab         ; level and ramp -> the colour byte, in
        LD   C,0                ; both nibbles, for both ramps
pp_it0:
        LD   B,16
        LD   E,0
pp_it1:
        LD   A,E
        AND  7
        ADD  A,C
        AND  15
        LD   D,A
        RLCA
        RLCA
        RLCA
        RLCA
        OR   D
        LD   (HL),A
        INC  HL
        INC  E
        DJNZ pp_it1
        LD   A,C
        OR   A
        RET  NZ
        LD   C,8
        JR   pp_it0

;------------------------------------------------------------------
; pp_frame - one frame, read rather than worked out
;------------------------------------------------------------------

pp_frame:
        CALL rndl_erase         ; what this buffer held two frames ago

        LD   A,(pp_f)           ; where this frame's tables are:
        LD   L,A                ; the record at 32f, the points at 112f
        LD   H,0
        ADD  HL,HL
        ADD  HL,HL
        ADD  HL,HL
        ADD  HL,HL              ; 16f
        LD   B,H
        LD   C,L
        ADD  HL,HL              ; 32f
        LD   D,H
        LD   E,L
        PUSH DE
        ADD  HL,HL              ; 64f
        ADD  HL,DE              ; 96f
        ADD  HL,BC              ; 112f
        LD   DE,pp_pts
        ADD  HL,DE
        LD   (pp_pp),HL
        POP  HL
        LD   DE,pp_recs
        ADD  HL,DE
        LD   (pp_rp),HL

        PUSH HL                 ; the box goes straight into the record
        CALL rndl_dirty         ; renderlit erases from next time round
        EX   DE,HL
        POP  HL
        LD   BC,PP_NP
        ADD  HL,BC              ; past the order, at the four box bytes
        LD   C,4
        LDIR

        LD   HL,(pp_rp)         ; the pieces, farthest first
        LD   B,PP_NP
pp_fr1:
        LD   A,(HL)
        INC  HL
        PUSH HL
        PUSH BC
        CALL pp_one
        POP  BC
        POP  HL
        DJNZ pp_fr1

        LD   A,(pp_f)
        INC  A
        AND  PP_NF - 1
        LD   (pp_f),A
        JP   rndl_flip

;------------------------------------------------------------------
; pp_one - one piece: point renderlit at its corners, unpack its six
;          face nibbles into renderlit's colour and visibility, draw
;
; Entry : A = the piece
;------------------------------------------------------------------

pp_one:
        LD   (pp_pi),A
        LD   L,A                ; sixteen bytes of point a piece
        LD   H,0
        ADD  HL,HL
        ADD  HL,HL
        ADD  HL,HL
        ADD  HL,HL
        LD   DE,(pp_pp)
        ADD  HL,DE
        LD   (rndl_pts),HL

        LD   A,(pp_pi)          ; which ramp it wears, as a table half
        LD   L,A
        LD   H,0
        LD   DE,pp_base
        ADD  HL,DE
        LD   A,(HL)
        AND  8
        ADD  A,A                ; 0 or 16
        ADD  A,pp_ctab & 0xFF   ; the table is aligned, so this is the
        LD   (pp_boff),A        ; whole address bar its page

        LD   A,(pp_pi)          ; three bytes of face nibble a piece
        LD   L,A
        LD   H,0
        LD   D,H
        LD   E,L
        ADD  HL,HL
        ADD  HL,DE              ; 3 * piece
        LD   DE,(pp_rp)
        ADD  HL,DE
        LD   DE,PP_NP + 4       ; past the order and the box
        ADD  HL,DE
        LD   (pp_np),HL

        LD   IX,rndl_faces      ; renderlit's own face table, walked
        LD   A,3
        LD   (pp_k),A
pp_on1:
        LD   HL,(pp_np)
        LD   A,(HL)
        INC  HL
        LD   (pp_np),HL
        LD   (pp_n),A
        AND  0x0F
        CALL pp_face
        LD   A,(pp_n)
        RRCA
        RRCA
        RRCA
        RRCA
        AND  0x0F
        CALL pp_face
        LD   A,(pp_k)
        DEC  A
        LD   (pp_k),A
        JR   NZ,pp_on1
        RET

;------------------------------------------------------------------
; pp_face - one face's nibble, drawn or not
;
; The nibble is the ramp level with bit 3 set when the face is turned
; away, and pp_ctab turns level and ramp into the colour byte
; renderlit wants, in both nibbles, in one read. So a face that is not
; drawn costs a bit test and an index register bump, and one that is
; goes straight into rndl_quad - no rndl_vis or rndl_fcol to write and
; nothing to walk them again afterwards.
;
; Entry : A = the nibble, IX -> the face's four corners
;------------------------------------------------------------------

pp_face:
        BIT  3,A
        JR   NZ,pp_fa1          ; turned away
        LD   HL,pp_boff
        ADD  A,(HL)
        LD   L,A
        LD   H,pp_ctab / 256
        LD   A,(HL)
        LD   (rndl_col),A
        CALL rndl_quad
pp_fa1:
        LD   DE,4
        ADD  IX,DE
        RET

;------------------------------------------------------------------
; Workspace
;------------------------------------------------------------------

pp_f:           DEFS 1      ; where in the loop we are
pp_rp:          DEFS 2      ; this frame's record
pp_pp:          DEFS 2      ; and its points
pp_pi:          DEFS 1
pp_b:           DEFS 1
pp_boff:        DEFS 1
pp_np:          DEFS 2
pp_n:           DEFS 1
pp_k:           DEFS 1

        ALIGN 32
pp_ctab:        DEFS 32     ; the two ramps, built by pp_init

PP_SIZE:        EQU $ - pp_init
