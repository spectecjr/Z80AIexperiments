;------------------------------------------------------------------
; stormdata.z80s - generated by tests/mkstormdata.py, do not edit
;
; Distant thunder, and then rain over the top of it.
;
; Two scores of segments. Each is: frames, the octave byte (already
; in the nibble its register wants), the frequency byte and the
; level to start at, then the 8.8 step for each of them a frame.
;------------------------------------------------------------------

SM_L0SEGS:      EQU 16          ; segments in layer 0 (channels 0-2)
SM_L1SEGS:      EQU 6           ; and in layer 1 (channels 3-5)
SM_MAXLVL:      EQU 45          ; three channels of fifteen
SM_INITS:       EQU 13          ; registers sm_init sets up
SM_SEGLEN:      EQU 8           ; bytes a segment

sm_l0:
        DEFB  20,0x02,227,  0,243,254, 64,  1   ;  0.40 s   220.1 Hz  level  0
        DEFB  25,0x02,206, 25, 10,255,163,255   ;  0.50 s   204.9 Hz  level 25
        DEFB  35,0x02,182, 16,226,254,212,  0   ;  0.70 s   190.0 Hz  level 16
        DEFB  30,0x02,143, 45, 17,255,102,255   ;  0.60 s   169.8 Hz  level 45
        DEFB  40,0x02,115, 27, 12,255, 64,  0   ;  0.80 s   157.8 Hz  level 27
        DEFB  35,0x02, 77, 37,226,254,124,255   ;  0.70 s   144.0 Hz  level 37
        DEFB  36,0x02, 38, 19,241,254, 49,  0   ;  0.72 s   132.1 Hz  level 19
        DEFB   9,0x01,255, 26,142,255, 56,  0   ;  0.18 s   122.1 Hz  level 26
        DEFB  40,0x01,251, 28, 83,255,153,255   ;  0.80 s   120.2 Hz  level 28
        DEFB  45,0x01,224, 12, 34,255, 17,  0   ;  0.90 s   108.9 Hz  level 12
        DEFB  35,0x01,185, 15, 14,255,182,255   ;  0.70 s    95.9 Hz  level 15
        DEFB  40,0x01,152,  5,243,254,224,255   ;  0.80 s    87.0 Hz  level  5
        DEFB  30,0x07,141,  0,  0,  0,  0,  0   ;  0.60 s  5405.4 Hz  level  0
        DEFB 100,0x07,141,  0,199,255, 35,  0   ;  2.00 s  5405.4 Hz  level  0
        DEFB 100,0x07,119, 14, 71,  0,  2,  0   ;  2.00 s  5102.0 Hz  level 14
        DEFB  80,0x07,147, 15, 22,  0,208,255   ;  1.60 s  5494.5 Hz  level 15

sm_l1:
        DEFB 120,0x50,198,  0,  0,  0,  0,  0   ;  2.40 s  1597.4 Hz  level  0
        DEFB 120,0x50,198,  0,187,255, 25,  0   ;  2.40 s  1597.4 Hz  level  0
        DEFB 140,0x50,166, 12, 93,  0,  5,  0   ;  2.80 s  1449.3 Hz  level 12
        DEFB 160,0x50,217, 15,155,255,252,255   ;  3.20 s  1700.7 Hz  level 15
        DEFB  80,0x50,154, 13,108,  0,  6,  0   ;  1.60 s  1400.6 Hz  level 13
        DEFB  80,0x50,188, 15, 64,  0,208,255   ;  1.60 s  1548.0 Hz  level 15

; a 0..45 level as three amplitude bytes: the chip only has sixteen
; steps a channel, and three channels carrying the same noise add up
sm_spread:
        DEFB 0x00,0x00,0x00            ;  0
        DEFB 0x11,0x00,0x00            ;  1
        DEFB 0x11,0x11,0x00            ;  2
        DEFB 0x11,0x11,0x11            ;  3
        DEFB 0x22,0x11,0x11            ;  4
        DEFB 0x22,0x22,0x11            ;  5
        DEFB 0x22,0x22,0x22            ;  6
