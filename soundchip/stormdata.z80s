        DEFB 0x55,0x55,0x44            ; 14
        DEFB 0x55,0x55,0x55            ; 15
        DEFB 0x66,0x55,0x55            ; 16
        DEFB 0x66,0x66,0x55            ; 17
        DEFB 0x66,0x66,0x66            ; 18
        DEFB 0x77,0x66,0x66            ; 19
        DEFB 0x77,0x77,0x66            ; 20
        DEFB 0x77,0x77,0x77            ; 21
        DEFB 0x88,0x77,0x77            ; 22
        DEFB 0x88,0x88,0x77            ; 23
        DEFB 0x88,0x88,0x88            ; 24
        DEFB 0x99,0x88,0x88            ; 25
        DEFB 0x99,0x99,0x88            ; 26
        DEFB 0x99,0x99,0x99            ; 27
        DEFB 0xAA,0x99,0x99            ; 28
        DEFB 0xAA,0xAA,0x99            ; 29
        DEFB 0xAA,0xAA,0xAA            ; 30
        DEFB 0xBB,0xAA,0xAA            ; 31
        DEFB 0xBB,0xBB,0xAA            ; 32
        DEFB 0xBB,0xBB,0xBB            ; 33
        DEFB 0xCC,0xBB,0xBB            ; 34
        DEFB 0xCC,0xCC,0xBB            ; 35
        DEFB 0xCC,0xCC,0xCC            ; 36
        DEFB 0xDD,0xCC,0xCC            ; 37
        DEFB 0xDD,0xDD,0xCC            ; 38
        DEFB 0xDD,0xDD,0xDD            ; 39
        DEFB 0xEE,0xDD,0xDD            ; 40
        DEFB 0xEE,0xEE,0xDD            ; 41
        DEFB 0xEE,0xEE,0xEE            ; 42
        DEFB 0xFF,0xEE,0xEE            ; 43
        DEFB 0xFF,0xFF,0xEE            ; 44
        DEFB 0xFF,0xFF,0xFF            ; 45

sm_ini:
        DEFB 0x1C,0x02
        DEFB 0x1C,0x01
        DEFB 0x14,0x00
        DEFB 0x15,0x3F
        DEFB 0x16,0x33
        DEFB 0x18,0x00
