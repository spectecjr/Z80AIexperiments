        LD   A,(DE)             ; this row's mask
        XOR  34
        LD   (HL),A
        LD   A,(DE)
        DEC  DE
        AND  0x90               ; the mask again, as the offset
        ADD  A,(chq4_val + 2048) & 255       ; the complement of this run's
        EXX                     ; values
        LD   L,A
        LD   H,(chq4_val + 2048) >> 8
        LD   SP,HL
        POP  BC
