chq5_y86_0:
        LD   A,(DE)             ; this row's mask
        XOR  34
        LD   (HL),A
        LD   A,(DE)
        DEC  DE
        AND  0x10               ; the mask again, as the offset to
        ADD  A,(chq4_val + 64) & 255       ; the complement of this run's
        EXX                     ; values
        LD   L,A
        LD   H,(chq4_val + 64) >> 8
        LD   SP,HL
        POP  BC
        POP  DE
        POP  HL
        POP  IX
        POP  IY
        POP  AF
        EXX
        LD   SP,HL              ; the runs fill rightwards to left
        INC  SP
        EXX
        JP   chq5_r86_0 + 21

