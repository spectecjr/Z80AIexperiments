;------------------------------------------------------------------
; prism.z80s - a lit extruded logo, in convex pieces
;
;   pr_init    blank both buffers and build the ramp
;   pr_frame   spin, light, sort, draw, flip
;
; renderlit.z80s draws a cube: eight vertices, six quad faces, and the
; face normals for nothing because they are the columns of the
; rotation matrix. An extruded quad has exactly the same shape - eight
; vertices, six quad faces - so a logo cut into convex quads is a
; handful of cubes that are not cubes, and renderlit's rasteriser,
; face table and shading draw them unchanged.
;
; WHAT HAS TO BE FOUND RATHER THAN ASSUMED, per face:
;
;   the normal   a side face's is its quad edge's 2D normal and the
;                front and back faces' is the z axis, all of them
;                object space constants. So N.L and N.T are the same
;                two transposed matrix-vector products renderlit
;                already does, dotted with the face's own normal - and
;                since a normal is shared by every face that has it,
;                that is done once per distinct normal, not per face.
;
;   the plane    renderlit tests N.T + S < 0 with S the cube's half
;                size. Here it is N.T + (n . p) for a point p on the
;                face, which is a constant the generator works out.
;
;   the order    the pieces are convex and disjoint but the whole is
;                not, so they are drawn back to front by the depth of
;                their centres. That is exact whenever a plane
;                separates two pieces, which for a flat logo it does.
;
; THE MULTIPLY TABLES. transform3d wants nine tables indexed by a
; vertex coordinate; democube fills two entries of each because a cube
; has only +S and -S. A logo has more, but not many - nine x values,
; nine y values and two z - so pr_tables fills exactly the entries the
; vertices will read, sixty multiplies rather than 2,304.
;
; The shape in prismdata.z80s is provisional: a serif sigma of 45
; degree angles and a triangle with a triangular hole, built from a
; description rather than from the artwork. Nothing here depends on
; it: swap the numbers and the renderer does not care.
;
; Needs mul8x8_qs, transform3d, democube (the spin) and renderlit.
;
; Written by Claude (Opus) for the Z80AIexperiments repo.
;------------------------------------------------------------------

;------------------------------------------------------------------
; pr_init - renderlit's, and the logo's place, which never changes
;------------------------------------------------------------------

pr_init:
        CALL rndl_init
        LD   HL,PR_DA           ; how fast it turns, democube's variables
        LD   DE,demo_dax
        LD   BC,3
        LDIR
        LD   HL,0
        LD   (t3d_tx),HL
        LD   (t3d_ty),HL
        LD   HL,PR_TZ
        LD   (t3d_tz),HL
        RET

;------------------------------------------------------------------
; pr_frame - one frame
;------------------------------------------------------------------

pr_frame:
        CALL rndl_erase         ; the one box the whole logo drew in
        CALL demo_spin          ; one matrix for all of it
        CALL pr_tables          ; the multiply table entries it will read
        CALL pr_light           ; a shade and an N.T for each normal
        CALL pr_order           ; the pieces, farthest first
        CALL pr_draw
        CALL pr_box
        JP   rndl_flip

;------------------------------------------------------------------
; pr_tables - m[j] * v for every coordinate value the logo has
;------------------------------------------------------------------

pr_tables:
        LD   IX,pr_axes
        LD   C,0                ; the axis, 0 to 2
pr_ta1:
        LD   L,(IX+0)
        LD   H,(IX+1)
        LD   (pr_vp),HL         ; where its values are
        LD   A,(IX+2)
        LD   (pr_vn),A
        LD   A,C
        LD   (pr_j),A           ; and its three tables, j, j+3, j+6
        PUSH BC
        LD   B,3
pr_ta2:
        PUSH BC
        LD   A,(pr_j)
        LD   E,A
        LD   D,0
        LD   HL,t3d_m
        ADD  HL,DE
        LD   A,(HL)
        LD   (pr_m),A           ; the coefficient
        LD   A,(pr_j)
        ADD  A,A
        ADD  A,t3d_tab / 256
        LD   (pr_pg),A          ; and the page pair its table lives in
        LD   HL,(pr_vp)
        LD   A,(pr_vn)
        LD   B,A
pr_ta3:
        PUSH BC
        LD   A,(HL)
        PUSH HL
        LD   (pr_v),A
        OR   A                  ; |v|, and its sign remembered
        JP   P,pr_ta4
        NEG
pr_ta4:
        LD   C,A
        LD   A,(pr_m)
        LD   B,A
        CALL demo_smul16        ; DE = m * |v|
        LD   A,(pr_v)
        OR   A
        JP   P,pr_ta5
        LD   HL,0               ; v was negative
        OR   A
        SBC  HL,DE
        EX   DE,HL
pr_ta5:
        LD   A,(pr_pg)
        LD   H,A
        LD   A,(pr_v)
        LD   L,A
        LD   (HL),E
        INC  H
        LD   (HL),D
        POP  HL
        INC  HL
        POP  BC
        DJNZ pr_ta3
        LD   A,(pr_j)           ; the next table of this axis
        ADD  A,3
        LD   (pr_j),A
        POP  BC
        DJNZ pr_ta2
        POP  BC
        LD   DE,3
        ADD  IX,DE
        INC  C
        LD   A,C
        CP   3
        JP   C,pr_ta1
        RET

;------------------------------------------------------------------
; pr_light - a shade and an N.T for every distinct normal
;
; renderlit's two transposed products, then each normal dotted with
; both of them. A face's own arithmetic is then one add and a sign.
;------------------------------------------------------------------

pr_light:
        LD   A,(t3d_tx+1)       ; T >> 8, as renderlit takes it
        LD   (rndl_w+0),A
        LD   A,(t3d_ty+1)
        LD   (rndl_w+1),A
        LD   A,(t3d_tz+1)
        LD   (rndl_w+2),A
        LD   DE,rndl_cv
        CALL rndl_mtv
        LD   HL,(rndl_lite)
        LD   (rndl_w+0),HL
        LD   A,(rndl_lite+2)
        LD   (rndl_w+2),A
        LD   DE,rndl_lv
        CALL rndl_mtv

        LD   HL,pr_norm
        LD   (pr_np),HL
        LD   HL,pr_nsh
        LD   (pr_sp),HL
        LD   B,PR_NN
pr_li1:
        PUSH BC
        LD   HL,rndl_lv         ; the shade this normal gets
        CALL pr_dot
        CALL pr_sh7
        LD   HL,(pr_sp)
        LD   (HL),A
        INC  HL
        PUSH HL
        LD   HL,rndl_cv         ; and its N.T, which the plane offset
        CALL pr_dot             ; is added to a face at a time
        POP  DE
        EX   DE,HL
        LD   (HL),E
        INC  HL
        LD   (HL),D
        INC  HL
        LD   (pr_sp),HL
        LD   HL,(pr_np)
        LD   DE,3
        ADD  HL,DE
        LD   (pr_np),HL
        POP  BC
        DJNZ pr_li1
        RET

pr_dot:                         ; HL -> three words, (pr_np) -> a normal
        LD   (pr_dp),HL
        LD   HL,0
        LD   (pr_acc),HL
        LD   HL,(pr_np)
        LD   (pr_dn),HL
        LD   B,3
pr_do1:
        PUSH BC
        LD   HL,(pr_dn)
        LD   A,(HL)
        INC  HL
        LD   (pr_dn),HL
        OR   A
        JR   Z,pr_do2           ; a zero component, and most of them are
        LD   (pr_dc),A
        LD   HL,(pr_dp)
        LD   E,(HL)
        INC  HL
        LD   D,(HL)
        EX   DE,HL
        LD   A,(pr_dc)
        CALL pr_mul7            ; (n * v) >> 7
        LD   DE,(pr_acc)
        ADD  HL,DE
        LD   (pr_acc),HL
pr_do2:
        LD   HL,(pr_dp)
        INC  HL
        INC  HL
        LD   (pr_dp),HL
        POP  BC
        DJNZ pr_do1
        LD   HL,(pr_acc)
        RET

pr_sh7:                         ; HL, times 128*128, to a shade byte
        LD   D,H
        LD   E,L
        LD   A,D
        ADD  A,64               ; inside [-16384, 16383]?
        CP   128
        JR   C,pr_s71
        LD   A,D                ; no - peg it at whichever end
        RLA
        SBC  A,A
        XOR  0x7F
        RET
pr_s71:
        ADD  HL,HL
        LD   A,H
        RET

;------------------------------------------------------------------
; pr_mul7 - (HL * A) >> 7, room3d's, which is two byte multiplies
;------------------------------------------------------------------

pr_mul7:
        LD   (pr_m7c),A
        LD   C,A
        LD   B,H
        LD   A,L
        LD   (pr_m7l),A
        CALL pr_smul
        LD   (pr_m7p),DE
        LD   A,(pr_m7l)
        LD   B,A
        LD   A,(pr_m7c)
        LD   C,A
        CALL qsmul8
        LD   A,C
        RLA
        JR   NC,pr_m71
        LD   A,D
        SUB  B
        LD   D,A
pr_m71:
        LD   A,D
        LD   L,A
        ADD  A,A
        SBC  A,A
        LD   H,A
        PUSH DE
        LD   DE,(pr_m7p)
        ADD  HL,DE
        ADD  HL,HL
        POP  DE
        BIT  7,E
        RET  Z
        INC  HL
        RET

pr_smul:                        ; DE = signed B * signed C
        CALL qsmul8
        LD   A,B
        RLA
        JR   NC,pr_sm1
        LD   A,D
        SUB  C
        LD   D,A
pr_sm1:
        LD   A,C
        RLA
        RET  NC
        LD   A,D
        SUB  B
        LD   D,A
        RET

;------------------------------------------------------------------
; pr_order - the pieces farthest first
;------------------------------------------------------------------

pr_order:
        LD   HL,pr_dep          ; every piece's depth once, not once per
        LD   (pr_dp),HL         ; comparison: the sort asks six times
        LD   B,PR_NP            ; what a piece's z is, and finding it is
        XOR  A                  ; two multiplies
pr_od1:
        PUSH BC
        PUSH AF
        CALL pr_zget
        POP  AF
        PUSH AF
        LD   DE,(pr_dp)
        EX   DE,HL
        LD   (HL),E
        INC  HL
        LD   (HL),D
        INC  HL
        LD   (pr_dp),HL
        POP  AF
        INC  A
        POP  BC
        DJNZ pr_od1

        LD   HL,pr_ord
        LD   B,PR_NP
        XOR  A
pr_or1:
        LD   (HL),A
        INC  HL
        INC  A
        DJNZ pr_or1
        LD   B,PR_NP - 1
pr_or2:
        PUSH BC
        LD   HL,pr_ord
        LD   B,PR_NP - 1
pr_or3:
        PUSH BC
        PUSH HL
        LD   A,(HL)
        INC  HL
        LD   C,(HL)
        CALL pr_zcmp
        POP  HL
        JP   P,pr_or4
        LD   A,(HL)
        INC  HL
        LD   C,(HL)
        LD   (HL),A
        DEC  HL
        LD   (HL),C
pr_or4:
        INC  HL
        POP  BC
        DJNZ pr_or3
        POP  BC
        DJNZ pr_or2
        RET

pr_zcmp:                        ; the sign of z(A) - z(C), off the table
        CALL pr_dget
        PUSH HL
        LD   A,C
        CALL pr_dget
        POP  DE
        EX   DE,HL
        OR   A
        SBC  HL,DE
        RET

pr_dget:                        ; A = a piece -> HL = the depth found for it
        ADD  A,A
        LD   L,A
        LD   H,0
        LD   DE,pr_dep
        ADD  HL,DE
        LD   E,(HL)
        INC  HL
        LD   D,(HL)
        EX   DE,HL
        RET

pr_zget:                        ; A = a piece -> HL = the view z of its
        ADD  A,A                ; centre, which is tz + m6*cx + m7*cy
        LD   L,A
        LD   H,0
        LD   DE,pr_cen
        ADD  HL,DE
        LD   C,(HL)             ; cx
        INC  HL
        LD   A,(HL)
        LD   (pr_zy),A          ; cy
        LD   A,(t3d_m+6)
        LD   B,A
        CALL pr_smul
        LD   (pr_zp),DE
        LD   A,(pr_zy)
        LD   C,A
        LD   A,(t3d_m+7)
        LD   B,A
        CALL pr_smul
        LD   HL,(pr_zp)
        ADD  HL,DE
        LD   DE,(t3d_tz)
        ADD  HL,DE
        RET

;------------------------------------------------------------------
; pr_draw - every piece, in that order
;------------------------------------------------------------------

pr_draw:
        LD   A,255              ; the bounding box starts empty
        LD   (rndl_bxmin),A
        LD   (rndl_bymin),A
        XOR  A
        LD   (rndl_bxmax),A
        LD   (rndl_bymax),A
        LD   HL,pr_pts
        LD   (rndl_pts),HL
        LD   B,PR_NP
        LD   C,0
pr_dr1:
        PUSH BC
        LD   HL,pr_ord
        LD   E,C
        LD   D,0
        ADD  HL,DE
        LD   A,(HL)
        CALL pr_one
        POP  BC
        INC  C
        DJNZ pr_dr1
        RET

pr_one:                         ; the piece whose index is A
        LD   (pr_pi),A
        LD   L,A                ; its ramp, into all six of renderlit's
        LD   H,0
        LD   DE,pr_base
        ADD  HL,DE
        LD   A,(HL)
        LD   HL,rndl_base
        LD   B,6
pr_on1:
        LD   (HL),A
        INC  HL
        DJNZ pr_on1

        LD   A,(pr_pi)          ; twenty four bytes of vertex a piece
        LD   L,A
        LD   H,0
        ADD  HL,HL
        ADD  HL,HL
        ADD  HL,HL
        LD   D,H
        LD   E,L
        ADD  HL,HL
        ADD  HL,DE
        LD   DE,pr_vert
        ADD  HL,DE
        LD   DE,pr_pts
        LD   B,8
        CALL t3d_run

        LD   A,(pr_pi)          ; and eighteen bytes of face
        LD   L,A
        LD   H,0
        ADD  HL,HL
        LD   D,H
        LD   E,L                ; two of them kept back
        ADD  HL,HL
        ADD  HL,HL
        ADD  HL,HL              ; sixteen
        ADD  HL,DE              ; and eighteen
        LD   DE,pr_face
        ADD  HL,DE
        LD   (pr_fp),HL
        XOR  A
        LD   (pr_fi),A
pr_on2:
        LD   HL,(pr_fp)
        LD   A,(HL)             ; which normal this face has
        INC  HL
        LD   E,(HL)
        INC  HL
        LD   D,(HL)             ; and where its plane sits
        INC  HL
        LD   (pr_fp),HL
        LD   (pr_off),DE
        LD   L,A                ; three bytes a normal
        LD   H,0
        LD   D,H
        LD   E,L
        ADD  HL,HL
        ADD  HL,DE
        LD   DE,pr_nsh
        ADD  HL,DE
        LD   A,(HL)
        LD   (pr_fsh),A         ; the shade it was given
        INC  HL
        LD   E,(HL)
        INC  HL
        LD   D,(HL)             ; and its N.T
        LD   HL,(pr_off)
        ADD  HL,DE              ; the face is towards us when N.T plus
        LD   A,H                ; its own plane offset is negative
        RLA
        SBC  A,A
        LD   C,A
        LD   A,(pr_fi)
        LD   B,A
        LD   A,(pr_fsh)
        CALL rndl_setface       ; renderlit's own colour and visibility
        LD   A,(pr_fi)
        INC  A
        LD   (pr_fi),A
        CP   6
        JP   C,pr_on2

        CALL rndl_six           ; and renderlit draws them

        LD   HL,pr_pts          ; the eight points widen the frame's box
        LD   B,8
pr_on3:
        LD   C,(HL)
        LD   A,(rndl_bxmin)
        CP   C
        JR   C,pr_on4
        LD   A,C
        LD   (rndl_bxmin),A
pr_on4:
        LD   A,(rndl_bxmax)
        CP   C
        JR   NC,pr_on5
        LD   A,C
        LD   (rndl_bxmax),A
pr_on5:
        INC  HL
        LD   C,(HL)
        LD   A,(rndl_bymin)
        CP   C
        JR   C,pr_on6
        LD   A,C
        LD   (rndl_bymin),A
pr_on6:
        LD   A,(rndl_bymax)
        CP   C
        JR   NC,pr_on7
        LD   A,C
        LD   (rndl_bymax),A
pr_on7:
        INC  HL
        DJNZ pr_on3
        RET

;------------------------------------------------------------------
; pr_box - one box for the whole logo, into this buffer's record
;------------------------------------------------------------------

pr_box:
        CALL rndl_dirty
        JP   rndl_bstore

;------------------------------------------------------------------
; Workspace
;------------------------------------------------------------------

pr_vp:          DEFS 2
pr_vn:          DEFS 1
pr_j:           DEFS 1
pr_m:           DEFS 1
pr_pg:          DEFS 1
pr_v:           DEFS 1
pr_np:          DEFS 2
pr_sp:          DEFS 2
pr_dp:          DEFS 2
pr_dn:          DEFS 2
pr_dc:          DEFS 1
pr_acc:         DEFS 2
pr_m7c:         DEFS 1
pr_m7l:         DEFS 1
pr_m7p:         DEFS 2
pr_zy:          DEFS 1
pr_zp:          DEFS 2
pr_pi:          DEFS 1
pr_fp:          DEFS 2
pr_fi:          DEFS 1
pr_off:         DEFS 2
pr_fsh:         DEFS 1
pr_ord:         DEFS PR_NP
pr_dep:         DEFS 2 * PR_NP
pr_pts:         DEFS 16
pr_nsh:         DEFS 3 * PR_NN
