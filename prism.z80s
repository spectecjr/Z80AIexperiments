;------------------------------------------------------------------
; prism.z80s - a lit extruded logo, in convex pieces
;
;   pr_init    blank both buffers and build the ramp
;   pr_frame   spin, light, sort, draw, flip
;
; renderlit.z80s draws a cube: eight vertices, six quad faces, and the
; face normals for nothing because they are the columns of the
; rotation matrix. An extruded quad has exactly the same shape - eight
; vertices, six quad faces - so a logo cut into convex quads is a
; handful of cubes that are not cubes, and renderlit's rasteriser,
; face table and shading draw them unchanged.
;
; WHAT HAS TO BE FOUND RATHER THAN ASSUMED, per face:
;
;   the normal   a side face's is its quad edge's 2D normal and the
;                front and back faces' is the z axis, all of them
;                object space constants. So N.L and N.T are the same
;                two transposed matrix-vector products renderlit
;                already does, dotted with the face's own normal - and
;                since a normal is shared by every face that has it,
;                that is done once per distinct normal, not per face.
;
;   the plane    renderlit tests N.T + S < 0 with S the cube's half
;                size. Here it is N.T + (n . p) for a point p on the
;                face, which is a constant the generator works out.
;
;   the order    the pieces are convex and disjoint but the whole is
;                not, so they are drawn back to front by the depth of
;                their centres. That is exact whenever a plane
;                separates two pieces, which for a flat logo it does.
;
; THE MULTIPLY TABLES. transform3d wants nine tables indexed by a
; vertex coordinate; democube fills two entries of each because a cube
; has only +S and -S. A logo has more, but not many - nine x values,
; nine y values and two z - so pr_tables fills exactly the entries the
; vertices will read, sixty multiplies rather than 2,304.
;
; The shape in prismdata.z80s is provisional: a serif sigma of 45
; degree angles and a triangle with a triangular hole, built from a
; description rather than from the artwork. Nothing here depends on
; it: swap the numbers and the renderer does not care.
;
; Needs mul8x8_qs, transform3d, democube (the spin) and renderlit.
;
; Written by Claude (Opus) for the Z80AIexperiments repo.
;------------------------------------------------------------------

;------------------------------------------------------------------
; pr_init - renderlit's, and the logo's place, which never changes
;------------------------------------------------------------------

pr_init:
        CALL rndl_init
        LD   HL,PR_DA           ; how fast it turns, democube's variables
        LD   DE,demo_dax
        LD   BC,3
        LDIR
        LD   HL,0
        LD   (t3d_tx),HL
        LD   (t3d_ty),HL
        LD   HL,PR_TZ
        LD   (t3d_tz),HL

        LD   HL,pr_pop          ; bits in a byte, for the ordering below
        LD   (HL),0
        LD   B,PR_MASK
        LD   C,1
pr_ip1:
        LD   A,C
        SRL  A
        LD   L,A
        LD   H,0
        LD   DE,pr_pop
        ADD  HL,DE
        LD   A,(HL)
        BIT  0,C
        JR   Z,pr_ip2
        INC  A
pr_ip2:
        LD   L,C
        LD   H,0
        ADD  HL,DE
        LD   (HL),A
        INC  C
        DJNZ pr_ip1
        RET

;------------------------------------------------------------------
; pr_frame - one frame
;------------------------------------------------------------------

pr_frame:
        CALL rndl_erase         ; the one box the whole logo drew in
        CALL demo_spin          ; one matrix for all of it
        CALL pr_tables          ; the multiply table entries it will read
        CALL pr_light           ; a shade and an N.T for each normal
        CALL pr_proj            ; every corner, and each piece's box
        CALL pr_order           ; the pieces, farthest first
        CALL pr_draw
        CALL pr_box
        JP   rndl_flip

;------------------------------------------------------------------
; pr_tables - m[j] * v for every coordinate value the logo has
;------------------------------------------------------------------

pr_tables:
        LD   IX,pr_axes
        LD   C,0                ; the axis, 0 to 2
pr_ta1:
        LD   L,(IX+0)
        LD   H,(IX+1)
        LD   (pr_vp),HL         ; where its values are
        LD   A,(IX+2)
        LD   (pr_vn),A
        LD   A,C
        LD   (pr_j),A           ; and its three tables, j, j+3, j+6
        PUSH BC
        LD   B,3
pr_ta2:
        PUSH BC
        LD   A,(pr_j)
        LD   E,A
        LD   D,0
        LD   HL,t3d_m
        ADD  HL,DE
        LD   A,(HL)
        LD   (pr_m),A           ; the coefficient
        LD   A,(pr_j)
        ADD  A,A
        ADD  A,t3d_tab / 256
        LD   (pr_pg),A          ; and the page pair its table lives in
        LD   HL,(pr_vp)
        LD   A,(pr_vn)
        LD   B,A
pr_ta3:
        PUSH BC
        LD   A,(HL)
        PUSH HL
        LD   (pr_v),A
        OR   A                  ; |v|, and its sign remembered
        JP   P,pr_ta4
        NEG
pr_ta4:
        LD   C,A
        LD   A,(pr_m)
        LD   B,A
        CALL demo_smul16        ; DE = m * |v|
        LD   A,(pr_v)
        OR   A
        JP   P,pr_ta5
        LD   HL,0               ; v was negative
        OR   A
        SBC  HL,DE
        EX   DE,HL
pr_ta5:
        LD   A,(pr_pg)
        LD   H,A
        LD   A,(pr_v)
        LD   L,A
        LD   (HL),E
        INC  H
        LD   (HL),D
        POP  HL
        INC  HL
        POP  BC
        DJNZ pr_ta3
        LD   A,(pr_j)           ; the next table of this axis
        ADD  A,3
        LD   (pr_j),A
        POP  BC
        DJNZ pr_ta2
        POP  BC
        LD   DE,3
        ADD  IX,DE
        INC  C
        LD   A,C
        CP   3
        JP   C,pr_ta1
        RET

;------------------------------------------------------------------
; pr_light - a shade and an N.T for every distinct normal
;
; renderlit's two transposed products, then each normal dotted with
; both of them. A face's own arithmetic is then one add and a sign.
;------------------------------------------------------------------

pr_light:
        LD   A,(t3d_tx+1)       ; T >> 8, as renderlit takes it
        LD   (rndl_w+0),A
        LD   A,(t3d_ty+1)
        LD   (rndl_w+1),A
        LD   A,(t3d_tz+1)
        LD   (rndl_w+2),A
        LD   DE,rndl_cv
        CALL rndl_mtv
        LD   HL,(rndl_lite)
        LD   (rndl_w+0),HL
        LD   A,(rndl_lite+2)
        LD   (rndl_w+2),A
        LD   DE,rndl_lv
        CALL rndl_mtv

        LD   HL,pr_norm
        LD   (pr_np),HL
        LD   HL,pr_nsh
        LD   (pr_sp),HL
        LD   B,PR_NN
pr_li1:
        PUSH BC
        LD   HL,rndl_lv         ; the shade this normal gets
        CALL pr_dot
        CALL pr_sh7
        LD   HL,(pr_sp)
        LD   (HL),A
        INC  HL
        PUSH HL
        LD   HL,rndl_cv         ; and its N.T, which the plane offset
        CALL pr_dot             ; is added to a face at a time
        POP  DE
        EX   DE,HL
        LD   (HL),E
        INC  HL
        LD   (HL),D
        INC  HL
        LD   (pr_sp),HL
        LD   HL,(pr_np)
        LD   DE,3
        ADD  HL,DE
        LD   (pr_np),HL
        POP  BC
        DJNZ pr_li1
        RET

pr_dot:                         ; HL -> three words, (pr_np) -> a normal
        LD   (pr_dp),HL
        LD   HL,0
        LD   (pr_acc),HL
        LD   HL,(pr_np)
        LD   (pr_dn),HL
        LD   B,3
pr_do1:
        PUSH BC
        LD   HL,(pr_dn)
        LD   A,(HL)
        INC  HL
        LD   (pr_dn),HL
        OR   A
        JR   Z,pr_do2           ; a zero component, and most of them are
        LD   (pr_dc),A
        LD   HL,(pr_dp)
        LD   E,(HL)
        INC  HL
        LD   D,(HL)
        EX   DE,HL
        LD   A,(pr_dc)
        CALL pr_mul7            ; (n * v) >> 7
        LD   DE,(pr_acc)
        ADD  HL,DE
        LD   (pr_acc),HL
pr_do2:
        LD   HL,(pr_dp)
        INC  HL
        INC  HL
        LD   (pr_dp),HL
        POP  BC
        DJNZ pr_do1
        LD   HL,(pr_acc)
        RET

pr_sh7:                         ; HL, times 128*128, to a shade byte
        LD   D,H
        LD   E,L
        LD   A,D
        ADD  A,64               ; inside [-16384, 16383]?
        CP   128
        JR   C,pr_s71
        LD   A,D                ; no - peg it at whichever end
        RLA
        SBC  A,A
        XOR  0x7F
        RET
pr_s71:
        ADD  HL,HL
        LD   A,H
        RET

;------------------------------------------------------------------
; pr_mul7 - (HL * A) >> 7, room3d's, which is two byte multiplies
;------------------------------------------------------------------

pr_mul7:
        LD   (pr_m7c),A
        LD   C,A
        LD   B,H
        LD   A,L
        LD   (pr_m7l),A
        CALL pr_smul
        LD   (pr_m7p),DE
        LD   A,(pr_m7l)
        LD   B,A
        LD   A,(pr_m7c)
        LD   C,A
        CALL qsmul8
        LD   A,C
        RLA
        JR   NC,pr_m71
        LD   A,D
        SUB  B
        LD   D,A
pr_m71:
        LD   A,D
        LD   L,A
        ADD  A,A
        SBC  A,A
        LD   H,A
        PUSH DE
        LD   DE,(pr_m7p)
        ADD  HL,DE
        ADD  HL,HL
        POP  DE
        BIT  7,E
        RET  Z
        INC  HL
        RET

pr_smul:                        ; DE = signed B * signed C
        CALL qsmul8
        LD   A,B
        RLA
        JR   NC,pr_sm1
        LD   A,D
        SUB  C
        LD   D,A
pr_sm1:
        LD   A,C
        RLA
        RET  NC
        LD   A,D
        SUB  B
        LD   D,A
        RET

;------------------------------------------------------------------
; pr_proj - every piece's eight corners, and its box on the screen
;
; The order below needs to know which pieces overlap, so all seven are
; projected before any is drawn. The frame's own box comes out of the
; seven, which is 28 comparisons rather than 56.
;------------------------------------------------------------------

pr_proj:
        XOR  A
        LD   (pr_pi),A
pr_pj1:
        LD   A,(pr_pi)          ; twenty four bytes of vertex a piece
        LD   L,A
        LD   H,0
        ADD  HL,HL
        ADD  HL,HL
        ADD  HL,HL
        LD   D,H
        LD   E,L
        ADD  HL,HL
        ADD  HL,DE
        LD   DE,pr_vert
        ADD  HL,DE
        PUSH HL
        LD   A,(pr_pi)
        CALL pr_pp              ; and sixteen of point
        POP  HL
        LD   B,8
        CALL t3d_run

        LD   A,(pr_pi)
        CALL pr_pp
        EX   DE,HL              ; HL -> the points
        LD   A,(pr_pi)
        ADD  A,A
        ADD  A,A
        LD   E,A
        LD   D,0
        PUSH HL
        LD   HL,pr_bx
        ADD  HL,DE
        EX   DE,HL              ; DE -> its box
        POP  HL
        CALL pr_pbox

        LD   A,(pr_pi)
        INC  A
        LD   (pr_pi),A
        CP   PR_NP
        JP   C,pr_pj1

        LD   A,255              ; and the frame's box out of the seven
        LD   (rndl_bxmin),A
        LD   (rndl_bymin),A
        XOR  A
        LD   (rndl_bxmax),A
        LD   (rndl_bymax),A
        LD   HL,pr_bx
        LD   B,PR_NP
pr_pj2:
        PUSH BC
        LD   A,(HL)             ; xmin
        LD   C,A
        LD   A,(rndl_bxmin)
        CP   C
        JR   C,pr_pj3
        LD   A,C
        LD   (rndl_bxmin),A
pr_pj3:
        INC  HL
        LD   A,(HL)             ; xmax
        LD   C,A
        LD   A,(rndl_bxmax)
        CP   C
        JR   NC,pr_pj4
        LD   A,C
        LD   (rndl_bxmax),A
pr_pj4:
        INC  HL
        LD   A,(HL)             ; ymin
        LD   C,A
        LD   A,(rndl_bymin)
        CP   C
        JR   C,pr_pj5
        LD   A,C
        LD   (rndl_bymin),A
pr_pj5:
        INC  HL
        LD   A,(HL)             ; ymax
        LD   C,A
        LD   A,(rndl_bymax)
        CP   C
        JR   NC,pr_pj6
        LD   A,C
        LD   (rndl_bymax),A
pr_pj6:
        INC  HL
        POP  BC
        DJNZ pr_pj2
        RET

pr_pp:                          ; A = a piece -> DE = its sixteen points
        ADD  A,A
        ADD  A,A
        ADD  A,A
        ADD  A,A
        LD   E,A
        LD   D,0
        LD   HL,pr_pts
        ADD  HL,DE
        EX   DE,HL
        RET

pr_pbox:                        ; HL -> eight points, DE -> a four byte box
        PUSH DE
        LD   B,255              ; xmin
        LD   C,0                ; xmax
        LD   D,255              ; ymin
        LD   E,0                ; ymax
        LD   A,8
        LD   (pr_n),A
pr_pb1:
        LD   A,(HL)
        CP   B
        JR   NC,pr_pb2
        LD   B,A
pr_pb2:
        CP   C
        JR   C,pr_pb3
        LD   C,A
pr_pb3:
        INC  HL
        LD   A,(HL)
        CP   D
        JR   NC,pr_pb4
        LD   D,A
pr_pb4:
        CP   E
        JR   C,pr_pb5
        LD   E,A
pr_pb5:
        INC  HL
        LD   A,(pr_n)
        DEC  A
        LD   (pr_n),A
        JR   NZ,pr_pb1
        POP  HL
        LD   (HL),B
        INC  HL
        LD   (HL),C
        INC  HL
        LD   (HL),D
        INC  HL
        LD   (HL),E
        RET

;------------------------------------------------------------------
; pr_order - the pieces farthest first, by separating planes
;
; The pieces are disjoint convex prisms of the same z extent, so for
; every pair one of the four side faces of one has the other wholly on
; its outward side - the separating axis theorem - and that plane
; settles the pair exactly: whichever of them is on the eye's side of
; it is the nearer, which is the sign of N.T + off that culls faces,
; and pr_light has already worked out every N.T.
;
; A centroid depth settles nothing, and got 344 pairs the wrong way
; round in 178 of the 256 frames.
;
; Only pieces that overlap on screen constrain each other, so what is
; left is a topological sort over the overlapping pairs. Taken with
; boxes rather than shapes the relation can still have a cycle - 36
; frames in 256 - and then the piece in front of the fewest others
; goes first, which leaves one pair the wrong way round rather than a
; cascade of them.
;------------------------------------------------------------------

pr_order:
        LD   HL,pr_fr
        LD   DE,pr_ov
        LD   B,PR_NP
pr_or0:
        LD   (HL),0
        INC  HL
        EX   DE,HL
        LD   (HL),0
        INC  HL
        EX   DE,HL
        DJNZ pr_or0

        LD   IX,pr_pair         ; the table carries the two addresses a
        LD   A,PR_NPAIR         ; pair needs, so there is no arithmetic
        LD   (pr_n),A           ; here at all
pr_or1:
        LD   L,(IX+0)
        LD   H,(IX+1)           ; -> 64 times the plane's offset
        LD   E,(HL)
        INC  HL
        LD   D,(HL)
        LD   L,(IX+2)
        LD   H,(IX+3)           ; -> the normal's N.T, from pr_light
        LD   C,(HL)
        INC  HL
        LD   B,(HL)
        LD   H,B
        LD   L,C
        ADD  HL,DE              ; N.T + off
        LD   A,H
        RLA                     ; carry: the eye is outside the plane
        LD   C,(IX+4)           ; the plane's piece
        LD   B,(IX+5)           ; the one outside it
        JR   NC,pr_or2
        LD   A,B                ; outside, so the outer one is in front
        LD   B,C
        LD   C,A
pr_or2:
        CALL pr_setb            ; pr_fr[C] gets bit B

        CALL pr_hit             ; and while the pair is in hand, whether
        JR   NC,pr_or4          ; their boxes touch at all
        LD   C,(IX+4)
        LD   B,(IX+5)
        LD   HL,pr_ov - pr_fr
        LD   (pr_seto),HL
        CALL pr_setb
        LD   C,(IX+5)
        LD   B,(IX+4)
        CALL pr_setb            ; overlap runs both ways
        LD   HL,0
        LD   (pr_seto),HL
pr_or4:
        LD   DE,6
        ADD  IX,DE
        LD   A,(pr_n)
        DEC  A
        LD   (pr_n),A
        JP   NZ,pr_or1

        LD   A,PR_MASK          ; then take them, farthest first
        LD   (pr_left),A
        LD   HL,pr_ord
        LD   (pr_op),HL
        LD   B,PR_NP
pr_or5:
        PUSH BC
        LD   A,255
        LD   (pr_bc),A
        LD   IX,pr_fr
        LD   C,1                ; the bit for this piece
        XOR  A
        LD   (pr_x),A
pr_or6:
        LD   A,(pr_left)
        AND  C
        JR   Z,pr_or8           ; already drawn
        LD   A,(IX+0)           ; what it is in front of, that is left
        AND  (IX + pr_ov - pr_fr)
        LD   HL,pr_left
        AND  (HL)
        LD   L,A
        LD   H,0
        LD   DE,pr_pop
        ADD  HL,DE
        LD   A,(HL)
        LD   HL,pr_bc
        CP   (HL)
        JR   NC,pr_or8
        LD   (HL),A
        LD   A,(pr_x)
        LD   (pr_best),A
        LD   A,C
        LD   (pr_bb),A
pr_or8:
        INC  IX
        SLA  C
        LD   A,(pr_x)
        INC  A
        LD   (pr_x),A
        CP   PR_NP
        JP   C,pr_or6

        LD   A,(pr_best)        ; that one goes next
        LD   HL,(pr_op)
        LD   (HL),A
        INC  HL
        LD   (pr_op),HL
        LD   A,(pr_bb)
        CPL
        LD   HL,pr_left
        AND  (HL)
        LD   (HL),A
        POP  BC
        DJNZ pr_or5
        RET

pr_bit8:                        ; B = 0..7 -> A = the bit
        LD   L,B
        LD   H,0
        LD   DE,pr_bit
        ADD  HL,DE
        LD   A,(HL)
        RET

pr_setb:                        ; C = a byte of pr_fr, B = a bit to set
        CALL pr_bit8
        LD   L,C
        LD   H,0
        LD   DE,pr_fr
        ADD  HL,DE
        LD   DE,(pr_seto)       ; or of pr_ov, when that is asked for
        ADD  HL,DE
        OR   (HL)
        LD   (HL),A
        RET

pr_hit:                         ; C, B = two pieces -> carry if their
        LD   A,C                ; screen boxes touch
        ADD  A,A
        ADD  A,A
        LD   E,A
        LD   D,0
        LD   IY,pr_bx
        ADD  IY,DE
        LD   A,B
        ADD  A,A
        ADD  A,A
        LD   E,A
        LD   D,0
        PUSH IX
        LD   IX,pr_bx
        ADD  IX,DE
        LD   A,(IY+0)           ; one's xmin past the other's xmax?
        CP   (IX+1)
        JR   Z,pr_ht1
        JR   NC,pr_ht3
pr_ht1:
        LD   A,(IX+0)
        CP   (IY+1)
        JR   Z,pr_ht2
        JR   NC,pr_ht3
pr_ht2:
        LD   A,(IY+2)           ; then the same in y
        CP   (IX+3)
        JR   Z,pr_ht5
        JR   NC,pr_ht3
pr_ht5:
        LD   A,(IX+2)
        CP   (IY+3)
        JR   Z,pr_ht6
        JR   NC,pr_ht3
pr_ht6:
        POP  IX
        SCF
        RET
pr_ht3:
        POP  IX
        OR   A
        RET

;------------------------------------------------------------------
; pr_draw - every piece, in that order
;------------------------------------------------------------------

pr_draw:
        LD   B,PR_NP
        LD   C,0
pr_dr1:
        PUSH BC
        LD   HL,pr_ord
        LD   E,C
        LD   D,0
        ADD  HL,DE
        LD   A,(HL)
        CALL pr_one
        POP  BC
        INC  C
        DJNZ pr_dr1
        RET

pr_one:                         ; the piece whose index is A
        LD   (pr_pi),A
        LD   L,A                ; its ramp, into all six of renderlit's
        LD   H,0
        LD   DE,pr_base
        ADD  HL,DE
        LD   A,(HL)
        LD   HL,rndl_base
        LD   B,6
pr_on1:
        LD   (HL),A
        INC  HL
        DJNZ pr_on1

        LD   A,(pr_pi)          ; pr_proj put its corners here already
        CALL pr_pp
        LD   (rndl_pts),DE

        LD   A,(pr_pi)          ; and eighteen bytes of face
        LD   L,A
        LD   H,0
        ADD  HL,HL
        LD   D,H
        LD   E,L                ; two of them kept back
        ADD  HL,HL
        ADD  HL,HL
        ADD  HL,HL              ; sixteen
        ADD  HL,DE              ; and eighteen
        LD   DE,pr_face
        ADD  HL,DE
        LD   (pr_fp),HL
        XOR  A
        LD   (pr_fi),A
pr_on2:
        LD   HL,(pr_fp)
        LD   A,(HL)             ; which normal this face has
        INC  HL
        LD   E,(HL)
        INC  HL
        LD   D,(HL)             ; and where its plane sits
        INC  HL
        LD   (pr_fp),HL
        LD   (pr_off),DE
        LD   L,A                ; three bytes a normal
        LD   H,0
        LD   D,H
        LD   E,L
        ADD  HL,HL
        ADD  HL,DE
        LD   DE,pr_nsh
        ADD  HL,DE
        LD   A,(HL)
        LD   (pr_fsh),A         ; the shade it was given
        INC  HL
        LD   E,(HL)
        INC  HL
        LD   D,(HL)             ; and its N.T
        LD   HL,(pr_off)
        ADD  HL,DE              ; the face is towards us when N.T plus
        LD   A,H                ; its own plane offset is negative
        RLA
        SBC  A,A
        LD   C,A
        LD   A,(pr_fi)
        LD   B,A
        LD   A,(pr_fsh)
        CALL rndl_setface       ; renderlit's own colour and visibility
        LD   A,(pr_fi)
        INC  A
        LD   (pr_fi),A
        CP   6
        JP   C,pr_on2

        JP   rndl_six           ; and renderlit draws them

;------------------------------------------------------------------
; pr_box - one box for the whole logo, into this buffer's record
;------------------------------------------------------------------

pr_box:
        CALL rndl_dirty
        JP   rndl_bstore

;------------------------------------------------------------------
; Workspace
;------------------------------------------------------------------

pr_bx:          DEFS 4 * PR_NP  ; each piece's box on the screen
pr_fr:          DEFS PR_NP      ; bit j: piece i is in front of piece j
pr_ov:          DEFS PR_NP      ; bit j: their screen boxes touch
pr_left:        DEFS 1
pr_x:           DEFS 1
pr_best:        DEFS 1
pr_bc:          DEFS 1
pr_bb:          DEFS 1
pr_op:          DEFS 2
pr_pp2:         DEFS 2
pr_b1:          DEFS 2
pr_b2:          DEFS 2
pr_n:           DEFS 1
pr_seto:        DEFW 0          ; pr_setb writes pr_ov when this is the gap
pr_pop:         DEFS 128        ; bits in a byte, built by pr_init
pr_vp:          DEFS 2
pr_vn:          DEFS 1
pr_j:           DEFS 1
pr_m:           DEFS 1
pr_pg:          DEFS 1
pr_v:           DEFS 1
pr_np:          DEFS 2
pr_sp:          DEFS 2
pr_dp:          DEFS 2
pr_dn:          DEFS 2
pr_dc:          DEFS 1
pr_acc:         DEFS 2
pr_m7c:         DEFS 1
pr_m7l:         DEFS 1
