;------------------------------------------------------------------
; crc32.z80s - CRC-32 (IEEE 802.3), the one used by zlib, PNG, gzip,
;              Ethernet and ZIP
;
; Reflected algorithm, polynomial 0xEDB88320 (the reversed form of
; 0x04C11DB7), initial value 0xFFFFFFFF, final XOR 0xFFFFFFFF. The
; answers match zlib's crc32() byte for byte.
;
; One-shot:
;
;   crc32       HL = data, BC = length -> DE:HL = the CRC
;   crc32_bits  the same, without the 1K of tables
;
; Or in pieces, for data that arrives a block at a time:
;
;   crc32_start   reset the accumulator
;   crc32_update  HL = data, BC = length; folds the block in
;   crc32_final   DE:HL = the finished CRC
;
; A length of zero is a no-op, as it should be - crc32 of nothing is
; 0x00000000. The accumulator is four bytes of RAM (crc32_acc) so the
; caller can save and restore it to interleave several streams.
;
; Entry : HL = pointer to the data, BC = byte count
; Exit  : DE:HL = the CRC - DE = bits 31..16, HL = bits 15..0
; Trash : AF, BC, DE, HL, BC', DE', HL'.  AF', IX and IY are untouched.
;
; Speed, measured on an emulated Z80 (see tests/test_crc32.py):
;
;   crc32       117.0 T-states per byte, and 1024 bytes of tables
;   crc32_bits  718.1 T-states per byte, and no tables at all
;
; All of the code is 180 bytes; crc32_update_bits is 71 of those, so
; dropping the table-driven routine and its tables leaves a CRC-32 in
; a little over a hundred bytes.
;
; Both are verified against zlib's crc32 over the published check
; vectors, every length from 0 to 39 plus the page boundaries either
; side of 256, 512, 1024 and 4096, 400 random blocks, and 200 streams
; split into several calls - 727 cases over 645KB, no mismatches.
;
; The table-driven loop keeps the running CRC and the table pointer in
; the shadow registers, which leaves the main set free for the data
; pointer and a two-level DJNZ counter, so the only per-byte overhead
; outside the four table reads is a pair of EXX.
;
; The four tables are the four bytes of the usual 256-entry CRC table,
; split into one page each so that a lookup is LD L,index / LD H,page
; / LD A,(HL) with INC H stepping to the next byte - the same trick
; the table-of-squares multiply in this repo uses. They must stay
; page-aligned and in this order.
;
; Written by Claude (Opus) for the Z80AIexperiments repo.
;------------------------------------------------------------------

CRC32_POLY:     EQU 0xEDB88320  ; the reflected polynomial

;------------------------------------------------------------------
; crc32 - CRC-32 of one block, table driven
;
; Entry : HL = data, BC = length      Exit : DE:HL = CRC
;------------------------------------------------------------------

crc32:
        PUSH HL             ; [11T]
        CALL crc32_start    ; [17T]
        POP  HL             ; [10T]
        CALL crc32_update   ; [17T]
        JR   crc32_final    ; [12T]

crc32_bits:
        PUSH HL
        CALL crc32_start
        POP  HL
        CALL crc32_update_bits
        JR   crc32_final

;------------------------------------------------------------------
; crc32_start / crc32_final - bracket a run of crc32_update calls
;------------------------------------------------------------------

crc32_start:
        LD   HL,0xFFFF      ; [10T] the CRC starts out all ones
        LD   (crc32_acc),HL ; [16T]
        LD   (crc32_acc+2),HL ; [16T]
        RET                 ; [10T]

crc32_final:
        LD   HL,(crc32_acc) ; [16T] and is complemented at the end
        LD   A,L            ; [4T]
        CPL                 ; [4T]
        LD   L,A            ; [4T]
        LD   A,H            ; [4T]
        CPL                 ; [4T]
        LD   H,A            ; [4T]
        LD   DE,(crc32_acc+2) ; [20T]
        LD   A,E            ; [4T]
        CPL                 ; [4T]
        LD   E,A            ; [4T]
        LD   A,D            ; [4T]
        CPL                 ; [4T]
        LD   D,A            ; [4T]
        RET                 ; [10T]

;------------------------------------------------------------------
; crc32_update - fold a block into the accumulator, table driven
;
; Entry : HL = data, BC = length (0 does nothing)
; Trash : AF, BC, DE, HL, BC', DE', HL'
;
; 117 T-states per byte, plus about 90T of setup per call.
;------------------------------------------------------------------

crc32_update:
        LD   A,B            ; [4T]  nothing to do?
        OR   C              ; [4T]
        RET  Z              ; [11/5T]
        LD   A,B            ; [4T]  split the count into a page count
        LD   B,C            ; [4T]  and a remainder, so the inner loop
        LD   C,A            ; [4T]  can use DJNZ
        LD   A,B            ; [4T]
        OR   A              ; [4T]
        JR   Z,crc32_u_go   ; [7/12T]  an exact number of pages
        INC  C              ; [4T]  one short page, then C full ones
crc32_u_go:
        EXX                 ; [4T]
        LD   DE,(crc32_acc) ; [20T] E = byte 0, D = byte 1
        LD   BC,(crc32_acc+2) ; [20T] C = byte 2, B = byte 3
        EXX                 ; [4T]
crc32_u_loop:
        LD   A,(HL)         ; [7T]  next data byte
        INC  HL             ; [6T]
        EXX                 ; [4T]
        XOR  E              ; [4T]  index = (crc ^ byte) & 255
        LD   L,A            ; [4T]
        LD   H,crc32_tab0 / 256 ; [7T]
        LD   A,(HL)         ; [7T]  crc = (crc >> 8) ^ table[index]
        XOR  D              ; [4T]
        LD   E,A            ; [4T]
        INC  H              ; [4T]
        LD   A,(HL)         ; [7T]
        XOR  C              ; [4T]
        LD   D,A            ; [4T]
        INC  H              ; [4T]
        LD   A,(HL)         ; [7T]
        XOR  B              ; [4T]
        LD   C,A            ; [4T]
        INC  H              ; [4T]
        LD   A,(HL)         ; [7T]
        LD   B,A            ; [4T]
        EXX                 ; [4T]
        DJNZ crc32_u_loop   ; [13/8T]
        DEC  C              ; [4T]
        JR   NZ,crc32_u_loop ; [12/7T]
        EXX                 ; [4T]
        LD   (crc32_acc),DE ; [20T]
        LD   (crc32_acc+2),BC ; [20T]
        EXX                 ; [4T]
        RET                 ; [10T]

;------------------------------------------------------------------
; crc32_update_bits - the same thing without the tables
;
; Entry : HL = data, BC = length (0 does nothing)
; Trash : AF, BC, DE, HL, BC', DE', HL'
;
; About six times slower than the table version, but it costs 1024
; bytes less. Worth it when the CRC is checked once at load time.
;------------------------------------------------------------------

crc32_update_bits:
        LD   A,B
        OR   C
        RET  Z
        LD   A,B
        LD   B,C
        LD   C,A
        LD   A,B
        OR   A
        JR   Z,crc32_b_go
        INC  C
crc32_b_go:
        EXX
        LD   HL,(crc32_acc)   ; HL = bytes 1,0
        LD   DE,(crc32_acc+2) ; DE = bytes 3,2
        EXX
crc32_b_loop:
        LD   A,(HL)         ; [7T]  next data byte
        INC  HL             ; [6T]
        EXX                 ; [4T]
        XOR  L              ; [4T]  crc ^= byte
        LD   L,A            ; [4T]
        LD   B,8            ; [7T]  eight shifts, one per bit
crc32_b_bit:
        SRL  D              ; [8T]
        RR   E              ; [8T]
        RR   H              ; [8T]
        RR   L              ; [8T]
        JR   NC,crc32_b_next ; [7/12T]  bit was 0: nothing to fold in
        LD   A,D            ; [4T]
        XOR  CRC32_POLY >> 24 ; [7T]
        LD   D,A            ; [4T]
        LD   A,E            ; [4T]
        XOR  (CRC32_POLY >> 16) & 255 ; [7T]
        LD   E,A            ; [4T]
        LD   A,H            ; [4T]
        XOR  (CRC32_POLY >> 8) & 255 ; [7T]
        LD   H,A            ; [4T]
        LD   A,L            ; [4T]
        XOR  CRC32_POLY & 255 ; [7T]
        LD   L,A            ; [4T]
crc32_b_next:
        DJNZ crc32_b_bit    ; [13/8T]
        EXX                 ; [4T]
        DJNZ crc32_b_loop   ; [13/8T]
        DEC  C              ; [4T]
        JR   NZ,crc32_b_loop ; [12/7T]
        EXX
        LD   (crc32_acc),HL
        LD   (crc32_acc+2),DE
        EXX
        RET

;------------------------------------------------------------------
; The tables: entry n is the CRC of the single byte n, split so that
; each page holds one byte of the four. Generated by
; tools/gen_crc32_tables.py - do not edit by hand.
;
; These MUST be 256-byte aligned and MUST stay in this order.
;------------------------------------------------------------------

        ALIGN 256
crc32_tab0:
        DEFB 0,150,44,186,25,143,53,163,50,164,30,136,43,189,7,145
