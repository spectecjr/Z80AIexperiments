;------------------------------------------------------------------
; thunderdata.z80s - generated by tests/mkthunderdata.py, do not edit
;
; Distant thunder alone: the body underneath, the gravel over it.
;
; Two scores of segments. Each is: frames, the octave byte (already
; in the nibble its register wants), the frequency byte and the
; level to start at, then the 8.8 step for each of them a frame.
;------------------------------------------------------------------

SM_L0SEGS:      EQU 13          ; segments in layer 0 (channels 0-2)
SM_L1SEGS:      EQU 11           ; and in layer 1 (channels 3-5)
SM_MAXLVL:      EQU 45          ; three channels of fifteen
SM_INITS:       EQU 13          ; registers sm_init sets up
SM_SEGLEN:      EQU 8           ; bytes a segment

sm_l0:
        DEFB  25,0x02, 94,  0,215,254,204,  0   ;  0.50 s   149.9 Hz  level  0
        DEFB  30,0x02, 65, 20, 25,255, 93,  0   ;  0.60 s   140.1 Hz  level 20
        DEFB  35,0x02, 38, 31, 29,255,102,  0   ;  0.70 s   132.1 Hz  level 31
        DEFB   8,0x02,  7, 45, 32,255,160,255   ;  0.16 s   124.0 Hz  level 45
        DEFB  32,0x01,255, 42,152,255,176,255   ;  0.64 s   122.1 Hz  level 42
        DEFB  45,0x01,242, 32,142,255, 51,  0   ;  0.90 s   116.2 Hz  level 32
        DEFB  45,0x01,222, 41,119,255,164,255   ;  0.90 s   108.1 Hz  level 41
        DEFB  55,0x01,198, 25,148,255, 37,  0   ;  1.10 s    99.8 Hz  level 25
        DEFB  55,0x01,175, 33,130,255,186,255   ;  1.10 s    93.0 Hz  level 33
        DEFB  60,0x01,148, 18,136,255, 21,  0   ;  1.20 s    86.1 Hz  level 18
        DEFB  65,0x01,120, 23,133,255,204,255   ;  1.30 s    79.9 Hz  level 23
        DEFB  70,0x01, 89, 10,117,255, 10,  0   ;  1.40 s    74.1 Hz  level 10
        DEFB  75,0x01, 51, 13,105,255,211,255   ;  1.50 s    67.9 Hz  level 13

sm_l1:
        DEFB  25,0x30,213,  0,194,254,174,  0   ;  0.50 s   419.5 Hz  level  0
        DEFB  35,0x30,182, 17,146,254, 73,  0   ;  0.70 s   379.9 Hz  level 17
        DEFB  40,0x30,132, 27,179,254,179,255   ;  0.80 s   329.8 Hz  level 27
        DEFB  45,0x30, 80, 15,176,254, 34,  0   ;  0.90 s   290.0 Hz  level 15
        DEFB  17,0x30, 21, 21,195,254,195,255   ;  0.34 s   255.1 Hz  level 21
        DEFB  33,0x20,255, 17, 85,255,209,255   ;  0.66 s   244.1 Hz  level 17
        DEFB  60,0x20,233, 11,106,255,  8,  0   ;  1.20 s   224.8 Hz  level 11
        DEFB  70,0x20,198, 13,117,255,226,255   ;  1.40 s   199.7 Hz  level 13
        DEFB  80,0x20,160,  5,128,255,  3,  0   ;  1.60 s   178.1 Hz  level  5
        DEFB  90,0x20,120,  6,142,255,244,255   ;  1.80 s   159.8 Hz  level  6
        DEFB 105,0x20, 80,  2,153,255,251,255   ;  2.10 s   145.0 Hz  level  2

; a 0..45 level as three amplitude bytes: the chip only has sixteen
; steps a channel, and three channels carrying the same noise add up
sm_spread:
        DEFB 0x00,0x00,0x00            ;  0
        DEFB 0x11,0x00,0x00            ;  1
        DEFB 0x11,0x11,0x00            ;  2
